# TLS, by calling OpenSSL.
#
# The broker speaks its own protocol and AMQP in the clear on their own ports,
# and the same two wrapped in TLS on two more:
#
#     ./rillmq 6789 amqp=5672 amqps=5671 tls=6790 \
#              cert=server.pem key=server.key
#
# Nothing above this file knows which kind of connection it has. A connection
# carries an `SSL*` that is null when it is in the clear, and `p_read`,
# `p_write` and `p_close` at the bottom of this file are what everything calls
# instead of the socket directly. That is the whole of the change TLS made to
# the rest of the broker.
#
# Why OpenSSL rather than TLS written here: a handshake is not the part of a
# broker worth writing twice, and the part of it worth getting wrong is none.
# Rill reaches C, so this is a few declarations rather than a library.

# -- what OpenSSL is asked for ---------------------------------------------------
#
# The `-L` is where Homebrew puts it on a Mac; on a Linux box the library is on
# the default path already and a search directory that is not there costs
# nothing.
extern "-L/opt/homebrew/opt/openssl@3/lib" fn OPENSSL_version_major() -> U32

extern "-L/usr/local/opt/openssl@3/lib" fn OPENSSL_version_minor() -> U32

# The runtime's own writes cannot raise SIGPIPE. OpenSSL's can, because it calls
# `write` itself, and on Linux a client that had gone took the whole broker with
# it. Ignored, the write answers with an error like any other.
extern "c" fn signal(sig: I32, handler: Ptr) -> Ptr

fn p_ignore_broken_pipes() =
  signal(13, ptr_offset(null_ptr(), 1))
  0

extern "ssl" fn TLS_server_method() -> Ptr

extern "ssl" fn SSL_CTX_new(method: Ptr) -> Ptr

extern "ssl" fn SSL_CTX_use_certificate_chain_file(ctx: Ptr, path: Ptr) -> I32

extern "ssl" fn SSL_CTX_use_PrivateKey_file(ctx: Ptr, path: Ptr, kind: I32) -> I32

extern "ssl" fn SSL_CTX_check_private_key(ctx: Ptr) -> I32

extern "ssl" fn SSL_CTX_load_verify_locations(ctx: Ptr, file: Ptr, dir: Ptr) -> I32

extern "ssl" fn SSL_CTX_set_verify(ctx: Ptr, mode: I32, cb: Ptr) -> Unit

# `SSL_CTX_set_min_proto_version` is a macro in the header rather than a
# symbol in the library, so what it stands for is written out: control 123 on
# the context, with the version as the argument.
extern "ssl" fn SSL_CTX_ctrl(ctx: Ptr, cmd: I32, larg: I64, parg: Ptr) -> I64

extern "ssl" fn SSL_new(ctx: Ptr) -> Ptr

extern "ssl" fn SSL_set_fd(ssl: Ptr, fd: I32) -> I32

extern "ssl" fn SSL_accept(ssl: Ptr) -> I32

extern "ssl" fn SSL_read(ssl: Ptr, buf: Ptr, num: I32) -> I32

extern "ssl" fn SSL_write(ssl: Ptr, buf: Ptr, num: I32) -> I32

extern "ssl" fn SSL_get_error(ssl: Ptr, ret: I32) -> I32

# In OpenSSL 3 the old `SSL_get_peer_certificate` is a macro for this, so the
# thing with a symbol is the one that is asked for.
extern "ssl" fn SSL_get1_peer_certificate(ssl: Ptr) -> Ptr

extern "crypto" fn X509_get_subject_name(x: Ptr) -> Ptr

extern "crypto" fn X509_NAME_oneline(name: Ptr, buf: Ptr, size: I32) -> Ptr

extern "crypto" fn X509_free(x: Ptr) -> Unit

extern "ssl" fn SSL_shutdown(ssl: Ptr) -> I32

extern "ssl" fn SSL_free(ssl: Ptr) -> Unit

extern "crypto" fn ERR_get_error() -> U64

# OpenSSL keeps its errors in a queue per thread, and every connection here is on
# the same thread. `SSL_get_error` reads that queue, so what one connection left
# there was taken for the failure of the next one to ask, and a client leaving
# could drop another that had done nothing wrong: its read ended and its writes
# were lost. So this is called before every call that `SSL_get_error` will be
# asked about, which is what OpenSSL's own documentation says to do, and the
# asking is done in the same function as the call. A strand can lose its turn at
# a tail call, and another connection can then fill the queue in between.
extern "crypto" fn ERR_clear_error() -> Unit

extern "crypto" fn ERR_error_string_n(e: U64, buf: Ptr, len: USize) -> Unit

# The two OpenSSL constants this needs by number, and one version.
fn tls_pem() = 1

fn tls_want_read() = 2

fn tls_want_write() = 3

# TLS 1.2. Below that is a decade of attacks nobody should be reachable by, and
# no client that talks to a broker is older than it.
fn tls_1_2() = 771

fn tls_set_min_version() = 123

# `SSL_VERIFY_PEER` and `SSL_VERIFY_FAIL_IF_NO_PEER_CERT` together. The first
# alone asks a client for a certificate and lets it through without one, which
# is a door with a lock and no latch.
fn tls_verify_peer() = 3

# -- the server's one context ----------------------------------------------------

# Made once, at startup, and shared by every connection. It holds the
# certificate and the key, which is why making it per connection would mean
# reading and parsing both for every client that arrives.
type Tls
  Tls(ctx: Ptr, why: Str)

fn tls_ready(cert, key, ca) =
  if str_len(cert) == 0 || str_len(key) == 0 then Tls(null_ptr(), "a cert= and a key= are both wanted") else tls_with_files(SSL_CTX_new(TLS_server_method()), cert, key, ca)

fn tls_with_files(ctx, cert, key, ca) =
  if is_null(ctx) then Tls(null_ptr(), "openssl would not make a context: " + tls_why())
  else
    SSL_CTX_ctrl(ctx, tls_set_min_version(), tls_1_2(), null_ptr())
    tls_loaded(ctx, tls_load(ctx, cert, key, ca))

fn tls_load(ctx, cert, key, ca) =
  c = tls_use_cert(ctx, cert)
  if c != 1 then "cannot read the certificate in " + cert + ": " + tls_why() else tls_load_key(ctx, key, ca)

fn tls_use_cert(ctx, cert) =
  p = to_cstr(cert)
  r = SSL_CTX_use_certificate_chain_file(ctx, p)
  free_ptr(p)
  r

fn tls_load_key(ctx, key, ca) =
  p = to_cstr(key)
  r = SSL_CTX_use_PrivateKey_file(ctx, p, tls_pem())
  free_ptr(p)
  if r != 1 then "cannot read the key in " + key + ": " + tls_why() else if SSL_CTX_check_private_key(ctx) != 1 then "the key in " + key + " is not the key for that certificate" else tls_want_client(ctx, ca)

# `ca=` is the file of certificates this broker will take a client's own
# certificate from. Given one, a client that brings none, or brings one signed
# by somebody else, does not get through the handshake — which is a refusal
# before a single frame is read, and therefore before a name and a word are
# asked for at all. Without `ca=` nothing is asked of a client but its
# password, which is what this did until now.
fn tls_want_client(ctx, ca) =
  if str_len(ca) == 0 then ""
  else
    p = to_cstr(ca)
    r = SSL_CTX_load_verify_locations(ctx, p, null_ptr())
    free_ptr(p)
    tls_asking(ctx, ca, r)

fn tls_asking(ctx, ca, r) =
  if r != 1 then "cannot read the certificates in " + ca + ": " + tls_why()
  else
    SSL_CTX_set_verify(ctx, tls_verify_peer(), null_ptr())
    ""

fn tls_loaded(ctx, why) = if str_len(why) == 0 then Tls(ctx, "") else Tls(null_ptr(), why)

fn tls_working(t: Tls) = !is_null(t.ctx)

# What OpenSSL says went wrong, in words. Its errors are a stack; this takes
# the one on top, which is the one that matters.
fn tls_why() =
  b = buf_u8(256)
  ERR_error_string_n(ERR_get_error(), b, 255)
  from_cstr(b)

fn tls_version() = int_to_str(OPENSSL_version_major()) + "." + int_to_str(OPENSSL_version_minor())

# The common name out of the certificate a client showed, or the empty string
# for a connection that showed none — which is every connection in the clear
# and every one where `ca=` was not given, because without it the certificate
# is never asked for.
#
# OpenSSL writes a whole subject as one line, `/C=GB/O=Acme/CN=alice`, and the
# common name is the field this wants. There is a call that returns just that
# field and it wants an index found by another call; the line is one call and
# a search, and the search is for a string that cannot appear in a field it is
# not the start of, because a field cannot hold a slash.
fn tls_peer_name(ssl) =
  if is_null(ssl) then "" else tls_named(SSL_get1_peer_certificate(ssl))

fn tls_named(cert) =
  if is_null(cert) then ""
  else
    b = buf_u8(512)
    X509_NAME_oneline(X509_get_subject_name(cert), b, 511)
    X509_free(cert)
    tls_common_name(from_cstr(b))

fn tls_common_name(line) =
  at = str_find(line, "/CN=")
  if at < 0 then "" else tls_upto_slash(line[at + 4:])

fn tls_upto_slash(rest) =
  at = str_find(rest, "/")
  if at < 0 then rest else rest[0:at]

# -- one connection --------------------------------------------------------------

# How long a client has to finish a handshake, and how long a quiet TLS
# connection is waited on before it is asked about again. Both are generous:
# the second is not a deadline, only how long the strand sleeps between looks.
fn tls_handshake_ms() = 10000

fn tls_read_ms() = 3600000

fn tls_chunk() = 16384

# The handshake, on a socket that does not block. OpenSSL says what it is
# waiting for and this waits for that: the strand parks on the descriptor
# exactly as a plain read would, so a client that connects and says nothing
# costs a parked strand and no processor at all.
fn tls_up(t: Tls, fd) =
  ssl = SSL_new(t.ctx)
  if is_null(ssl) then null_ptr() else tls_shake(ssl, fd, SSL_set_fd(ssl, fd))

fn tls_shake(ssl, fd, set) =
  if set != 1 then tls_give_up(ssl) else tls_shaking(ssl, fd, 0)

fn tls_shaking(ssl, fd, tries) =
  if tries > 64 then tls_give_up(ssl) else tls_shake_once(ssl, fd, tries)

fn tls_shake_once(ssl, fd, tries) =
  ERR_clear_error()
  r = SSL_accept(ssl)
  e = if r == 1 then 0 else SSL_get_error(ssl, r)
  tls_shook(ssl, fd, tries, r, e)

fn tls_shook(ssl, fd, tries, r, e) =
  if r == 1 then ssl else tls_shake_again(ssl, fd, tries, e)

fn tls_shake_again(ssl, fd, tries, e) =
  if e != tls_want_read() && e != tls_want_write() then tls_give_up(ssl) else tls_shake_after(ssl, fd, tries, e)

# Waiting to read is what the descriptor can be parked on. Waiting to write
# means the far end has stopped taking bytes mid-handshake, which is rare
# enough that a short pause and another try is the whole of the answer.
fn tls_shake_after(ssl, fd, tries, e) =
  if e == tls_want_read() then tls_shake_read(ssl, fd, tries) else tls_shake_pause(ssl, fd, tries)

fn tls_shake_read(ssl, fd, tries) =
  if sock_wait(fd, tls_handshake_ms()) then tls_shaking(ssl, fd, tries + 1) else tls_give_up(ssl)

fn tls_shake_pause(ssl, fd, tries) =
  sleep_ms(2)
  tls_shaking(ssl, fd, tries + 1)

fn tls_give_up(ssl) =
  SSL_free(ssl)
  null_ptr()

# -- reading and writing ----------------------------------------------------------

# Whatever has arrived, decrypted. An empty string means the connection is
# over, which is what `sock_read` means by one, so nothing above has to know
# which kind of connection it was reading.
fn tls_read(ssl, fd) =
  b = buf_u8(tls_chunk())
  ERR_clear_error()
  n = SSL_read(ssl, b, tls_chunk())
  if n > 0 then str_from_ptr(b, n) else tls_read_again(ssl, fd, SSL_get_error(ssl, n))

fn tls_read_again(ssl, fd, e) =
  if e == tls_want_read() then tls_read_wait(ssl, fd) else if e == tls_want_write() then tls_read_pause(ssl, fd) else ""

fn tls_read_wait(ssl, fd) = if sock_wait(fd, tls_read_ms()) then tls_read(ssl, fd) else ""

fn tls_read_pause(ssl, fd) =
  sleep_ms(2)
  tls_read(ssl, fd)

# All of it or nothing, which is what `sock_write` promises. A string with a
# zero byte in the middle of it is written whole: the length is carried
# alongside rather than looked for.
fn tls_write(ssl, fd, s) =
  if str_len(s) == 0 then 0
  else
    p = to_cstr(s)
    n = tls_write_from(ssl, fd, p, str_len(s), 0)
    free_ptr(p)
    n

fn tls_write_from(ssl, fd, p, want, sent) =
  if sent >= want then sent else tls_write_more(ssl, fd, p, want, sent)

fn tls_write_more(ssl, fd, p, want, sent) =
  ERR_clear_error()
  k = SSL_write(ssl, ptr_offset(p, sent), want - sent)
  e = if k > 0 then 0 else SSL_get_error(ssl, k)
  tls_wrote(ssl, fd, p, want, sent, k, e)

fn tls_wrote(ssl, fd, p, want, sent, k, e) =
  if k > 0 then tls_write_from(ssl, fd, p, want, sent + k) else tls_write_again(ssl, fd, p, want, sent, e)

fn tls_write_again(ssl, fd, p, want, sent, e) =
  if e == tls_want_read() then tls_write_after_read(ssl, fd, p, want, sent) else if e == tls_want_write() then tls_write_after_pause(ssl, fd, p, want, sent) else -1

fn tls_write_after_read(ssl, fd, p, want, sent) =
  if sock_wait(fd, tls_read_ms()) then tls_write_from(ssl, fd, p, want, sent) else -1

fn tls_write_after_pause(ssl, fd, p, want, sent) =
  sleep_ms(2)
  tls_write_from(ssl, fd, p, want, sent)

# The close-notify the far end is owed, and then the memory. Only the first
# half of the exchange is sent: waiting for the answer is waiting on a peer
# that is usually already gone.
fn tls_down(ssl) =
  SSL_shutdown(ssl)
  SSL_free(ssl)
  0

# -- what the rest of the broker calls ---------------------------------------------

# One connection, either kind. `ssl` is null for a connection in the clear, and
# these three are the only place in RillMQ that asks which it is.
fn p_read(ssl, fd) = if is_null(ssl) then sock_read(fd) else tls_read(ssl, fd)

fn p_write(ssl, fd, s) = if is_null(ssl) then sock_write(fd, s) else tls_write(ssl, fd, s)

# A connection's writer, and the watchdog looking over its shoulder.
#
# A client that stops reading parks its writer, and a client that stops reading
# and stays connected would park it for ever: nothing else on the connection can
# tell, because the session and the reader are both still free. So one strand
# looks at every connection each `stall=<ms>`, and `sock_shutdown` is what ends
# a write that has not moved since the last look, since it wakes everything
# parked on the connection and the ordinary close takes it from there. A client
# is therefore cut off after between one and two of those.
#
# The question is about progress. Writes are counted a piece at a time, because
# a whole write can be a large message, and a client reading that slowly is slow
# and not gone. It is one strand for everyone because on Linux a timer is a
# descriptor, and one each doubles what a connection costs.
#
# Nothing here is shared. `state` is a channel of one holding the latest count,
# odd while a piece is being written: the writer replaces it and the watchdog
# reads it, and neither waits, because telling it over a channel with nobody
# holding it costs two switches per write, which was seven per cent of delivery.
# `count` is the writer's own. What the watchdog remembers is the watchdog's.
type Line
  Line(fd: Int, ssl: Ptr, state: Chan(Int), count: Map(Int, Int), lines: Chan(LineSays))

type LineSays
  LineOpen(line: Line)
  LineShut(fd: Int)

fn p_watcher() =
  lines = channel()
  spawn p_watch(lines, map_new(), map_new(), now_millis() + p_stall_ms())
  lines

fn p_line(lines, fd, ssl) =
  l = Line(fd, ssl, channel(1), map_new(), lines)
  send(lines, LineOpen(l))
  l

fn p_stall_ms() = opt_int("stall", 30000)

fn p_piece() = 65536

fn p_line_write(l: Line, s) =
  if str_len(s) <= p_piece() then p_line_piece(l, s) else p_line_pieces(l, s, 0)

fn p_line_pieces(l: Line, s, from) =
  if from >= str_len(s) then 0
  else
    upto = if from + p_piece() < str_len(s) then from + p_piece() else str_len(s)
    p_line_piece(l, s[from:upto])
    p_line_pieces(l, s, upto)

fn p_line_piece(l: Line, s) =
  p_moved(l)
  wrote = p_write(l.ssl, l.fd, s)
  p_moved(l)
  # Bytes that did not go cannot be left out of a stream and the rest sent on, so
  # this ends the connection, and a client finds out rather than waiting for
  # something that was dropped.
  if wrote < 0 then sock_shutdown(l.fd) else 0

fn p_moved(l: Line) =
  n = map_or(l.count, 0, 0) + 1
  count = l.count
  count[0] = n
  p_take(l.state)
  p_put(l.state, n)

fn p_take(ch) =
  v = select
    n = recv(ch) -> n
    default -> -1
  v

fn p_put(ch, n) =
  ok = select
    send(ch, n) -> 1
    default -> 0
  ok

# Said and heard before the socket closes, so the watchdog cannot shut a
# descriptor that has been handed to somebody else.
fn p_line_close(l: Line) =
  send(l.lines, LineShut(l.fd))
  p_close(l.ssl, l.fd)

# Against a deadline and not a plain timeout, or a connection arriving more
# often than the timeout would put the look off for ever.
fn p_watch(lines, known: Map(Int, Line), last: Map(Int, Int), due) =
  left = due - now_millis()
  if left <= 0 then p_watch_again(lines, known, last)
  else
    said = select
      m = recv(lines) -> Some(m)
      timeout(left) -> None
    p_heard(said, known, last)
    p_watch(lines, known, last, due)

fn p_watch_again(lines, known, last) =
  p_look_all(known, last, map_keys(known))
  p_watch(lines, known, last, now_millis() + p_stall_ms())

fn p_heard(said, known: Map(Int, Line), last: Map(Int, Int)) = match said
  None -> 0
  Some(m) -> match m
    LineOpen(l) ->
      known[l.fd] = l
      last[l.fd] = 0
      0
    LineShut(fd) ->
      map_del(known, fd)
      map_del(last, fd)
      0

fn p_look_all(known: Map(Int, Line), last: Map(Int, Int), fds) = match fds
  Nil -> 0
  Cons(fd, rest) ->
    match known[fd]
      None -> 0
      Some(l) -> p_look(l, last)
    p_look_all(known, last, rest)

# Put back after reading, unless the writer got there first, which is newer.
fn p_look(l: Line, last: Map(Int, Int)) =
  n = p_take(l.state)
  if n < 0 then 0
  else
    p_put(l.state, n)
    p_compare(l, last, n)

fn p_compare(l: Line, last: Map(Int, Int), n) =
  if n == map_or(last, l.fd, 0) && n - n / 2 * 2 == 1 then sock_shutdown(l.fd) else 0
  last[l.fd] = n
  0

fn p_close(ssl, fd) =
  if is_null(ssl) then 0 else tls_down(ssl)
  sock_close(fd)
  0
