# An exchange is a strand, like a queue, and for the same reason: its bindings
# are its own and nothing else touches them.
#
# The default exchange is not one of these. Publishing to `""` means the
# routing key is a queue name, and a connection goes straight to that queue —
# no hop, no bindings, nothing to look up. That is the path most messages take
# and it costs exactly what it costs now. Named exchanges are the ones that
# have something to decide.
import "queue"
import "routes"

type Bind
  Bind(queue: Str, key: Str, ch: Chan(QReq))

type X
  X(name: Str, kind: Str, binds: List(Bind), jr: Jr, lasting: Bool)

type XReq
  XPub(key: Str, body: Str, props: Str, out: Chan(Out), back: Int)
  XBind(queue: Str, key: Str, ch: Chan(QReq), quiet: Bool, reply: Chan(Int))
  XUnbind(queue: Str, key: Str, reply: Chan(Int))
  # The end of this exchange. Its bindings go with it, and the routing journal
  # is told so that a restart does not bring back what somebody deleted.
  XStop(quiet: Bool, if_unused: Bool, reply: Chan(Int))
  XKind(reply: Chan(Str))
  # This exchange as records: what it is, and each of its bindings. It is what
  # a rewritten routing journal is made of, and only this strand knows it.
  XRecords(reply: Chan(List(Str)))

fn x_direct() = "direct"

fn x_fanout() = "fanout"

fn x_topic() = "topic"

fn x_headers() = "headers"

fn x_run(name, kind, lasting, jr: Jr, inbox, done) =
  x_loop(X(name, kind, Nil, jr, lasting), inbox, done)

fn x_loop(x: X, inbox, done) =
  step = select
    r = recv(inbox) -> if x_is_stop(r) then x_over(x, r) else Some(x_handle(x, r))
    recv(done) -> None
  match step
    None -> 0
    Some(next) -> x_loop(next, inbox, done)

# Replay must not write the record it is reading, which is the whole of what
# `quiet` means here and everywhere else in this broker.
# `if-unused` is a client saying it wants the exchange gone only if nothing is
# bound to it. One that is refuses, with -2 — not a count, as -1 is not, for a
# name nobody has.
fn x_asked_to_stop(x: X, quiet, if_unused, reply) =
  if if_unused && len(x.binds) > 0 then x_stays(x, reply) else x_goes(x, quiet, reply)

fn x_stays(x: X, reply) =
  send(reply, -2)
  Some(x)

fn x_goes(x: X, quiet, reply) =
  send(reply, len(x.binds))
  x_forget(x, quiet)
  None

fn x_forget(x: X, quiet) =
  if quiet then 0 else x_note(x, rt_gone_record(x.name))
  0

fn x_is_stop(r) = match r
  XStop(quiet, if_unused, reply) -> true
  XKind(reply) -> false
  XRecords(reply) -> false
  XPub(key, body, props, out, back) -> false
  XBind(queue, key, ch, quiet, reply) -> false
  XUnbind(queue, key, reply) -> false

fn x_over(x: X, r) = match r
  XStop(quiet, if_unused, reply) -> x_asked_to_stop(x, quiet, if_unused, reply)
  XPub(key, body, props, out, back) -> Some(x)
  XKind(reply) -> Some(x)
  XRecords(reply) -> Some(x)
  XBind(queue, key, ch, quiet, reply) -> Some(x)
  XUnbind(queue, key, reply) -> Some(x)

fn x_handle(x: X, r) = match r
  XPub(key, body, props, out, back) ->
    x_send(x, x_route(x, x.binds, key, Nil), key, body, props, out, back)
    x
  XBind(queue, key, ch, quiet, reply) ->
    send(reply, 1)
    if x_bound(x.binds, queue, key) then x else x_add(x, queue, key, ch, quiet)
  XStop(quiet, if_unused, reply) -> x
  XKind(reply) ->
    send(reply, x.kind)
    x
  XRecords(reply) ->
    send(reply, Cons(rt_x_record(x.name, x.kind), x_bind_records(x, x.binds)))
    x
  XUnbind(queue, key, reply) ->
    send(reply, 1)
    x_note(x, rt_unbind_record(x.name, queue, key))
    X(x.name, x.kind, x_without(x.binds, queue, key), x.jr, x.lasting)

fn x_add(x: X, queue, key, ch, quiet) =
  if quiet then 0 else x_note(x, rt_bind_record(x.name, queue, key))
  X(x.name, x.kind, Cons(Bind(queue, key, ch), x.binds), x.jr, x.lasting)

# A binding is written down and nothing waits for it to land. It is one small
# record on a file that is synced with the next batch, which is to say almost
# at once; and a binding lost in that window is a binding the client is about
# to declare again anyway, because declaring is what a client does on the way
# in.
# An exchange a client asked not to keep writes nothing down, and neither do
# its bindings: there is nothing for them to come back to.
fn x_note(x: X, rec) =
  if !x.lasting then 0
  else
    send(x.jr.puts, JNote(rec))
    0

fn x_bound(binds, queue, key) = match binds
  Nil -> false
  Cons(b, rest) -> x_same(b, queue, key) || x_bound(rest, queue, key)

fn x_same(b: Bind, queue, key) = str_cmp(b.queue, queue) == 0 && str_cmp(b.key, key) == 0

fn x_without(binds, queue, key) = match binds
  Nil -> Nil
  Cons(b, rest) -> if x_same(b, queue, key) then x_without(rest, queue, key) else Cons(b, x_without(rest, queue, key))

# -- deciding where a message goes -------------------------------------------------

fn x_route(x: X, binds, key, acc) = match binds
  Nil -> acc
  Cons(b, rest) -> x_route(x, rest, key, if x_takes(x.kind, x_bind_key(b), key) then Cons(x_bind_ch(b), acc) else acc)

fn x_bind_records(x: X, binds) = match binds
  Nil -> Nil
  Cons(b, rest) -> Cons(rt_bind_record(x.name, x_bind_queue(b), x_bind_key(b)), x_bind_records(x, rest))

fn x_bind_queue(b: Bind) = b.queue

fn x_bind_key(b: Bind) = b.key

fn x_bind_ch(b: Bind) = b.ch

fn x_takes(kind, pattern, key) =
  str_cmp(kind, x_fanout()) == 0 || (if str_cmp(kind, x_topic()) == 0 then x_topic_takes(pattern, key) else if str_cmp(kind, x_headers()) == 0 then x_headers_takes(pattern, key) else str_cmp(pattern, key) == 0)

# A `headers` exchange routes by what the message says about itself rather
# than by a word in a key. Both sides arrive here as the same canonical line —
# `key=value` joined by zero bytes — because the session reads the tables and
# this does not: an exchange comparing two strings is an exchange the routing
# journal and the cluster can carry unchanged.
#
# The binding's line begins with `x-match`, which is `all` or `any` and is the
# difference between "every one of these" and "at least one".
fn x_headers_takes(pattern, key) =
  want = split(pattern, chr(0))
  x_match_all(want) && x_all_of(x_rest(want), split(key, chr(0))) || !x_match_all(want) && x_any_of(x_rest(want), split(key, chr(0)))

# `all` unless it says otherwise, which is what AMQP asks for and also what a
# binding with no `x-match` at all most likely meant.
fn x_match_all(want) = match want
  Nil -> true
  Cons(first, rest) -> str_cmp(first, "x-match=any") != 0

fn x_rest(want) = match want
  Nil -> Nil
  Cons(first, rest) -> if starts_with(first, "x-match=") then rest else want

# A binding that asks for nothing matches nothing, which is the one case where
# `all` and `any` disagree about the empty set and AMQP sides with `any`.
fn x_all_of(want, has) = match want
  Nil -> true
  Cons(w, rest) -> x_one_of(w, has) && x_all_of(rest, has)

fn x_any_of(want, has) = match want
  Nil -> false
  Cons(w, rest) -> x_one_of(w, has) || x_any_of(rest, has)

fn x_one_of(w, has) = match has
  Nil -> false
  Cons(h, rest) -> str_cmp(w, h) == 0 || x_one_of(w, rest)

# A topic pattern is words separated by dots, where `*` stands for one word and
# `#` for any number of them, none included. Matching it is the one piece of
# real algorithm in RillMQ: `#` can swallow any prefix, so the only way to know
# whether it should is to try.
fn x_topic_takes(pattern, key) = x_words(split(pattern, "."), split(key, "."))

fn x_words(ps, ks) = match ps
  Nil -> x_no_more(ks)
  Cons(p, prest) -> if str_cmp(p, "#") == 0 then x_hash(prest, ks) else x_one(p, prest, ks)

fn x_no_more(ks) = match ks
  Nil -> true
  Cons(k, rest) -> false

fn x_one(p, prest, ks) = match ks
  Nil -> false
  Cons(k, krest) -> (str_cmp(p, "*") == 0 || str_cmp(p, k) == 0) && x_words(prest, krest)

fn x_hash(prest, ks) =
  x_words(prest, ks) || x_hash_more(prest, ks)

fn x_hash_more(prest, ks) = match ks
  Nil -> false
  Cons(k, krest) -> x_hash(prest, krest)

# -- handing it on ------------------------------------------------------------------

# Nowhere to go is not an error: a message published to a routing key nothing
# is bound to is dropped, which is what the specification says and what every
# broker does. The publisher is answered all the same, because it asked and is
# owed a reply.
#
# One queue is the ordinary case and costs nothing extra: the publisher's own
# channel goes to the queue and the answer comes back from there. More than one
# needs somebody to wait for all of them and say so once, and that somebody is
# a strand made for the purpose and gone as soon as it has counted.
# Nothing matched. The publisher is told it is safe either way — an
# unroutable message is confirmed, because the broker has decided about it and
# that is what a confirm means — and gets it back as well if it asked to.
fn x_send(x: X, chans, key, body, props, out, back) = match chans
  Nil -> x_nowhere(x, key, body, props, out, back)
  Cons(ch, rest) -> match rest
    Nil ->
      send(ch, QPub(body, props, out))
      0
    _ ->
      collect = channel(len(chans))
      x_fan(chans, body, props, collect)
      spawn x_wait(collect, len(chans), out, x.name)
      0

fn x_nowhere(x: X, key, body, props, out, back) =
  x_hand_back(x, key, body, props, out, back)
  send(out, OPublished(x.name, 0))
  0

fn x_hand_back(x: X, key, body, props, out, back) =
  if back <= 0 then 0
  else
    send(out, ONoRoute(x.name, key, body, props, back))
    0

fn x_fan(chans, body, props, collect) = match chans
  Nil -> 0
  Cons(ch, rest) ->
    send(ch, QPub(body, props, collect))
    x_fan(rest, body, props, collect)

fn x_wait(collect, n, out, name) =
  x_drain(collect, n)
  send(out, OPublished(name, 0))
  0

fn x_drain(collect, n) =
  if n <= 0 then 0
  else
    recv(collect)
    x_drain(collect, n - 1)
