# A queue lives on one node, and every node knows which.
#
# The rule is the whole of the design: a queue's owner is its name's hash over
# however many nodes there are, so no node has to be asked and no node has to
# be told. Every node is given the same list in the same order and works out
# the same answer, which is what lets a client connect to any of them.
#
# A node that is asked for a queue it does not hold does not redirect the
# client. It stands in for the queue: a strand that looks exactly like a queue
# from the inside and is, on the outside, a client connection to the node that
# has the real one. That is why the link between nodes is RillMQ's own protocol
# rather than something new — the thing at the far end is already a broker, and
# already speaks it.
import "broker"

type Peer
  Peer(host: Str, port: Int)

# FNV-1a over the name, so that two nodes built from the same source pick the
# same owner without having agreed on anything but the list.
fn cl_hash(s, i, h) =
  if i >= str_len(s) then h else cl_hash(s, i + 1, bit_and(bit_xor(h, str_get(s, i)) * 16777619, 4294967295))

fn cl_owner(name, n) =
  if n <= 1 then 0
  else
    h = cl_hash(name, 0, 2166136261)
    h - h / n * n

# `peers=host:port,host:port` and `node=<i>`, the same list on every node and
# each one's own place in it. Nothing is discovered and nothing is negotiated,
# which is the smallest cluster that can be correct.
# Where the copy lives: the place after the owner, wrapping round. Two nodes
# means each keeps the other's copies; more makes a ring. It is worked out the
# same way by everybody and never asked about, exactly as ownership is.
fn cl_backup(name, n) = if n <= 1 then 0 else cl_next(cl_owner(name, n) + 1, n)

fn cl_next(i, n) = if i >= n then i - n else i

# Everybody but me, as somewhere to send a copy to.
fn cl_others(peers, me, i, acc) = match peers
  Nil -> reverse(acc)
  Cons(p, rest) -> cl_others(rest, me, i + 1, if i == me then acc else Cons(Copy(cl_host(p), cl_port(p), -1, "", 0), acc))

fn cl_peers() = cl_parse(split(opt("peers", ""), ","), Nil)

fn cl_parse(parts, acc) = match parts
  Nil -> reverse(acc)
  Cons(p, rest) -> cl_parse(rest, if str_len(trim(p)) == 0 then acc else Cons(cl_one(trim(p)), acc))

fn cl_one(s) =
  at = str_find(s, ":")
  if at < 0 then Peer(s, 6789) else Peer(s[:at], str_to_int(s[at + 1:]))

fn cl_me() = opt_int("node", 0)

fn cl_host(p: Peer) = p.host

fn cl_port(p: Peer) = p.port

# -- standing in for a queue that is somewhere else ---------------------------------

# What the proxy is waiting to hear about, in the order it asked. The link
# answers in the order it was asked, so a queue of these is enough and nothing
# has to be numbered.
type Waiting
  WPub(out: Chan(Out))
  WNum(reply: Chan(Int))
  # A number in the answer rather than a yes or a no: `+DRAIN 12`.
  WCount(reply: Chan(Int))
  WStat(reply: Chan(QCount))

type P
  P(name: Str, fd: Int, subs: List(Sub), waits: Map(Int, Waiting), head: Int, tail: Int, host: Str, port: Int, tried: Int, reg: Chan(RReq))

# What reaches the proxy.
type PIn
  PReq(req: QReq)
  PLine(line: Str)
  PBody(id: Int, body: Str)
  PDown

fn crlf2() = "\r\n"

# A proxy is made whether or not the far end is there. A node that is down when
# this queue is first named is a node that may be up in a moment, and a queue
# that gave up at that instant would stay given up for the life of the broker.
fn cl_proxy(name, host, port, reg, inbox, done) =
  ses = channel(256)
  spawn cl_relay(inbox, ses)
  cl_start(P(name, -1, Nil, map_new(), 0, 0, host, port, 0, reg), ses, done)

fn cl_start(p: P, ses, done) = match connect_to(p.host, p.port)
  Err(e) -> cl_start_elsewhere(p, ses, done)
  Ok(fd) ->
    sock_write(fd, cl_greeting())
    spawn cl_link(fd, ses, "", p.name)
    cl_resub(P(p.name, fd, p.subs, p.waits, p.head, p.tail, p.host, p.port, 0, p.reg), ses, done)

# The node the hash names is not there. Somebody may have taken the queue over
# since, so ask before settling into refusing: a stand-in that finds the new
# leader on the way up answers the request that made it rather than turning
# that one away.
fn cl_start_elsewhere(p: P, ses, done) =
  peers = cl_peers()
  said = cl_ask_who(peers, p.name, 0, cl_me())
  if said < 0 || said == cl_me() then cl_idle(p, ses, done) else cl_start_at(p, ses, done, nth(peers, said))

fn cl_idle(p: P, ses, done) =
  cl_loop(P(p.name, -1, p.subs, p.waits, p.head, p.tail, p.host, p.port, now_millis(), p.reg), ses, done)

# One redirection and no more. If the node somebody named is not there either,
# this settles into refusing and trying again on a clock, which is where a
# node that keeps missing ends up anyway.
fn cl_start_at(p: P, ses, done, where) = match where
  None -> cl_idle(p, ses, done)
  Some(q) -> cl_start_once(P(p.name, -1, p.subs, p.waits, p.head, p.tail, cl_host(q), cl_port(q), 0, p.reg), ses, done)

fn cl_start_once(p: P, ses, done) = match connect_to(p.host, p.port)
  Err(e) -> cl_idle(p, ses, done)
  Ok(fd) ->
    sock_write(fd, cl_greeting())
    spawn cl_link(fd, ses, "", p.name)
    cl_resub(P(p.name, fd, p.subs, p.waits, p.head, p.tail, p.host, p.port, 0, p.reg), ses, done)

# The far end has no memory of this node's subscribers, so they are asked for
# again. Everything that was in flight over there has already come back to its
# queue: the connection carrying it is the one that just went.
fn cl_resub(p: P, ses, done) =
  if len(p.subs) > 0 then cl_send(p, "SUB " + p.name + crlf2()) else 0
  cl_loop(p, ses, done)

# How often a queue whose node is down tries it again. Often enough that a node
# coming back is usable in a moment; rarely enough that a node that is not
# coming back costs a connection attempt per second and not per message.
fn cl_retry_ms() = 1000

# A queue whose node cannot be reached still has to answer, or every publisher
# that names it waits for ever. It says no.
fn cl_refuse(name, inbox, done) =
  step = select
    r = recv(inbox) -> Some(r)
    recv(done) -> None
  match step
    None -> 0
    Some(r) ->
      cl_say_no(r)
      cl_refuse(name, inbox, done)

fn cl_say_no(r) = match r
  QPub(body, props, out) ->
    send(out, OFrame(w_err("the node holding that queue cannot be reached")))
    0
  QSub(s, reply) ->
    send(reply, 0)
    0
  QUnsub(sub_id, reply) ->
    send(reply, 0)
    0
  QAck(id, reply) ->
    send(reply, 0)
    0
  QNack(id, reply) ->
    send(reply, 0)
    0
  QStat(reply) ->
    send(reply, QCount(0, 0, 0, 0, 0, 0, 0))
    0
  QDrain(reply) ->
    send(reply, 0)
    0
  QPoke -> 0
  QStop(reply) ->
    send(reply, 0)
    0

# Local requests and link frames arrive on one inbox, so the proxy waits in one
# place, as every other strand here does.
fn cl_relay(inbox, ses) =
  send(ses, PReq(recv(inbox)))
  cl_relay(inbox, ses)

# The far end speaks RillMQ's own protocol, so this is its client: lines, and
# the bodies that follow a `MSG`.
fn cl_link(fd, ses, buf, name) =
  at = str_find(buf, crlf2())
  if at < 0 then cl_link_more(fd, ses, buf, name) else cl_link_line(fd, ses, buf[:at], buf[at + 2:], name)

fn cl_link_more(fd, ses, buf, name) =
  more = sock_read(fd)
  if str_len(more) == 0 then cl_link_down(ses) else cl_link(fd, ses, buf + more, name)

fn cl_link_down(ses) =
  send(ses, PDown)
  0

fn cl_link_line(fd, ses, line, rest, name) =
  parts = split(line, " ")
  if str_cmp(unwrap_or(nth(parts, 0), ""), "MSG") != 0 then cl_link_said(fd, ses, line, rest, name) else cl_link_msg(fd, ses, parts, rest, name)

fn cl_link_said(fd, ses, line, rest, name) =
  send(ses, PLine(line))
  cl_link(fd, ses, rest, name)

fn cl_link_msg(fd, ses, parts, rest, name) =
  n = str_to_int(unwrap_or(nth(parts, 3), "0"))
  if str_len(rest) < n then cl_link_fill(fd, ses, parts, rest, name) else cl_link_gave(fd, ses, str_to_int(unwrap_or(nth(parts, 1), "0")), rest[:n], rest[n:], name)

fn cl_link_fill(fd, ses, parts, rest, name) =
  more = sock_read(fd)
  if str_len(more) == 0 then cl_link_down(ses) else cl_link_msg(fd, ses, parts, rest + more, name)

fn cl_link_gave(fd, ses, id, body, rest, name) =
  send(ses, PBody(id, body))
  cl_link(fd, ses, rest, name)

# -- the proxy's own loop ---------------------------------------------------------------

fn cl_loop(p: P, ses, done) =
  step = select
    m = recv(ses) -> Some(m)
    recv(done) -> None
  match step
    None -> 0
    Some(m) -> cl_step(p, ses, done, m)

fn cl_step(p: P, ses, done, m) = match m
  PDown -> cl_lost(p, ses, done)
  PReq(r) -> cl_loop(cl_asked(p, r, ses, done), ses, done)
  PLine(line) -> cl_loop(cl_answer(p, line), ses, done)
  PBody(id, body) -> cl_loop(cl_hand_on(p, id, body), ses, done)

fn cl_send(p: P, text) =
  if p.fd < 0 then 0 else cl_write(p.fd, text)

fn cl_write(fd, text) =
  sock_write(fd, text)
  0

# The link has gone. Everything that was waiting on it is told so — a publisher
# left waiting for a node that is not coming back is worse than one told no —
# and the proxy stays, refusing and retrying, because the node may return.
fn cl_lost(p: P, ses, done) =
  sock_close(p.fd)
  cl_fail_all(p, p.head)
  cl_loop(P(p.name, -1, p.subs, map_new(), 0, 0, p.host, p.port, now_millis(), p.reg), ses, done)

fn cl_fail_all(p: P, at) =
  if at >= p.tail then 0
  else
    cl_fail_one(p.waits[at], p.name)
    cl_fail_all(p, at + 1)

fn cl_fail_one(w, name) = match w
  None -> 0
  Some(x) -> cl_give(x, "-ERR the node holding that queue cannot be reached", name)

# -- when the node holding a queue does not come back ---------------------------------

# One question and one answer, on a connection made for it. Everything between
# nodes that is not a stream of records is this shape: ask, hear, hang up.
# What one node says to another before anything else, when this broker asks
# for a password. A cluster whose members refuse strangers has to give its
# members something to be: `peer=name:word`, and the name has to be in the
# password file every node reads.
fn cl_greeting() =
  raw = b_peer()
  i = str_find(raw, ":")
  if str_len(raw) == 0 || i < 0 then "" else "AUTH " + raw[0:i] + " " + raw[i + 1:] + crlf2()

fn cl_one_shot(host, port, text) = match connect_to(host, port)
  Err(e) -> ""
  Ok(fd) ->
    sock_write(fd, cl_greeting() + text)
    cl_reply_after(fd, str_len(cl_greeting()) > 0)

# Signing in costs a line of answer, and the answer this wanted is the one
# after it.
fn cl_reply_after(fd, greeted) =
  first = cl_hear(fd, "")
  if greeted then cl_hear(fd, "") else first

fn cl_hear(fd, buf) =
  at = str_find(buf, crlf2())
  if at >= 0 then cl_hang_up(fd, buf[:at])
  else
    more = if sock_wait(fd, 2000) then sock_read(fd) else ""
    if str_len(more) == 0 then cl_hang_up(fd, "") else cl_hear(fd, buf + more)

fn cl_hang_up(fd, line) =
  sock_close(fd)
  line

# Before deciding a queue has no leader, ask whether somebody else knows of
# one. A node that gave its vote knows who it gave it to.
fn cl_ask_who(peers, name, i, me) = match peers
  Nil -> -1
  Cons(p, rest) -> if i == me then cl_ask_who(rest, name, i + 1, me) else cl_who_said(cl_one_shot(cl_host(p), cl_port(p), "WHO " + name + crlf2()), peers, name, i, me)

fn cl_who_said(line, peers, name, i, me) =
  if starts_with(line, "+WHO ") then str_to_int(line[5:]) else cl_ask_who_rest(peers, name, i, me)

fn cl_ask_who_rest(peers, name, i, me) = match peers
  Nil -> -1
  Cons(p, rest) -> cl_ask_who(rest, name, i + 1, me)

# Standing for the leadership of a queue: a later turn than any this node knows
# of, and how much of that queue's journal it has. A majority is needed, and
# this node counts as one of them because it has already voted for itself by
# asking.
fn cl_stand(name, term, size, peers, me) =
  cl_won(cl_count_votes(peers, name, term, size, 0, 1), len(peers))

fn cl_won(votes, n) = votes * 2 > n

fn cl_count_votes(peers, name, term, size, i, got) = match peers
  Nil -> got
  Cons(p, rest) -> cl_count_votes(rest, name, term, size, i + 1, got + cl_one_vote(p, name, term, size, i))

fn cl_one_vote(p: Peer, name, term, size, i) =
  if i == cl_me() then 0 else if starts_with(cl_one_shot(cl_host(p), cl_port(p), "VOTE " + name + " " + int_to_str(term) + " " + int_to_str(size) + " " + int_to_str(cl_me()) + crlf2()), "+VOTE") then 1 else 0

# A request arriving while the link is down is the moment to try the node
# again, so long as the last try was not a moment ago.
fn cl_asked(p: P, r, ses, done) =
  if p.fd >= 0 then cl_ask(p, r) else if now_millis() - p.tried < cl_retry_ms() then cl_no(p, r) else cl_try_again(p, r, ses)

fn cl_no(p: P, r) =
  cl_say_no(r)
  p

# The node that had this queue is not answering. Before deciding it has no
# leader, ask everybody else whether they know of one — somebody who gave a
# vote does. Failing that, stand for it.
fn cl_look_around(p: P, r, ses) =
  peers = cl_peers()
  said = cl_ask_who(peers, p.name, 0, cl_me())
  if said >= 0 && said != cl_me() then cl_go_to(p, r, ses, nth(peers, said)) else if said == cl_me() then cl_take_over(p, r) else cl_maybe_stand(p, r, peers)

fn cl_go_to(p: P, r, ses, where) = match where
  None -> cl_no(p, r)
  Some(q) -> cl_try_again(P(p.name, -1, p.subs, p.waits, p.head, p.tail, cl_host(q), cl_port(q), 0, p.reg), r, ses)

# Standing for the leadership, and taking it if a majority agrees. The turn
# asked for is one later than any this node knows of, and what it offers is
# how much of the queue's journal it has: a majority will not vote for a node
# that has less than they do, and a majority has everything anybody was told
# was safe.
fn cl_maybe_stand(p: P, r, peers) =
  if len(peers) <= 1 then cl_no(p, r) else if cl_stand(p.name, cl_term_of(p) + 1, cl_size_of(p), peers, cl_me()) then cl_elected(p, r, cl_term_of(p) + 1) else cl_no(p, r)

fn cl_term_of(p: P) =
  back = channel(1)
  send(p.reg, RTerm(p.name, back))
  recv(back)

fn cl_size_of(p: P) =
  back = channel(1)
  send(p.reg, RSize(p.name, back))
  recv(back)

fn cl_elected(p: P, r, term) =
  println("rillmq: taking over " + p.name + " for turn " + int_to_str(term))
  cl_note_term(p, term)
  cl_take_over(p, r)

fn cl_note_term(p: P, term) =
  back = channel(1)
  send(p.reg, RVote(p.name, term, cl_size_of(p), cl_me(), back))
  recv(back)
  0

# The registry puts a real queue where this stand-in was, and every connection
# picks it up on its next command. This request is refused, and whoever made it
# asks again.
fn cl_take_over(p: P, r) =
  back = channel(1)
  send(p.reg, RPromote(p.name, back))
  recv(back)
  cl_no(p, r)

fn cl_try_again(p: P, r, ses) = match connect_to(p.host, p.port)
  Err(e) -> cl_look_around(P(p.name, -1, p.subs, p.waits, p.head, p.tail, p.host, p.port, now_millis(), p.reg), r, ses)
  Ok(fd) ->
    spawn cl_link(fd, ses, "", p.name)
    back = P(p.name, fd, p.subs, p.waits, p.head, p.tail, p.host, p.port, 0, p.reg)
    if len(back.subs) > 0 then cl_send(back, "SUB " + back.name + crlf2()) else 0
    cl_ask(back, r)

fn cl_wait(p: P, w) =
  p.waits[p.tail] = w
  P(p.name, p.fd, p.subs, p.waits, p.head, p.tail + 1, p.host, p.port, p.tried, p.reg)

# What the queue would have done, said down the link instead. Everything that
# expects an answer leaves a note of what to do with it.
fn cl_ask(p: P, r) = match r
  QPub(body, props, out) ->
    cl_send(p, "PUB " + p.name + " " + int_to_str(str_len(body)) + crlf2() + body)
    cl_wait(p, WPub(out))
  QSub(s, reply) ->
    cl_send(p, "SUB " + p.name + crlf2())
    send(reply, 1)
    P(p.name, p.fd, append(p.subs, Cons(s, Nil)), p.waits, p.head, p.tail, p.host, p.port, p.tried, p.reg)
  QUnsub(sub_id, reply) ->
    send(reply, 1)
    cl_unsub(p, sub_id)
  QAck(id, reply) ->
    cl_send(p, "ACK " + p.name + " " + int_to_str(id) + crlf2())
    cl_wait(p, WNum(reply))
  QNack(id, reply) ->
    cl_send(p, "NACK " + p.name + " " + int_to_str(id) + crlf2())
    cl_wait(p, WNum(reply))
  QStat(reply) ->
    cl_send(p, "QSTAT " + p.name + crlf2())
    cl_wait(p, WStat(reply))
  QDrain(reply) ->
    cl_send(p, "DRAIN " + p.name + crlf2())
    cl_wait(p, WCount(reply))
  QPoke -> p
  # A stand-in cannot delete somebody else's queue, and saying so is better
  # than pretending: the count is -1, which is what a name nobody has answers.
  QStop(reply) ->
    send(reply, -1)
    p

# The last subscriber leaving takes the subscription with it, so the far end
# stops sending: this node has nobody to give a message to.
fn cl_unsub(p: P, sub_id) =
  left = cl_without(p.subs, sub_id)
  if len(left) > 0 then P(p.name, p.fd, left, p.waits, p.head, p.tail, p.host, p.port, p.tried, p.reg)
  else
    cl_send(p, "UNSUB " + p.name + crlf2())
    P(p.name, p.fd, left, p.waits, p.head, p.tail, p.host, p.port, p.tried, p.reg)

fn cl_without(subs, sub_id) = match subs
  Nil -> Nil
  Cons(s, rest) -> if q_sub_id(s) == sub_id then cl_without(rest, sub_id) else Cons(s, cl_without(rest, sub_id))

# An answer belongs to whoever asked first, because the far end answers in the
# order it was asked.
fn cl_answer(p: P, line) = match p.waits[p.head]
  None -> p
  Some(w) ->
    cl_give(w, line, p.name)
    map_del(p.waits, p.head)
    P(p.name, p.fd, p.subs, p.waits, p.head + 1, p.tail, p.host, p.port, p.tried, p.reg)

fn cl_give(w, line, name) = match w
  WPub(out) ->
    send(out, if starts_with(line, "+OK ") then OPublished(name, str_to_int(line[4:])) else OFrame(line + crlf2()))
    0
  WNum(reply) ->
    send(reply, if starts_with(line, "+OK") then 1 else 0)
    0
  WCount(reply) ->
    send(reply, cl_num(split(line, " "), 1))
    0
  WStat(reply) ->
    send(reply, cl_stat_of(split(line, " ")))
    0

fn cl_stat_of(parts) =
  QCount(cl_num(parts, 1), cl_num(parts, 2), cl_num(parts, 3), cl_num(parts, 4), cl_num(parts, 5), cl_num(parts, 6), cl_moment(cl_num(parts, 7)))

# The wire carries how long the oldest message has been waiting, because that
# is what a person reading a line of text wants. A `QCount` carries the moment
# it arrived, because that is what survives being passed around. This is the
# one place the two meet, and it is worth being explicit: an age of zero is no
# message rather than a message that arrived exactly now.
fn cl_moment(age) = if age <= 0 then 0 else now_millis() - age

fn cl_num(parts, i) = str_to_int(unwrap_or(nth(parts, i), "0"))

# A message from the far end goes to one of this node's subscribers, round
# robin, and is skipped if that one is not keeping up — the same rule a real
# queue follows, because from here the far end is the queue.
fn cl_hand_on(p: P, id, body) = cl_offer(p, id, body, p.subs)

fn cl_offer(p: P, id, body, left) = match left
  Nil -> p
  Cons(s, rest) ->
    if cl_try(q_sub_out(s), ODeliver(p.name, id, body, "", q_sub_id(s))) then P(p.name, p.fd, cl_rotate(p.subs), p.waits, p.head, p.tail, p.host, p.port, p.tried, p.reg) else cl_offer(p, id, body, rest)

fn cl_try(out, what) =
  ok = select
    send(out, what) -> true
    default -> false
  ok

fn cl_rotate(subs) = match subs
  Nil -> Nil
  Cons(s, rest) -> append(rest, Cons(s, Nil))
