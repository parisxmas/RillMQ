# The journal: what makes a message survive the broker.
#
# One file per queue, appended to and never written over. Three kinds of
# record go in it — the queue's name, once, at the front; a message that was
# published; and a message that was acknowledged — and a queue is rebuilt by
# reading them in order and keeping whatever was published and not
# acknowledged.
#
#   kind  1 byte    'Q' the name, 'P' published, 'A' acknowledged
#   id    8 bytes   little-endian
#   len   4 bytes   little-endian, the body that follows
#   body  len bytes
#   sum   4 bytes   little-endian, FNV-1a over everything above in this record
#
# The sum is not there for corruption, which is the disk's business. It is
# there for the last record: a machine that loses power in the middle of an
# append leaves a record that is half written, and the reader has to be able to
# say so rather than believing whatever the length field happened to contain.
# What follows a record that does not add up is not read, and the file is cut
# back to where it did.

fn j_kind_name() = 81

fn j_kind_pub() = 80

fn j_kind_ack() = 65

fn j_head() = 13

fn j_overhead() = 17

# -- writing bytes ----------------------------------------------------------------

fn j_u32(b: StrBuf, n) =
  b += bit_and(n, 255)
  b += bit_and(shr(n, 8), 255)
  b += bit_and(shr(n, 16), 255)
  b += bit_and(shr(n, 24), 255)

fn j_u64(b: StrBuf, n) =
  j_u32(b, n)
  j_u32(b, shr(n, 32))

# `kind` is said out loud because nothing else in the body says which of the
# two `+=` means: a number goes into a builder as one byte and a string goes in
# as itself, and a parameter used only there could be either.
fn j_record(kind: Int, id, body) =
  b = strbuf()
  b += kind
  j_u64(b, id)
  j_u32(b, str_len(body))
  b += body
  head = strbuf_str(b)
  c = strbuf()
  c += head
  j_u32(c, j_sum(head, 0, str_len(head), 2166136261))
  strbuf_str(c)

fn j_name_record(name) = j_record(j_kind_name(), 0, name)

fn j_pub_record(id, body) = j_record(j_kind_pub(), id, body)

fn j_ack_record(id) = j_record(j_kind_ack(), id, "")

# -- reading bytes ----------------------------------------------------------------

fn j_read_u32(s, at) =
  bit_or(bit_or(str_get(s, at), shl(str_get(s, at + 1), 8)), bit_or(shl(str_get(s, at + 2), 16), shl(str_get(s, at + 3), 24)))

fn j_read_u64(s, at) = bit_or(j_read_u32(s, at), shl(j_read_u32(s, at + 4), 32))

# FNV-1a, kept to thirty-two bits. Enough to notice a record that stops in the
# middle, which is the only thing it is asked to notice.
fn j_sum(s, at, upto, h) =
  if at >= upto then h else j_sum(s, at + 1, upto, bit_and(bit_xor(h, str_get(s, at)) * 16777619, 4294967295))

# What one record at `at` turns out to be.
type Rec
  RGot(kind: Int, id: Int, body: Str, next: Int)
  RStop

fn j_take(s, at) =
  if at + j_overhead() > str_len(s) then RStop
  else
    len = j_read_u32(s, at + 9)
    if len < 0 || at + j_overhead() + len > str_len(s) then RStop else j_check(s, at, len)

fn j_check(s, at, len) =
  upto = at + j_head() + len
  want = j_read_u32(s, upto)
  if j_sum(s, at, upto, 2166136261) != want then RStop else RGot(str_get(s, at), j_read_u64(s, at + 1), s[at + j_head():upto], upto + 4)

# -- replaying --------------------------------------------------------------------

# What a journal turned out to hold. `upto` is the offset of the first byte
# that was not part of a whole record, which is where the file is cut back to
# and where appending starts again.
type Replay
  Replay(name: Str, live: Map(Int, Str), order: List(Int), top: Int, upto: Int)

fn j_replay(path) =
  fd = file_open(path, "r")
  if fd < 0 then Replay("", map_new(), Nil, 0, 0)
  else
    r = j_walk(fd, "", 0, Replay("", map_new(), Nil, 0, 0))
    file_close(fd)
    j_finish(r)

# Read in blocks and carry whatever is left of a record into the next one, so
# that a journal larger than memory is still only a walk through it.
fn j_walk(fd, buf, base, r: Replay) =
  step = j_scan(buf, 0, r)
  more = file_read(fd, j_block())
  if str_len(more) == 0 then Replay(step.name, step.live, step.order, step.top, base + step.upto) else j_walk(fd, buf[step.upto:] + more, base + step.upto, Replay(step.name, step.live, step.order, step.top, 0))

fn j_block() = 262144

fn j_scan(buf, at, r: Replay) = match j_take(buf, at)
  RStop -> Replay(r.name, r.live, r.order, r.top, at)
  RGot(kind, id, body, next) -> j_scan(buf, next, j_apply(r, kind, id, body))

fn j_apply(r: Replay, kind, id, body) =
  if kind == j_kind_name() then Replay(body, r.live, r.order, r.top, r.upto)
  else if kind == j_kind_pub() then
    # The same message may be written twice: a rewrite puts the live queue in
    # a new file while a publish that was already on its way is still going to
    # be appended to it. Reading the second one again changes nothing, so long
    # as it is not counted as a second message.
    fresh = !map_has(r.live, id)
    r.live[id] = body
    Replay(r.name, r.live, if fresh then Cons(id, r.order) else r.order, if id > r.top then id else r.top, r.upto)
  else
    map_del(r.live, id)
    Replay(r.name, r.live, r.order, r.top, r.upto)

# The order records were written in, with the acknowledged ones dropped. They
# went on the front as they were read, so this is the reverse of a reverse.
fn j_finish(r: Replay) = Replay(r.name, r.live, j_keep(r.live, r.order, Nil), r.top, r.upto)

fn j_keep(live: Map(Int, Str), ids, acc) = match ids
  Nil -> acc
  Cons(id, rest) -> j_keep(live, rest, if map_has(live, id) then Cons(id, acc) else acc)

# -- the strand that owns the file --------------------------------------------------

type JReq
  # Appended, and the reply is sent once it is on the disk. This is what a
  # publisher waits for.
  JPut(rec: Str, reply: Chan(Str), value: Str)
  # Appended, and nothing waits. An acknowledgement is this: losing one costs
  # a redelivery, which at-least-once delivery already allows, so it is not
  # worth a wait of its own. It goes to the disk with whatever is synced next,
  # and it can never overtake the message it acknowledges, because the file is
  # written in order.
  JNote(rec: Str)
  # The whole live queue, to replace a file that is mostly things that have
  # been acknowledged.
  #
  # It comes down the same channel as the records, and that is the whole of
  # what makes it safe. A separate channel would let an acknowledgement
  # written after the queue took its snapshot be appended to the file that is
  # about to be replaced, and the message it acknowledged would come back from
  # the dead. Here, everything before this request is in the old file and
  # accounted for in the snapshot, and everything after it lands in the new
  # one.
  JRewriteReq(recs: List(Str), name: Str)

type JWait
  JWait(reply: Chan(Str), value: Str)

# Everything the queue needs to reach its journal with. Three channels rather
# than one because a compaction is not a record: it is the journal asking the
# queue a question and the queue answering, and neither may sit in the queue
# of records waiting to be written.
type Jr
  Jr(puts: Chan(JReq), want: Chan(Int))

# The journal's own state. One record rather than five parameters, because the
# loop is a tail call and past six arguments a tail call stops being a jump.
type Js
  Js(fd: Int, path: Str, pubs: Int, acks: Int)

# What a batch turned out to contain. `todo` is empty, or holds the one
# rewrite the batch ended on.
type JBatch
  JBatch(ws: List(JWait), pubs: Int, acks: Int, todo: List(JReq))

# How many records may go into one sync. The point is not the number: it is
# that while one batch is being synced — off the worker, so nothing else in
# the program stops — everything arriving queues up behind it and goes out
# together. A disk that takes a millisecond an sync therefore costs a
# millisecond a *batch* rather than a millisecond a message.
fn j_batch() = 4096

# A journal is worth rewriting when most of what is in it is things that have
# been acknowledged. With `n` published and `a` acknowledged the file holds
# `n + a` records and the queue holds `n - a` messages, so "four times as many
# records as messages" is `5a > 3n`. Under a few thousand records it is not
# worth the write, however bad the ratio.
fn j_compact_floor() = 4096

fn j_worth_rewriting(js: Js) =
  js.pubs + js.acks >= j_compact_floor() && js.acks * 5 > js.pubs * 3

fn j_run(path, jr: Jr, done) =
  fd = file_open(path, "a")
  if fd < 0 then j_cannot(path, jr, done) else j_loop(Js(fd, path, 0, 0), jr, done)

fn j_cannot(path, jr: Jr, done) =
  println("rillmq: cannot write " + path + ", this queue is memory only")
  j_run_memory(jr, done)

fn j_loop(js: Js, jr: Jr, done) =
  first = select
    r = recv(jr.puts) -> Some(r)
    recv(done) -> None
  match first
    None ->
      file_sync(js.fd)
      file_close(js.fd)
      0
    Some(r) -> j_loop(j_commit(js, jr, r), jr, done)

fn j_commit(js: Js, jr: Jr, r) =
  b = strbuf()
  g = j_gather(b, jr, j_add(b, r, JBatch(Nil, 0, 0, Nil)), j_batch())
  file_write(js.fd, strbuf_str(b))
  file_sync(js.fd)
  j_tell_all(g.ws)
  j_maybe_ask(j_do_todo(Js(js.fd, js.path, js.pubs + g.pubs, js.acks + g.acks), g.todo), jr)

fn j_do_todo(js: Js, todo) = match todo
  Nil -> js
  Cons(t, rest) -> j_rewrite(js, t)

# Asking is a send that gives up rather than waits. The queue may be busy, and
# a journal that waited for it while the queue was waiting to write a record
# would be two strands each holding what the other wants. There is room for
# one question, so a second one while the first is unanswered simply does not
# go.
fn j_maybe_ask(js: Js, jr: Jr) =
  if !j_worth_rewriting(js) then js
  else
    asked = select
      send(jr.want, 1) -> true
      default -> false
    js

# Everything already waiting, without waiting for any more of it.
fn j_gather(b: StrBuf, jr: Jr, g: JBatch, left) =
  # A rewrite ends the batch: what came before it belongs in the file that is
  # about to be replaced, and what comes after belongs in the one replacing it.
  if left <= 0 || len(g.todo) > 0 then g
  else
    got = select
      r = recv(jr.puts) -> Some(r)
      default -> None
    match got
      None -> g
      Some(r) -> j_gather(b, jr, j_add(b, r, g), left - 1)

fn j_add(b: StrBuf, r, g: JBatch) = match r
  JPut(rec, reply, value) ->
    b += rec
    JBatch(Cons(JWait(reply, value), g.ws), g.pubs + 1, g.acks, g.todo)
  JNote(rec) ->
    b += rec
    JBatch(g.ws, g.pubs, g.acks + 1, g.todo)
  JRewriteReq(recs, name) -> JBatch(g.ws, g.pubs, g.acks, Cons(r, Nil))

# In the order the records went in. `j_add` puts each on the front as it
# arrives, so a batch is back to front until this turns it round — and a
# publisher pipelining a thousand messages would otherwise be answered for the
# thousandth first.
fn j_tell_all(ws) = j_tell(reverse(ws))

fn j_tell(ws) = match ws
  Nil -> 0
  Cons(w, rest) ->
    j_answer(w)
    j_tell(rest)

fn j_answer(w: JWait) =
  send(w.reply, w.value)
  0

# The same shape with no file behind it, for a broker started without a
# directory to write in. A publisher still waits for the journal, and the
# journal still answers; there is simply nothing between the two.
fn j_run_memory(jr: Jr, done) =
  first = select
    r = recv(jr.puts) -> Some(r)
    recv(done) -> None
  match first
    None -> 0
    Some(r) ->
      j_tell_all(j_add(strbuf(), r, JBatch(Nil, 0, 0, Nil)).ws)
      j_run_memory(jr, done)

# -- files ---------------------------------------------------------------------------

# A queue name is whatever a client sent and a filename is not, so anything
# outside the safe set is written as an underscore and two hex digits. The
# real name is not recovered from this: it is the first record in the file, so
# the encoding only has to be unique, not reversible.
fn j_file(name) = j_safe(name, 0, strbuf()) + ".log"

fn j_safe(name, i, b: StrBuf) =
  if i >= str_len(name) then strbuf_str(b)
  else
    c = str_get(name, i)
    j_put(b, c)
    j_safe(name, i + 1, b)

fn j_put(b: StrBuf, c) =
  if j_plain(c) then
    b += c
    0
  else j_hex(b, c)

fn j_plain(c) =
  c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 46 || c == 45

fn j_hex(b: StrBuf, c) =
  b += 95
  b += j_nibble(shr(c, 4))
  b += j_nibble(bit_and(c, 15))
  0

fn j_nibble(n) = if n < 10 then 48 + n else 87 + n

# The queue's own name, out of the front of its journal, so that a directory
# of files can be turned back into a broker without the filenames having to
# mean anything.
fn j_name_of(path) =
  fd = file_open(path, "r")
  if fd < 0 then ""
  else
    head = file_read(fd, 1024)
    file_close(fd)
    j_name_in(head)

fn j_name_in(head) = match j_take(head, 0)
  RStop -> ""
  RGot(kind, id, body, next) -> if kind == j_kind_name() then body else ""

# Everything a journal is cut back to after a replay: whatever came after the
# last whole record was half a write, and is not part of the queue.
fn j_trim(path, upto) =
  fd = file_open(path, "r+")
  if fd < 0 then 0
  else
    j_cut(fd, upto)
    file_close(fd)
    0

fn j_cut(fd, upto) =
  if file_size(fd) <= upto then 0
  else
    file_truncate(fd, upto)
    file_sync(fd)
    0

# -- rewriting ------------------------------------------------------------------

# The whole live queue into a new file, and that file over the old one.
#
# The order is the point. The new file is written and made durable *before*
# anything is renamed, so a machine that stops in the middle has the old
# journal untouched and a half-written temporary nobody will read. The rename
# is atomic on a Unix filesystem, so what a reader sees is one file or the
# other and never half of either. And the directory is synced last, because
# until it is, the fact that this name now means the new file is only in a
# cache — the bytes being durable does not make the *name* durable.
fn j_rewrite(js: Js, c) = match c
  JPut(rec, reply, value) -> js
  JNote(rec) -> js
  JRewriteReq(recs, name) ->
    tmp = js.path + ".new"
    nfd = file_open(tmp, "w")
    if nfd < 0 then js
    else
      file_write(nfd, j_name_record(name))
      j_write_recs(nfd, recs, strbuf(), 0)
      file_sync(nfd)
      file_close(nfd)
      j_swap(js, tmp, len(recs))

fn j_swap(js: Js, tmp, n) =
  if !file_rename(tmp, js.path) then js
  else
    dir_sync(dir_of(js.path))
    file_close(js.fd)
    j_reopened(js, n)

# The descriptor the journal was appending to now points at a file that has
# been unlinked, so it is opened again by name. If that fails the queue keeps
# running and stops being durable, which is worth saying out loud.
fn j_reopened(js: Js, n) =
  fd = file_open(js.path, "a")
  if fd >= 0 then Js(fd, js.path, n, 0)
  else
    println("rillmq: lost " + js.path + " while rewriting it")
    Js(fd, js.path, n, 0)

# In chunks rather than one string. A queue holding a million messages would
# otherwise be asked for a hundred megabytes of contiguous bytes to write a
# hundred megabytes it already has.
fn j_write_recs(fd, recs, b: StrBuf, n) = match recs
  Nil ->
    file_write(fd, strbuf_str(b))
    0
  Cons(r, rest) ->
    b += r
    if n < j_chunk() then j_write_recs(fd, rest, b, n + 1) else j_flush_recs(fd, rest, b)

fn j_flush_recs(fd, rest, b: StrBuf) =
  file_write(fd, strbuf_str(b))
  strbuf_clear(b)
  j_write_recs(fd, rest, b, 0)

fn j_chunk() = 1000
