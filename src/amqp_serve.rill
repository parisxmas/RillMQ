# An AMQP 0-9-1 connection, on top of the same queues everything else uses.
#
# The shape is two strands, as with RillMQ's own protocol, but the division is
# different. Here the *session* owns the socket's write side and all the state,
# and a reader strand does nothing but take frames off the socket and hand them
# over. That is because a delivery in AMQP carries a tag which counts
# deliveries on the connection, and acknowledgements arrive naming those tags:
# one strand has to know both, so one strand does.
import "broker"
import "amqp"
import "auth"

# Everything a connection remembers.
type Am
  Am(fd: Int, ssl: Ptr, reg: Chan(RReq), done: Chan(Int), cid: Int, out: Chan(Out), tag: Int, whose: Map(Int, Str), which: Map(Int, Int), consumers: Map(Str, Str), where: Map(Str, Int), qos: Map(Int, Int), serving: Map(Int, Str), closing: Map(Int, Int), kinds: Map(Str, Str), subs: List(Str), pub_x: Str, pub_to: Str, pub_chan: Int, pub_back: Bool, pub_want: Int, pub_body: Str, pub_props: Str, confirms: Bool, on_chan: Int, wants_blocked: Bool, blocked: Bool, looked: Int, seq: Int, acked: Int, told: Int, quick: Bool)

# What reaches the session.
type ASes
  AIn(kind: Int, chan: Int, payload: Str)
  AOut(what: Out)
  AEnd
  # Neither inbox had anything this instant. Not an event — the moment before
  # one, and where anything owed to the client is written.
  AIdle

# What a connection is before it is one: the pieces the handshake carries from
# the first byte to the loop. A record rather than seven arguments, because
# seven arguments is where a Rill call stops being a jump.
type Who
  Who(fd: Int, ssl: Ptr, reg: Chan(RReq), done: Chan(Int), cid: Int, gone: Chan(Int), users: Str, wants_blocked: Bool)

# -- the handshake ---------------------------------------------------------------

# Read one whole frame, waiting for the rest of it if it is not all here.
type ARead
  ARead(kind: Int, chan: Int, payload: Str, rest: Str)
  ADead

fn am_read_frame(w: Who, buf) = match a_take(buf, 0)
  AGot(kind, chan, payload, next) -> ARead(kind, chan, payload, buf[next:])
  ABad(why) -> ADead
  ANeed -> am_more(w, buf)

fn am_more(w: Who, buf) =
  more = p_read(w.ssl, w.fd)
  if str_len(more) == 0 then ADead else am_read_frame(w, buf + more)

fn am_fill_header(w: Who, buf) =
  if str_len(buf) >= 8 then buf
  else
    more = p_read(w.ssl, w.fd)
    if str_len(more) == 0 then "" else am_fill_header(w, buf + more)

fn am_serve(fd, reg, done, cid, gone, d: Door) =
  sock_nodelay(fd)
  if is_null(d.tls.ctx) then am_greeted(fd, reg, done, cid, gone, Who(fd, null_ptr(), reg, done, cid, gone, d.users, false)) else am_shaken(fd, reg, done, cid, gone, d, tls_up(d.tls, fd))

fn am_shaken(fd, reg, done, cid, gone, d: Door, ssl) =
  if is_null(ssl) then am_hang_up(fd, gone) else am_greeted(fd, reg, done, cid, gone, Who(fd, ssl, reg, done, cid, gone, d.users, false))

fn am_greeted(fd, reg, done, cid, gone, w: Who) =
  head = am_fill_header(w, "")
  if !a_is_header(head) then am_wrong_version(w) else am_start(w, head[8:])

# A client asking for a version we do not speak is answered with the bytes of
# the version we do, which is what the specification says to do and is more
# use than a closed socket.
fn am_wrong_version(w: Who) =
  p_write(w.ssl, w.fd, a_header())
  p_close(w.ssl, w.fd)
  send(w.gone, 1)
  0

fn am_start(w: Who, buf) =
  p_write(w.ssl, w.fd, am_connection_start())
  match am_read_frame(w, buf)
    ADead -> am_shut(w)
    ARead(kind, chan, payload, rest) -> am_said(am_noted(w, payload), rest, am_start_ok(payload))

# `Connection.Start-Ok` is where a client says who it is: a table of things it
# would like the server to know, the mechanism it picked out of the ones
# offered, and its answer in that mechanism. Only PLAIN is offered, so only
# PLAIN is read.
fn am_start_ok(payload) =
  at = a_after_table(payload, am_args())
  au_plain(a_get_longstr(payload, a_after_shortstr(payload, at)))

# A word that is not the right one ends the connection there and then, with no
# method and no reason given. That is what the specification asks for and it is
# also the only answer that tells an attacker nothing: a broker that says
# whether the *name* was wrong has answered half the question.
# `Connection.Blocked` is an extension, and a client that has not said it
# understands one will be confused by receiving it — so RabbitMQ sends it only
# to clients that advertise `connection.blocked` among their capabilities, and
# so does this.
#
# What it does not do is parse the field table. The capability's name is a key
# in it, and a key in a field table is its own bytes; finding the name in the
# blob is finding the capability. It is a shortcut and it is written down as
# one: a client with that string somewhere else in its properties would be
# told something it did not ask for, which is a stranger thing to do on
# purpose than to have happen.
fn am_noted(w: Who, payload) =
  Who(w.fd, w.ssl, w.reg, w.done, w.cid, w.gone, w.users, str_find(payload, "connection.blocked") >= 0)

fn am_said(w: Who, buf, said: Said) =
  if au_ok(w.users, said.name, said.word) then am_tune(w, buf) else am_shut(w)

fn am_tune(w: Who, buf) =
  p_write(w.ssl, w.fd, am_connection_tune())
  match am_read_frame(w, buf)
    ADead -> am_shut(w)
    ARead(kind, chan, payload, rest) -> am_open(w, rest)

fn am_open(w: Who, buf) = match am_read_frame(w, buf)
  ADead -> am_shut(w)
  ARead(kind, chan, payload, rest) ->
    p_write(w.ssl, w.fd, am_connection_open_ok())
    am_run(w, rest)

fn am_hang_up(fd, gone) =
  sock_close(fd)
  send(gone, 1)
  0

fn am_shut(w: Who) =
  p_close(w.ssl, w.fd)
  send(w.gone, 1)
  0

# -- the loop -----------------------------------------------------------------------

fn am_backlog() = 256

fn am_run(w: Who, buf) =
  ses = channel(am_backlog())
  out = channel(am_backlog())
  spawn am_reader(w, ses, buf, 0)
  am_loop(Am(w.fd, w.ssl, w.reg, w.done, w.cid, out, 1, map_new(), map_new(), map_new(), map_new(), map_new(), map_new(), map_new(), map_new(), Nil, "", "", 0, false, 0, "", "", false, 1, w.wants_blocked, false, 0, 1, 0, 0, false), ses, w.gone)

# The reader: frames off the socket and nothing else.
fn am_reader(w: Who, ses, buf, from) = match a_take(buf, from)
  AGot(kind, chan, payload, next) ->
    send(ses, AIn(kind, chan, payload))
    am_reader(w, ses, buf, next)
  ABad(why) ->
    send(ses, AEnd)
    0
  ANeed ->
    kept = if from == 0 then buf else buf[from:]
    more = p_read(w.ssl, w.fd)
    if str_len(more) == 0 then am_end(ses) else am_reader(w, ses, kept + more, 0)

fn am_end(ses) =
  send(ses, AEnd)
  0

# Two inboxes, not one, and this is the whole reason the session does not
# wedge. What a queue hands back — a delivery, a publish that reached the disk
# — arrives on `out`; what the client sends arrives on `ses`. Merging them into
# one channel was simpler to write and was a deadlock: the session asks a queue
# a question and stands still on the answer, while the queue stands still
# trying to put a delivery in the very pipe the session has stopped emptying.
#
# Kept apart, the session can go on emptying `out` while it waits, which is
# `am_wait` below. A client that pipelines requests faster than they are
# answered simply waits, which is what it should do.
# A look that does not wait, and then a wait. What sits between them is the
# only moment at which this connection is up to date, and it is where the
# confirms owed to a publisher are written: one frame for all of them rather
# than one frame each.
fn am_loop(am: Am, ses, gone) =
  step = select
    m = recv(ses) -> m
    o = recv(am.out) -> AOut(o)
    default -> AIdle
  am_step(am, ses, gone, step)

fn am_block(am: Am, ses, gone) =
  step = select
    m = recv(ses) -> m
    o = recv(am.out) -> AOut(o)
    recv(am.done) -> AEnd
  am_step(am, ses, gone, step)

fn am_step(am: Am, ses, gone, m) = match m
  AIdle -> am_block(am_nudge(am_flush_confirms(am)), ses, gone)
  AEnd -> am_close(am, gone)
  AOut(what) -> am_loop(am_from_queue(am, what), ses, gone)
  AIn(kind, chan, payload) ->
    next = am_handle(am, kind, chan, payload)
    if next.fd < 0 then am_close(next, gone) else am_loop(next, ses, gone)

fn am_from_queue(am: Am, what) = match what
  ODeliver(queue, id, body, props, sub) -> am_send_delivery(am, queue, id, body, props, sub)
  ONoRoute(exchange, key, body, props, chan) -> am_hand_back(am, chan, exchange, key, body, props)
  OCancelled(queue, sub) -> am_tell_cancelled(am, sub)
  OPublished(queue, id) -> am_confirm(am)
  OFrame(text) -> am

# A publish is on the disk. A client that asked for confirms is told so, with
# the number it published under; the journal answers in the order it was asked,
# so counting is enough and nothing has to be remembered per message.
#
# Counted here and said later. `Basic.Ack` has a `multiple` bit meaning "and
# everything before this one", which is what makes a hundred thousand confirms
# a handful of frames instead of a hundred thousand: nothing is written until
# the session has run out of things to do, and then one frame covers every
# publish that became safe while it was busy.
#
# It was one frame each, and that was most of what a confirmed publish cost.
# The disk was not: with a journal and without it, a hundred thousand
# confirmed publishes were 251 and 231 milliseconds — group commit had already
# made the syncs almost free, and the writing back had not been looked at.
# `Basic.Return` is the message coming home: a code, a reason, and where it
# was sent, followed by the same header and body frames the broker would have
# delivered. A client is handed exactly what it published.
fn am_return(chan, exchange, key) =
  b = strbuf()
  a_u16(b, am_no_route())
  a_shortstr(b, "NO_ROUTE")
  a_shortstr(b, exchange)
  a_shortstr(b, key)
  am_method(chan, a_class_basic(), 50, strbuf_str(b))

fn am_no_route() = 312

# Reaching here at all means the publisher asked: nothing sends one of these
# unless `mandatory` was set, so there is no flag to check a second time — and
# checking one would have been checking the wrong publish, since by now the
# connection is several messages further on.
# The default exchange, answered by the session itself: it looked the queue up
# and there was none, so nothing else needs telling.
fn am_dropped_here(am: Am, body) =
  if !am.pub_back then am else am_hand_back(am, am.pub_chan, "", am.pub_to, body, am.pub_props)

fn am_hand_back(am: Am, chan, exchange, key, body, props) =
  am_say(am, am_return(chan, exchange, key) + am_content(chan, body, props))
  am

fn am_confirm(am: Am) =
  if !am.confirms then am
  else
    Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, am.pub_x, am.pub_to, am.pub_chan, am.pub_back, am.pub_want, am.pub_body, am.pub_props, am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked + 1, am.told, am.quick)

# A consumer that answers for nothing leaves the queue with no reason to look
# again, so this is the reason: once, at the moment this connection has caught
# up, for every queue it is reading. One message a batch, not one a message,
# which is the difference between this and the acknowledgements it replaces.
fn am_nudge(am: Am) =
  if !am.quick then am else am_poke_each(am, am.subs)

fn am_poke_each(am: Am, names) = match names
  Nil -> am
  Cons(n, rest) -> am_poke_each(am_hand(am, am_queue(am, n), QPoke), rest)

fn am_flush_confirms(am: Am) =
  if !am.confirms || am.acked <= am.told then am else am_told_up_to(am, am.acked)

fn am_told_up_to(am: Am, upto) =
  am_say(am, am_basic_ack_upto(am.on_chan, upto))
  Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, am.pub_x, am.pub_to, am.pub_chan, am.pub_back, am.pub_want, am.pub_body, am.pub_props, am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked, upto, am.quick)

# -- asking a queue something ---------------------------------------------------

# Waiting for one answer while still taking whatever the queues hand over. The
# connection's state comes back with the answer because handling a delivery
# mints a tag and remembers what it stands for, so the wait changes the session
# and the caller must carry that change on.
type AInt
  AInt(am: Am, got: Int)

type AStat
  AStat(am: Am, got: QCount)

# Handing something to a queue without stopping listening to it. A full inbox
# is a queue that is behind, and a queue that is behind is very often behind
# *because* it is trying to hand this connection something back. So the offer
# to send and the readiness to receive are made in the same breath, and
# whichever the other end is ready for happens first.
fn am_hand(am: Am, ch, req) = select
  send(ch, req) -> am
  o = recv(am.out) -> am_hand(am_from_queue(am, o), ch, req)

fn am_wait(am: Am, back) = select
  v = recv(back) -> AInt(am, v)
  o = recv(am.out) -> am_wait(am_from_queue(am, o), back)

fn am_wait_stat(am: Am, back) = select
  v = recv(back) -> AStat(am, v)
  o = recv(am.out) -> am_wait_stat(am_from_queue(am, o), back)

# The same wait with a way of giving up, which only `Basic.Get` needs.
type AKept
  AKept(am: Am, got: Option(Out))

fn am_wait_one(am: Am, one, until) = select
  v = recv(one) -> AKept(am, Some(v))
  o = recv(am.out) -> am_wait_one(am_from_queue(am, o), one, until)
  timeout(until) -> AKept(am, None)

fn am_close(am: Am, gone) =
  am_forget_all(am, map_keys(am.consumers))
  p_close(am.ssl, am.fd)
  send(gone, 1)
  0

# Every consumer, by its own name, rather than every queue this connection was
# reading. They are not the same list once two channels may read one queue.
fn am_forget_all(am: Am, tags) = match tags
  Nil -> 0
  Cons(t, rest) -> am_forget_all(am_forget(am, t), rest)

fn am_forget(am: Am, tag) = match am.consumers[tag]
  None -> am
  Some(queue) -> am_dropped(am_drop(am, queue, am_sub_id(am.cid, map_or(am.where, tag, 0))), tag)

fn am_dropped(am: Am, tag) =
  map_del(am.serving, am_sub_id(am.cid, map_or(am.where, tag, 0)))
  map_del(am.consumers, tag)
  map_del(am.where, tag)
  am

fn am_drop(am: Am, name, sub_id) =
  if closed(am.done) then am
  else
    back = channel(1)
    am_wait(am_hand(am, am_queue(am, name), QUnsub(sub_id, back)), back).am

fn am_queue(am: Am, name) =
  back = channel(1)
  send(am.reg, RFind(name, back))
  recv(back)

fn am_say(am: Am, bytes) =
  p_write(am.ssl, am.fd, bytes)
  0

# Marking a connection finished: the descriptor is set to -1 and the loop sees
# it on the way round.
fn am_finished(am: Am) =
  Am(-1, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, am.pub_x, am.pub_to, am.pub_chan, am.pub_back, am.pub_want, am.pub_body, am.pub_props, am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked, am.told, am.quick)

# -- what the server says ------------------------------------------------------------

fn am_method(chan, cls, method, args) =
  b = a_method_head(cls, method)
  b += args
  a_frame(a_kind_method(), chan, strbuf_str(b))

fn am_connection_start() =
  b = strbuf()
  a_u8(b, 0)
  a_u8(b, 9)
  a_empty_table(b)
  a_longstr(b, "PLAIN")
  a_longstr(b, "en_US")
  am_method(0, a_class_connection(), 10, strbuf_str(b))

fn am_connection_tune() =
  b = strbuf()
  a_u16(b, 2047)
  a_u32(b, 131072)
  a_u16(b, 0)
  am_method(0, a_class_connection(), 30, strbuf_str(b))

fn am_connection_open_ok() =
  b = strbuf()
  a_shortstr(b, "")
  am_method(0, a_class_connection(), 41, strbuf_str(b))

fn am_connection_close_ok() = am_method(0, a_class_connection(), 51, "")

fn am_connection_blocked(why) =
  b = strbuf()
  a_shortstr(b, why)
  am_method(0, a_class_connection(), 60, strbuf_str(b))

fn am_connection_unblocked() = am_method(0, a_class_connection(), 61, "")

fn am_channel_open_ok(chan) =
  b = strbuf()
  a_longstr(b, "")
  am_method(chan, a_class_channel(), 11, strbuf_str(b))

fn am_channel_close_ok(chan) = am_method(chan, a_class_channel(), 41, "")

fn am_channel_close(chan, code, why, cls, method) =
  b = strbuf()
  a_u16(b, code)
  a_shortstr(b, why)
  a_u16(b, cls)
  a_u16(b, method)
  am_method(chan, a_class_channel(), 40, strbuf_str(b))

fn am_queue_declare_ok(chan, name, ready, consumers) =
  b = strbuf()
  a_shortstr(b, name)
  a_u32(b, ready)
  a_u32(b, consumers)
  am_method(chan, a_class_queue(), 11, strbuf_str(b))

fn am_exchange_declare_ok(chan) = am_method(chan, a_class_exchange(), 11, "")

fn am_queue_bind_ok(chan) = am_method(chan, a_class_queue(), 21, "")

fn am_queue_purge_ok(chan, n) =
  b = strbuf()
  a_u32(b, n)
  am_method(chan, a_class_queue(), 31, strbuf_str(b))

fn am_queue_delete_ok(chan, n) =
  b = strbuf()
  a_u32(b, n)
  am_method(chan, a_class_queue(), 41, strbuf_str(b))

fn am_queue_unbind_ok(chan) = am_method(chan, a_class_queue(), 51, "")

fn am_exchange_delete_ok(chan) = am_method(chan, a_class_exchange(), 21, "")

fn am_basic_qos_ok(chan) = am_method(chan, a_class_basic(), 11, "")

fn am_basic_consume_ok(chan, tag) =
  b = strbuf()
  a_shortstr(b, tag)
  am_method(chan, a_class_basic(), 21, strbuf_str(b))

# `Basic.Cancel` from the server rather than to it: the queue this consumer
# was reading has gone.
fn am_basic_cancel(chan, tag) =
  b = strbuf()
  a_shortstr(b, tag)
  a_u8(b, 0)
  am_method(chan, a_class_basic(), 30, strbuf_str(b))

fn am_basic_cancel_ok(chan, tag) =
  b = strbuf()
  a_shortstr(b, tag)
  am_method(chan, a_class_basic(), 31, strbuf_str(b))

fn am_confirm_select_ok(chan) = am_method(chan, a_class_confirm(), 11, "")

fn am_basic_ack(chan, tag) = am_ack_frame(chan, tag, 0)

# The same with the `multiple` bit set: this one and every one before it.
fn am_basic_ack_upto(chan, tag) = am_ack_frame(chan, tag, 1)

fn am_ack_frame(chan, tag, multiple) =
  b = strbuf()
  a_u64(b, tag)
  a_u8(b, multiple)
  am_method(chan, a_class_basic(), 80, strbuf_str(b))

fn am_basic_get_empty(chan) =
  b = strbuf()
  a_shortstr(b, "")
  am_method(chan, a_class_basic(), 72, strbuf_str(b))

# A message on the wire is three frames: the method that says who it is for,
# a header that says how long it is, and the body. They must not be broken up
# by anything else on the same channel, which is why the session writes all
# three in one go.
fn am_content(chan, body, props) =
  b = strbuf()
  a_u16(b, a_class_basic())
  a_u16(b, 0)
  a_u64(b, str_len(body))
  # The client's own property bytes, back as they came. An empty one is two
  # zero bytes: a flags word with nothing set.
  am_put_props(b, props)
  a_frame(a_kind_header(), chan, strbuf_str(b)) + a_frame(a_kind_body(), chan, body)

fn am_put_props(b: StrBuf, props) =
  if str_len(props) == 0 then a_u16(b, 0)
  else
    b += props
    0

fn am_deliver(chan, tag, consumer, queue, body, props) =
  b = strbuf()
  a_shortstr(b, consumer)
  a_u64(b, tag)
  a_u8(b, 0)
  a_shortstr(b, "")
  a_shortstr(b, queue)
  am_method(chan, a_class_basic(), 60, strbuf_str(b)) + am_content(chan, body, props)

fn am_get_ok(chan, tag, queue, left, body, props) =
  b = strbuf()
  a_u64(b, tag)
  a_u8(b, 0)
  a_shortstr(b, "")
  a_shortstr(b, queue)
  a_u32(b, left)
  am_method(chan, a_class_basic(), 71, strbuf_str(b)) + am_content(chan, body, props)

# A subscriber's name to the queue. It has to be this connection's alone and
# also this channel's alone, so it is both: sixteen bits of channel under the
# connection's number, which is what AMQP gives a channel anyway.
fn am_chans() = 65536

fn am_sub_id(cid, chan) = cid * am_chans() + chan

# `Basic.Get` subscribes for an instant and is nobody's consumer, so it takes
# the one channel number that cannot be a channel.
fn am_get_id(cid) = cid * am_chans() + am_chans() - 1

# -- when the answer is no ------------------------------------------------------------

# AMQP's way of refusing: the channel is closed with a code and a reason, and
# what the client was in the middle of is over. It is the only way a broker can
# say no to something it has already accepted the frame for, and it is why a
# channel exists at all — a connection carrying eight of them loses one and
# keeps seven.
#
# A channel closed this way is deaf until the client says `Channel.Close-Ok`.
# That is the specification's rule and it is not a formality: the client has
# frames in flight that were written before it heard, and answering them would
# be answering questions asked of a channel that no longer exists.
fn am_refuse(am: Am, chan, code, why, cls, method) =
  if chan <= 0 || map_has(am.closing, chan) then am else am_refusing(am, chan, code, why, cls, method)

fn am_refusing(am: Am, chan, code, why, cls, method) =
  gone = am_forget_on(am, map_keys(am.consumers), chan)
  map_del(gone.qos, chan)
  gone.closing[chan] = 1
  am_answer(gone, am_channel_close(chan, code, why, cls, method))

fn am_deaf(am: Am, chan) = map_has(am.closing, chan)

fn am_heard_close_ok(am: Am, chan) =
  map_del(am.closing, chan)
  am

# 406, for a client that is out of step with the broker rather than asking for
# something that is not there: an acknowledgement of a message it was never
# given, or a second consumer under a name already in use.
fn am_precondition() = 406

# 540, for something in the protocol this broker has not written. Answering
# nothing at all was worse than answering no: a client calling `Queue.Purge`
# waited for a reply that was never coming, and a broker that hangs is harder
# to work out than one that refuses.
fn am_not_implemented() = 540

# -- what the client asked for --------------------------------------------------------

fn am_handle(am: Am, kind, chan, payload) =
  if am_deaf(am, chan) then am_while_deaf(am, kind, chan, payload) else am_awake(am, kind, chan, payload)

# Everything on a closed channel is passed over, and the one frame that is not
# is the client agreeing it is closed.
fn am_while_deaf(am: Am, kind, chan, payload) =
  if kind != a_kind_method() then am else if a_get_u16(payload, 0) == a_class_channel() && a_get_u16(payload, 2) == 41 then am_heard_close_ok(am, chan) else am

fn am_awake(am: Am, kind, chan, payload) =
  if kind == a_kind_heartbeat() then am else if kind == a_kind_header() then am_header(am, payload) else if kind == a_kind_body() then am_body(am, chan, payload) else if kind == a_kind_method() then am_dispatch(am, chan, a_get_u16(payload, 0), a_get_u16(payload, 2), payload) else am

fn am_dispatch(am: Am, chan, cls, method, payload) =
  if cls == a_class_connection() then am_connection(am, method) else if cls == a_class_channel() then am_channel(am, chan, method) else if cls == a_class_exchange() then am_exchange_method(am, chan, method, payload) else if cls == a_class_queue() then am_queue_method(am, chan, method, payload) else if cls == a_class_basic() then am_basic(am, chan, method, payload) else if cls == a_class_confirm() then am_confirm_select(am, chan, method) else am_no_method(am, chan, cls, method)

fn am_no_method(am: Am, chan, cls, method) =
  am_refuse(am, chan, am_not_implemented(), "rillmq does not do " + int_to_str(cls) + "." + int_to_str(method), cls, method)

# `Confirm.Select` turns a channel into one where every publish is answered
# once it is on the disk. It is the only way an AMQP client can learn what
# RillMQ's own protocol tells a publisher as a matter of course.
fn am_confirm_select(am: Am, chan, method) =
  if method != 10 then am_no_method(am, chan, a_class_confirm(), method) else am_turn_on_confirms(am, chan)

fn am_turn_on_confirms(am: Am, chan) =
  am_say(am, am_confirm_select_ok(chan))
  Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, am.pub_x, am.pub_to, am.pub_chan, am.pub_back, am.pub_want, am.pub_body, am.pub_props, true, chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked, am.told, am.quick)

# Channel zero is the connection's own and cannot be closed with a
# `Channel.Close`, so what is not written here is passed over rather than
# refused. The two that matter are both handled: the client asking to close,
# and the client agreeing that it is closed.
fn am_connection(am: Am, method) =
  if method != 50 then am
  else
    am_say(am, am_connection_close_ok())
    am_finished(am)

fn am_channel(am: Am, chan, method) =
  if method == 10 then am_answer(am, am_channel_open_ok(chan)) else if method == 40 then am_shut_channel(am, chan) else if method == 41 then am else am_no_method(am, chan, a_class_channel(), method)

# Closing a channel takes its consumers with it. It went unnoticed while every
# consumer on a connection was one subscriber to its queue: closing a channel
# left the queue handing messages to a channel the client had finished with,
# and they came back only when the acknowledgement deadline gave up on them.
fn am_shut_channel(am: Am, chan) =
  gone = am_forget_on(am, map_keys(am.consumers), chan)
  map_del(gone.qos, chan)
  am_answer(gone, am_channel_close_ok(chan))

fn am_forget_on(am: Am, tags, chan) = match tags
  Nil -> am
  Cons(t, rest) -> am_forget_on(if map_or(am.where, t, -1) == chan then am_forget(am, t) else am, rest, chan)

# `Exchange.Declare` names an exchange and says what kind it is. The kind is
# the third field: past the reserved short, past the name.
fn am_exchange_method(am: Am, chan, method, payload) =
  if method == 20 then am_delete_exchange(am, chan, a_get_shortstr(payload, am_after_reserved()), a_get_u8(payload, a_after_shortstr(payload, am_after_reserved())))
  else if method != 10 then am_no_method(am, chan, a_class_exchange(), method)
  else
    at = a_after_shortstr(payload, am_after_reserved())
    am_exchange(am, a_get_shortstr(payload, am_after_reserved()), a_get_shortstr(payload, at), bit_and(a_get_u8(payload, a_after_shortstr(payload, at)), am_durable()) != 0)
    am_answer(am, am_exchange_declare_ok(chan))

# `Exchange.Delete` takes its bindings with it and writes a record saying so,
# because a restart replays the routing journal and would otherwise bring back
# what somebody deleted.
fn am_delete_exchange(am: Am, chan, name, bits) =
  back = channel(1)
  send(am.reg, RDropExchange(name, false, bit_and(bits, am_if_unused()) != 0, back))
  am_deleted_exchange(am, chan, name, recv(back))

fn am_deleted_exchange(am: Am, chan, name, n) =
  if n == -1 then am_no_exchange(am, chan, name, 20) else if n < 0 then am_exchange_in_use(am, chan, name) else am_answer(am, am_exchange_delete_ok(chan))

fn am_exchange_in_use(am: Am, chan, name) =
  am_refuse(am, chan, am_precondition(), "exchange `" + name + "` still has something bound to it", a_class_exchange(), 20)

# The second bit of the flags on a declaration: whether the thing is meant to
# outlive the broker. It was read and ignored, so a client that asked for
# something temporary got something permanent — the safe direction to be wrong
# in and still the wrong answer.
fn am_durable() = 2

fn am_exchange(am: Am, name, kind, durable) =
  back = channel(1)
  send(am.reg, RExchange(name, kind, false, durable, back))
  recv(back)

fn am_answer(am: Am, bytes) =
  am_say(am, bytes)
  am

# `Queue.Declare` is how a client both makes a queue and asks how much is in
# it, so the answer needs the queue's own count.
# Arguments begin at four: the class and the method are two bytes each. Most
# of these then open with a `reserved-1` short nobody has used since 0-9, so
# the first field a client actually filled in is at six. Getting that wrong is
# quiet rather than loud — every string comes back empty and every queue is
# the one named "" — which is exactly how it went the first time.
fn am_args() = 4

fn am_after_reserved() = 6

fn am_queue_method(am: Am, chan, method, payload) =
  if method == 10 then am_declare(am, chan, a_get_shortstr(payload, am_after_reserved()), bit_and(a_get_u8(payload, a_after_shortstr(payload, am_after_reserved())), am_durable()) != 0) else if method == 20 then am_bind(am, chan, payload) else if method == 30 then am_purge(am, chan, a_get_shortstr(payload, am_after_reserved())) else if method == 40 then am_delete_queue(am, chan, a_get_shortstr(payload, am_after_reserved()), a_get_u8(payload, a_after_shortstr(payload, am_after_reserved()))) else if method == 50 then am_unbind(am, chan, payload) else am_no_method(am, chan, a_class_queue(), method)

# `Queue.Purge` throws away what is waiting and answers with how much that
# was. It is `DRAIN` on RillMQ's own protocol, and the same request underneath.
fn am_purge(am: Am, chan, queue) = match am_queue_if(am, queue)
  None -> am_no_queue(am, chan, queue, 30)
  Some(qh) -> am_purging(am, chan, qh)

fn am_purging(am: Am, chan, qh) =
  back = channel(1)
  w = am_wait(am_hand(am, qh, QDrain(back)), back)
  am_answer(w.am, am_queue_purge_ok(chan, w.got))

# `Queue.Delete` ends the queue: its strand returns, its journal stops, and
# the file goes. The `if-unused` and `if-empty` flags are read and not
# honoured — see the last section of the README.
# The bits after the name: the first says delete it only if nobody is reading
# it, the second only if nothing is in it. They were read and ignored, so a
# client that asked for a queue to go only if it was empty got it gone either
# way — the wrong answer to a question it was right to ask.
fn am_if_unused() = 1

fn am_if_empty() = 2

fn am_delete_queue(am: Am, chan, queue, bits) =
  back = channel(1)
  send(am.reg, RDropQueue(queue, bit_and(bits, am_if_unused()) != 0, bit_and(bits, am_if_empty()) != 0, back))
  am_deleted_queue(am, chan, queue, recv(back))

fn am_deleted_queue(am: Am, chan, queue, n) =
  if n == -1 then am_no_queue(am, chan, queue, 40) else if n < 0 then am_queue_in_use(am, chan, queue) else am_answer(am_forgot_queue(am, queue), am_queue_delete_ok(chan, n))

fn am_queue_in_use(am: Am, chan, queue) =
  am_refuse(am, chan, am_precondition(), "queue `" + queue + "` is in use or not empty", a_class_queue(), 40)

# Whatever this connection was reading from it is reading from nothing now,
# and it is told so here rather than waiting for the queue to say it. The
# queue does say it — that is what reaches consumers on other connections —
# but by the time that arrives this session has already forgotten the tag, and
# a cancellation naming a tag nobody remembers names nothing.
fn am_forgot_queue(am: Am, queue) = am_forget_all_on(am, map_keys(am.consumers), queue)

fn am_forget_all_on(am: Am, tags, queue) = match tags
  Nil -> am
  Cons(t, rest) -> am_forget_all_on(if str_cmp(map_or(am.consumers, t, ""), queue) == 0 then am_cancelled_here(am, t, map_or(am.where, t, 1)) else am, rest, queue)

# `Queue.Unbind` is the same three names as `Queue.Bind`, undone. The exchange
# already understood it — a replayed journal has always been able to ask —
# and nothing over AMQP could until now.
fn am_unbind(am: Am, chan, payload) =
  at1 = a_after_shortstr(payload, am_after_reserved())
  at2 = a_after_shortstr(payload, at1)
  queue = a_get_shortstr(payload, am_after_reserved())
  ex = a_get_shortstr(payload, at1)
  key = a_get_shortstr(payload, at2)
  am_unbind_from(am, chan, queue, key, am_exchange_if(am, ex), ex)

fn am_unbind_from(am: Am, chan, queue, key, found, ex) = match found
  None -> am_no_exchange(am, chan, ex, 50)
  Some(x) -> am_unbinding(am, chan, queue, key, x)

fn am_unbinding(am: Am, chan, queue, key, x) =
  back = channel(1)
  sent = am_hand(am, x, XUnbind(queue, key, back))
  am_answer(am_wait(sent, back).am, am_queue_unbind_ok(chan))

# `Queue.Bind` is queue, exchange, routing key, in that order after the
# reserved short. The queue is made if it is not there, because binding a queue
# that does not exist is a way of making it.
fn am_bind(am: Am, chan, payload) =
  at1 = a_after_shortstr(payload, am_after_reserved())
  at2 = a_after_shortstr(payload, at1)
  queue = a_get_shortstr(payload, am_after_reserved())
  ex = a_get_shortstr(payload, at1)
  key = a_get_shortstr(payload, at2)
  am_bind_to(am, chan, queue, am_bind_on(am, ex, key, payload, at2), am_exchange_if(am, ex), ex)

# What a binding is on. A `headers` binding is not on a key at all but on the
# arguments after it — `x-match` and the pairs a message has to have — and
# they become the same canonical line the message's own headers become, so
# that binding and message meet as two strings.
#
# The arguments are one byte past the routing key and the no-wait bit.
fn am_bind_on(am: Am, exchange, key, payload, at2) =
  if str_cmp(am_kind_of(am, exchange), x_headers()) != 0 then key else a_table_text(payload, a_after_shortstr(payload, at2) + 1)

# The default exchange is not in the table and is not a thing to bind to: a
# queue is already reachable by its own name through it.
fn am_bind_to(am: Am, chan, queue, key, found, ex) = match found
  None -> if str_len(ex) == 0 then am_answer(am, am_queue_bind_ok(chan)) else am_no_exchange(am, chan, ex, 20)
  Some(x) -> am_bound(am, chan, queue, key, x)

fn am_bound(am: Am, chan, queue, key, x) =
  am_bind_from(am, chan, queue, key, x, am_queue_if(am, queue))

fn am_bind_from(am: Am, chan, queue, key, x, found) = match found
  None -> am_no_queue(am, chan, queue, 20)
  Some(qh) -> am_binding(am, chan, queue, key, x, qh)

fn am_binding(am: Am, chan, queue, key, x, qh) =
  back = channel(1)
  sent = am_hand(am, x, XBind(queue, key, qh, false, back))
  am_answer(am_wait(sent, back).am, am_queue_bind_ok(chan))

# 404, and the one refusal a client most often earns: a name it typed wrong.
# Making the exchange instead was silent and expensive to find — the messages
# went somewhere real, with nothing bound to it, and were dropped one at a time
# by a thing that looked like it was working.
fn am_not_found() = 404

fn am_no_exchange(am: Am, chan, name, method) =
  am_refuse(am, chan, am_not_found(), "no exchange `" + name + "` in vhost `/`", a_class_exchange(), method)

fn am_no_queue(am: Am, chan, name, method) =
  am_refuse(am, chan, am_not_found(), "no queue `" + name + "` in vhost `/`", a_class_queue(), method)

fn am_queue_if(am: Am, name) =
  back = channel(1)
  send(am.reg, RFindIf(name, back))
  recv(back)

# Asked once per exchange per connection and remembered, because what kind an
# exchange is cannot change: whoever names it first settles it.
fn am_kind_of(am: Am, name) =
  if map_has(am.kinds, name) then map_or(am.kinds, name, "") else am_asked_kind(am, name)

fn am_asked_kind(am: Am, name) =
  back = channel(1)
  send(am.reg, RKindOf(name, back))
  kind = recv(back)
  am.kinds[name] = kind
  kind

fn am_exchange_if(am: Am, name) =
  back = channel(1)
  send(am.reg, RExchangeIf(name, back))
  recv(back)

fn am_named_exchange(am: Am, name) =
  back = channel(1)
  send(am.reg, RExchange(name, x_direct(), false, true, back))
  recv(back)

fn am_declare(am: Am, chan, name, durable) =
  back = channel(1)
  am_declared(am_wait_stat(am_hand(am, am_queue_kind(am, name, durable), QStat(back)), back), chan, name)

# A declaration is the one place a client says how long it wants the queue for.
# Everywhere else a queue is named — this broker's own protocol, a replayed
# journal, a cluster — means one that is meant to last.
fn am_queue_kind(am: Am, name, durable) =
  back = channel(1)
  send(am.reg, RFindKind(name, durable, back))
  recv(back)

fn am_declared(w: AStat, chan, name) =
  am_answer(w.am, am_queue_declare_ok(chan, name, q_count_ready(w.got) + q_count_inflight(w.got), q_count_subs(w.got)))

fn am_basic(am: Am, chan, method, payload) =
  if method == 10 then am_qos(am, chan, payload) else if method == 20 then am_consume(am, chan, payload) else if method == 30 then am_cancel(am, chan, a_get_shortstr(payload, am_args())) else if method == 40 then am_publish(am, chan, payload) else if method == 70 then am_get(am, chan, payload) else if method == 80 then am_ack(am, chan, a_get_u64(payload, am_args())) else if method == 90 then am_requeue(am, chan, 90, a_get_u64(payload, am_args())) else if method == 120 then am_requeue(am, chan, 120, a_get_u64(payload, am_args())) else am_no_method(am, chan, a_class_basic(), method)

# `Basic.Publish` names a queue and says nothing about how long the message is:
# that is in the header frame behind it, and the body in the frames behind
# that. So this only remembers where it is going.
# The bit after the routing key. `mandatory` is a publisher saying it would
# rather have the message back than have it disappear, and until now this
# broker read the flag and dropped the message anyway.
fn am_mandatory() = 1

fn am_publish(am: Am, chan, payload) =
  at = a_after_shortstr(payload, am_after_reserved())
  Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, a_get_shortstr(payload, am_after_reserved()), a_get_shortstr(payload, at), chan, bit_and(a_get_u8(payload, a_after_shortstr(payload, at)), am_mandatory()) != 0, 0, "", "", am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked, am.told, am.quick)

# The properties are taken as they are, from where they start to the end of
# the header. Nothing here reads them: a `reply-to` or a `correlation-id` means
# something to the two ends of a conversation and nothing to the broker between
# them, so the bytes are kept and handed back rather than understood.
fn am_props_at() = 12

fn am_header(am: Am, payload) =
  want = a_get_u64(payload, 4)
  props = if str_len(payload) > am_props_at() then payload[am_props_at():] else ""
  am_header_seen(am, want, props)

fn am_header_seen(am: Am, want, props) =
  if str_len(am.pub_to) == 0 then am else if want == 0 then am_deposit(am_with_props(am, props), "") else Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, am.pub_x, am.pub_to, am.pub_chan, am.pub_back, want, "", props, am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked, am.told, am.quick)

fn am_with_props(am: Am, props) =
  Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, am.pub_x, am.pub_to, am.pub_chan, am.pub_back, am.pub_want, am.pub_body, props, am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked, am.told, am.quick)

fn am_body(am: Am, chan, payload) =
  whole = am.pub_body + payload
  if str_len(whole) < am.pub_want then Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, am.pub_x, am.pub_to, am.pub_chan, am.pub_back, am.pub_want, whole, am.pub_props, am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked, am.told, am.quick) else am_deposit(am, whole)

# The queue is handed this connection's own channel either way. What changes
# with confirms on is what the session does when the answer comes back: it
# turns into a `Basic.Ack` carrying the number the client published under.
# Without them the answer is read and dropped, which is what having no reply
# means on this protocol.
# The default exchange goes straight to the queue the routing key names, which
# is what it means and is the path most messages take. A named exchange is a
# strand that decides, so the message goes there instead.
fn am_deposit(am: Am, body) =
  if str_len(am.pub_x) == 0 then am_deposit_direct(am, body, am_queue_if(am, am.pub_to)) else am_deposit_at(am, body, am_exchange_if(am, am.pub_x))

# The default exchange routes to the queue its key names, and a key naming no
# queue routes nowhere. That is not an error and AMQP does not make it one:
# the message is dropped, exactly as RabbitMQ drops it, and a publisher that
# wants to hear about it asks with `mandatory` — which this does not answer
# yet. Making the queue instead was the third place a typo went quiet.
fn am_deposit_direct(am: Am, body, found) = match found
  None -> am_deposited(am_confirm(am_dropped_here(am, body)))
  Some(qh) -> am_deposited(am_hand(am, qh, QPub(body, am.pub_props, am.out)))

fn am_deposit_at(am: Am, body, found) = match found
  # Nothing is counted for a publish that did not happen: the confirm numbers
  # and the acknowledgement numbers have to keep step, and this channel is
  # about to be closed anyway.
  None -> am_done_with_publish(am_no_exchange(am, am.pub_chan, am.pub_x, 40))
  Some(x) -> am_deposited(am_hand(am, x, XPub(am_route_by(am, am.pub_x, am.pub_to, am.pub_props), body, am.pub_props, am.out, if am.pub_back then am.pub_chan else 0)))

# What this message is routed on. For every kind but one it is the routing key
# the client sent; for `headers` it is the message's own headers, read into the
# one canonical line the exchange compares. Nothing else in the broker knows
# the difference — the exchange matches two strings, and the journal and the
# cluster carry one.
fn am_route_by(am: Am, exchange, key, props) =
  if str_cmp(am_kind_of(am, exchange), x_headers()) != 0 then key else a_headers_text(props)

fn am_done_with_publish(am: Am) =
  Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, "", "", 0, false, 0, "", "", am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked, am.told, am.quick)

# How many publishes between one look at how big this process has got. The
# queue asks the same question on the same clock; this is the other half of
# the answer, told to whoever is filling it rather than to whoever asks next.
fn am_look_every() = 256

fn am_watch_room(am: Am) =
  if !am.wants_blocked then am else if am.looked > 0 then am_counted_down(am) else am_looked(am, rss_bytes() > q_max_bytes())

fn am_counted_down(am: Am) =
  Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, am.pub_x, am.pub_to, am.pub_chan, am.pub_back, am.pub_want, am.pub_body, am.pub_props, am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked - 1, am.seq, am.acked, am.told, am.quick)

# Said once when it becomes true and once when it stops being, because a
# publisher that is told to pause every two hundred and fifty-sixth message is
# not being told anything.
fn am_looked(am: Am, full) =
  if full == am.blocked then am_said_nothing(am, full) else am_say_room(am, full)

fn am_said_nothing(am: Am, full) =
  Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, am.pub_x, am.pub_to, am.pub_chan, am.pub_back, am.pub_want, am.pub_body, am.pub_props, am.confirms, am.on_chan, am.wants_blocked, full, am_look_every(), am.seq, am.acked, am.told, am.quick)

fn am_say_room(am: Am, full) =
  am_say(am, if full then am_connection_blocked("low on memory") else am_connection_unblocked())
  am_said_nothing(am, full)

fn am_deposited(am: Am) = am_watch_room(am_took_it(am))

fn am_took_it(am: Am) =
  Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, "", "", 0, false, 0, "", "", am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, if am.confirms then am.seq + 1 else am.seq, am.acked, am.told, am.quick)

# `Basic.Qos` is a size nobody implements, then a count, then a bit saying
# whether it is for the channel or for the connection. The count is the one
# that matters and it is kept per channel, which is where a client puts it:
# `BasicQos(0, 1, false)` before consuming is how fair dispatch is asked for,
# and answering `Qos-Ok` and then handing out sixty-four anyway is not fair
# dispatch. It was answered and forgotten until now.
fn am_qos(am: Am, chan, payload) =
  am.qos[chan] = a_get_u16(payload, am_args() + 4)
  am_answer(am, am_basic_qos_ok(chan))

# What a consumer made on this channel may hold: what the channel asked for, or
# the broker's own default for a client that never asked.
fn am_window(am: Am, chan) = if map_has(am.qos, chan) then map_or(am.qos, chan, 0) else q_prefetch()

# `Basic.Consume` is the queue, then the consumer's own name for itself, then
# a byte of flags. The second bit of that byte is `no-ack`: the client saying
# it will not answer for what it is given, and would rather lose a message
# than wait to say so. Ignoring it was a consumer that got one prefetch window
# and then nothing, because the broker was waiting for answers that were never
# coming.
fn am_no_ack() = 2

fn am_consume(am: Am, chan, payload) =
  at = a_after_shortstr(payload, am_after_reserved())
  queue = a_get_shortstr(payload, am_after_reserved())
  given = a_get_shortstr(payload, at)
  bits = a_get_u8(payload, a_after_shortstr(payload, at))
  tag = if str_len(given) > 0 then given else "ctag-" + int_to_str(am.cid) + "-" + int_to_str(am.tag)
  back = channel(1)
  quick = bit_and(bits, am_no_ack()) != 0
  if map_has(am.consumers, tag) then am_taken_tag(am, chan, tag) else am_consume_from(am, chan, queue, tag, quick, back, am_queue_if(am, queue))

fn am_consume_from(am: Am, chan, queue, tag, quick, back, found) = match found
  None -> am_no_queue(am, chan, queue, 20)
  Some(qh) -> am_consume_as(am, chan, queue, tag, quick, back, qh)

fn am_taken_tag(am: Am, chan, tag) =
  am_refuse(am, chan, am_precondition(), "consumer tag `" + tag + "` is already in use", a_class_basic(), 20)

fn am_consume_as(am: Am, chan, queue, tag, quick, back, qh) =
  sent = am_hand(am, qh, QSub(Sub(am_sub_id(am.cid, chan), am.out, quick, am_window(am, chan)), back))
  am_consuming(am_wait(sent, back).am, chan, queue, tag, quick)

fn am_consuming(am: Am, chan, queue, tag, quick) =
  am.consumers[tag] = queue
  am.where[tag] = chan
  am.serving[am_sub_id(am.cid, chan)] = tag
  am_answer(Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, if am_has(am.subs, queue) then am.subs else Cons(queue, am.subs), am.pub_x, am.pub_to, am.pub_chan, am.pub_back, am.pub_want, am.pub_body, am.pub_props, am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked, am.told, am.quick || quick), am_basic_consume_ok(chan, tag))

fn am_has(names, name) = match names
  Nil -> false
  Cons(n, rest) -> str_cmp(n, name) == 0 || am_has(rest, name)

fn am_cancel(am: Am, chan, tag) = am_answer(am_forget(am, tag), am_basic_cancel_ok(chan, tag))

fn am_ack(am: Am, chan, tag) = match am.whose[tag]
  None -> am_unknown_tag(am, chan, 80)
  Some(queue) -> am_tell(am, queue, tag, true)

fn am_requeue(am: Am, chan, method, tag) = match am.whose[tag]
  None -> am_unknown_tag(am, chan, method)
  Some(queue) -> am_tell(am, queue, tag, false)

fn am_unknown_tag(am: Am, chan, method) =
  am_refuse(am, chan, am_precondition(), "unknown delivery tag", a_class_basic(), method)

fn am_tell(am: Am, queue, tag, yes) =
  back = channel(1)
  sent = am_hand(am, am_queue(am, queue), if yes then QAck(map_or(am.which, tag, 0), back) else QNack(map_or(am.which, tag, 0), back))
  am_told(am_wait(sent, back).am, tag)

fn am_told(am: Am, tag) =
  map_del(am.whose, tag)
  map_del(am.which, tag)
  am

# A message the queue handed over. The tag counting deliveries on this
# connection is minted here, and what it stands for is remembered until the
# client says it is done with it.
# The consumer is told and then forgotten, in that order: after this the tag
# means nothing, so the frame that names it has to go first.
fn am_tell_cancelled(am: Am, sub) = am_cancel_tag(am, map_or(am.serving, sub, ""))

fn am_cancel_tag(am: Am, tag) =
  if str_len(tag) == 0 then am else am_cancelled_here(am, tag, map_or(am.where, tag, 1))

fn am_cancelled_here(am: Am, tag, chan) =
  am_say(am, am_basic_cancel(chan, tag))
  am_dropped(am, tag)

fn am_send_delivery(am: Am, queue, id, body, props, sub) =
  am.whose[am.tag] = queue
  am.which[am.tag] = id
  am_deliver_on(am, queue, body, props, map_or(am.serving, sub, ""))
  Am(am.fd, am.ssl, am.reg, am.done, am.cid, am.out, am.tag + 1, am.whose, am.which, am.consumers, am.where, am.qos, am.serving, am.closing, am.kinds, am.subs, am.pub_x, am.pub_to, am.pub_chan, am.pub_back, am.pub_want, am.pub_body, am.pub_props, am.confirms, am.on_chan, am.wants_blocked, am.blocked, am.looked, am.seq, am.acked, am.told, am.quick)

fn am_deliver_on(am: Am, queue, body, props, tag) =
  am_say(am, am_deliver(map_or(am.where, tag, 1), am.tag, tag, queue, body, props))
  0

# `Basic.Get` takes one without subscribing. It is a poll, so it subscribes,
# waits a moment for something to arrive, and unsubscribes again.
fn am_get(am: Am, chan, payload) =
  am_get_from(am, chan, a_get_shortstr(payload, am_after_reserved()))

fn am_get_from(am: Am, chan, queue) = match am_queue_if(am, queue)
  None -> am_no_queue(am, chan, queue, 70)
  Some(qh) -> am_getting_from(am, chan, queue, qh)

fn am_getting_from(am: Am, chan, queue, qh) =
  one = channel(1)
  back = channel(1)
  sent = am_hand(am, qh, QSub(Sub(am_get_id(am.cid), one, false, 1), back))
  am_getting(am_wait(sent, back).am, chan, queue, one)

fn am_getting(am: Am, chan, queue, one) =
  am_after_get(am_wait_one(am, one, am_get_ms()), chan, queue)

fn am_get_ms() = 200

fn am_after_get(w: AKept, chan, queue) =
  back = channel(1)
  sent = am_hand(w.am, am_queue(w.am, queue), QUnsub(am_get_id(w.am.cid), back))
  am_ungot(am_wait(sent, back).am, chan, queue, w.got)

fn am_ungot(am: Am, chan, queue, got) = match got
  None -> am_answer(am, am_basic_get_empty(chan))
  Some(what) -> am_one(am, chan, queue, what)

fn am_one(am: Am, chan, queue, what) = match what
  OFrame(text) -> am_answer(am, am_basic_get_empty(chan))
  OPublished(q, id) -> am_answer(am, am_basic_get_empty(chan))
  ONoRoute(exchange, key, body, props, on) -> am_answer(am, am_basic_get_empty(chan))
  OCancelled(queue, sub) -> am_answer(am, am_basic_get_empty(chan))
  ODeliver(q, id, body, props, sub) ->
    back = channel(1)
    sent = am_hand(am, am_queue(am, queue), QAck(id, back))
    am_answer(am_wait(sent, back).am, am_get_ok(chan, am.tag, queue, 0, body, props))
