# The wire RillMQ speaks.
#
# Text lines with a length-prefixed body, which is the shape Redis and the
# early AMQP drafts both settled on and for the same two reasons: a person can
# read a session with `nc` and a parser never has to look inside the payload
# for where it stops. A body is bytes, and a Rill string is a byte string, so
# nothing here cares what is in one.
#
#   PUB <queue> <len>\r\n<body>     ->  +OK <id>
#   SUB <queue>                     ->  +OK
#   UNSUB <queue>                   ->  +OK
#   ACK <queue> <id>                ->  +OK
#   NACK <queue> <id>               ->  +OK
#   XDECL <exchange> <kind>         ->  +OK      direct, fanout or topic
#   BIND <exchange> <queue> <key>   ->  +OK
#   XPUB <exchange> <key> <len>\r\n<body>  ->  +OK
#   STATS                           ->  +STATS <queues> <ready> <inflight>
#   QSTAT <queue>                   ->  +QSTAT <ready> <inflight> <subs> <published>
#   REPL <queue> <len>\r\n<records> ->  +OK      one node's journal, to its copy
#   PROMOTE <queue>                 ->  +OK      serve the copy you have been keeping
#   QUEUES                          ->  +QUEUES <n>, then n rows of
#                                       Q <name> <ready> <inflight> <subs> <published>
#   PING                            ->  +PONG
#   QUIT                            ->  closes
#
# and, pushed to a subscriber whenever the broker has something for it:
#
#   MSG <id> <queue> <len>\r\n<body>
#
# Anything the broker will not do answers `-ERR <what>`.

import "opts"

# What a client asked for, once a whole command has arrived.
type Cmd
  CPub(queue: Str, body: Str)
  CSub(queue: Str)
  CUnsub(queue: Str)
  CAck(queue: Str, id: Int)
  CNack(queue: Str, id: Int)
  CStats
  CQueues
  CQStat(queue: Str)
  CRepl(queue: Str, term: Int, bytes: Str)
  CVote(queue: Str, term: Int, size: Int, node: Int)
  CWho(queue: Str)
  # `TAIL <queue> <from>` is a node that has fallen behind asking a node that
  # has not for the part of a queue's journal it is missing. A journal is only
  # ever appended to, so everything past an offset is exactly what the asker
  # does not have.
  CTail(queue: Str, from: Int)
  # `SIZE <queue>` asks how much of a queue's journal a node has. It changes
  # nothing and decides nothing: it is what a node asks before standing, to
  # find out whether it is the one that is behind.
  CSize(queue: Str)
  CPromote(queue: Str)
  CXDecl(exchange: Str, kind: Str)
  CBind(exchange: Str, queue: Str, key: Str)
  CXPub(exchange: Str, key: Str, body: Str)
  CPing
  CDrain(queue: Str)
  CAuth(name: Str, word: Str)
  CQuit

# Taking a command out of what has been read, starting at `from`.
#
# An offset rather than a fresh string, because slicing the front off after
# every command is what makes a pipelined publisher quadratic: a read brings
# sixty-four kilobytes and eight hundred commands, and slicing per command
# copies the whole remainder eight hundred times. `str_find_from` exists in the
# language for exactly this, and `Got` answers with where the next one starts.
#
# `Need` is not an error. It is the ordinary answer while the rest of a frame
# is still on its way, and the caller reads more and asks again.
# `Bad` carries what is left as well, because an unknown command is not a
# reason to hang up on somebody: the line has been consumed, the next one is
# still there, and only a frame whose end cannot be found at all — a line with
# no end in sight — takes the connection down with it.
type Taken
  Got(cmd: Cmd, next: Int)
  Need
  Bad(why: Str, next: Int, fatal: Bool)

fn crlf() = "\r\n"

# -- reading ------------------------------------------------------------------

fn w_take(buf, from) =
  at = str_find_from(buf, crlf(), from)
  if at < 0 then if str_len(buf) - from > w_most_line() then Bad("line too long", 0, true) else Need else w_take_line(buf, buf[from:at], at + 2)

fn w_most_line() = 8192

fn w_most_body() = 1048576

fn w_take_line(buf, line, rest) =
  parts = split(line, " ")
  verb = upper(unwrap_or(nth(parts, 0), ""))
  if str_cmp(verb, "PUB") == 0 then w_take_pub(buf, parts, rest) else if str_cmp(verb, "SUB") == 0 then w_sub(parts, rest) else if str_cmp(verb, "UNSUB") == 0 then w_unsub(parts, rest) else if str_cmp(verb, "ACK") == 0 then w_ack(parts, rest) else if str_cmp(verb, "NACK") == 0 then w_nack(parts, rest) else if str_cmp(verb, "STATS") == 0 then Got(CStats, rest) else if str_cmp(verb, "QUEUES") == 0 then Got(CQueues, rest) else if str_cmp(verb, "QSTAT") == 0 then w_qstat(parts, rest) else if str_cmp(verb, "REPL") == 0 then w_take_repl(buf, parts, rest) else if str_cmp(verb, "VOTE") == 0 then w_vote(parts, rest) else if str_cmp(verb, "WHO") == 0 then w_who(parts, rest) else if str_cmp(verb, "TAIL") == 0 then w_tail(parts, rest) else if str_cmp(verb, "SIZE") == 0 then w_size(parts, rest) else if str_cmp(verb, "PROMOTE") == 0 then w_promote(parts, rest) else if str_cmp(verb, "XDECL") == 0 then w_xdecl(parts, rest) else if str_cmp(verb, "BIND") == 0 then w_bind(parts, rest) else if str_cmp(verb, "XPUB") == 0 then w_take_xpub(buf, parts, rest) else if str_cmp(verb, "DRAIN") == 0 then w_drain(parts, rest) else if str_cmp(verb, "AUTH") == 0 then w_auth(parts, rest) else if str_cmp(verb, "PING") == 0 then Got(CPing, rest) else if str_cmp(verb, "QUIT") == 0 then Got(CQuit, rest) else if str_len(verb) == 0 then Need else Bad("unknown command `" + verb + "`", rest, false)

# A constructor is not a value in Rill, so the four commands that differ only
# in which one they build are written out rather than handed a maker.
fn w_sub(parts, rest) =
  name = w_name(parts)
  if str_len(name) == 0 then Bad("a queue name is wanted", rest, false) else Got(CSub(name), rest)

fn w_unsub(parts, rest) =
  name = w_name(parts)
  if str_len(name) == 0 then Bad("a queue name is wanted", rest, false) else Got(CUnsub(name), rest)

# An acknowledgement names the queue as well as the message, because a message
# id is the queue's own count and two queues hand out the same numbers. The
# client has the name already: it came with the message.
fn w_ack(parts, rest) =
  name = w_name(parts)
  raw = w_second(parts)
  if str_len(name) == 0 || str_len(raw) == 0 then Bad("a queue and a message id are wanted", rest, false) else Got(CAck(name, str_to_int(raw)), rest)

fn w_nack(parts, rest) =
  name = w_name(parts)
  raw = w_second(parts)
  if str_len(name) == 0 || str_len(raw) == 0 then Bad("a queue and a message id are wanted", rest, false) else Got(CNack(name, str_to_int(raw)), rest)

# `XDECL <exchange> <kind>` makes one; `BIND <exchange> <queue> <key>` ties a
# queue to it; `XPUB <exchange> <key> <len>` publishes through it. The same
# three things AMQP calls `Exchange.Declare`, `Queue.Bind` and a `Basic.Publish`
# that names an exchange.
# One queue's numbers rather than every queue's. `QUEUES` is for a person
# looking; this is for a program that already knows which queue it means, and
# it is what one node asks another about a queue it does not hold.
fn w_qstat(parts, rest) =
  name = w_name(parts)
  if str_len(name) == 0 then Bad("a queue name is wanted", rest, false) else Got(CQStat(name), rest)

# `REPL <queue> <len>` is one node handing another the journal records it has
# just written, exactly as it wrote them — the same bytes, the same checksums.
# The far end appends them to the file that queue would have if it were the
# one holding it, which is what makes promoting a copy nothing more than
# starting a queue from a journal that is already there.
# `PROMOTE <queue>` tells a node to start serving a queue it has only been
# keeping a copy of. It is the mechanism failing over is made of, and it is
# also the thing to reach for when a node is not coming back and somebody has
# decided so.
fn w_promote(parts, rest) =
  name = w_name(parts)
  if str_len(name) == 0 then Bad("a queue name is wanted", rest, false) else Got(CPromote(name), rest)

fn w_take_repl(buf, parts, at) =
  queue = w_name(parts)
  len = str_to_int(unwrap_or(nth(parts, 3), "-1"))
  if str_len(queue) == 0 || len < 0 then Bad("a queue, a term and a length are wanted", at, false) else if len > w_most_body() then Bad("batch too long", 0, true) else if str_len(buf) - at < len then Need else Got(CRepl(queue, str_to_int(w_second(parts)), buf[at:at + len]), at + len)

# `VOTE <queue> <term> <size> <node>` is one node asking to lead a queue: which
# turn it means, how much of that queue's journal it has, and which node it is
# — the last so that whoever votes knows who to point at afterwards. A vote is given when
# the turn is later than any this node knows of and the asker's journal is at
# least as long as its own. That second half is what keeps a node that has
# fallen behind from being made leader of what it does not have.
fn w_vote(parts, rest) =
  queue = w_name(parts)
  if str_len(queue) == 0 then Bad("a queue, a term and a size are wanted", rest, false) else Got(CVote(queue, str_to_int(w_second(parts)), str_to_int(unwrap_or(nth(parts, 3), "0")), str_to_int(unwrap_or(nth(parts, 4), "-1"))), rest)

# `WHO <queue>` asks a node who it believes leads a queue, so that a node whose
# proxy has failed can look for a new leader before deciding there is not one.
fn w_who(parts, rest) =
  queue = w_name(parts)
  if str_len(queue) == 0 then Bad("a queue name is wanted", rest, false) else Got(CWho(queue), rest)

fn w_tail(parts, rest) =
  queue = w_name(parts)
  from = str_to_int(unwrap_or(nth(parts, 2), "-1"))
  if str_len(queue) == 0 || from < 0 then Bad("a queue and an offset are wanted", rest, false) else Got(CTail(queue, from), rest)

fn w_tail_line(n) = "+TAIL " + int_to_str(n) + crlf()

fn w_size(parts, rest) =
  queue = w_name(parts)
  if str_len(queue) == 0 then Bad("a queue name is wanted", rest, false) else Got(CSize(queue), rest)

fn w_size_line(n) = "+SIZE " + int_to_str(n) + crlf()

fn w_vote_yes() = "+VOTE" + crlf()

fn w_vote_no(term) = "-VOTE " + int_to_str(term) + crlf()

fn w_who_line(node) = "+WHO " + int_to_str(node) + crlf()

fn w_stale() = "-STALE" + crlf()

# Four numbers became seven, and the three new ones are on the end so that a
# client reading the first four goes on working. `delivered` and `acked` only
# go up, which is what a rate is made from; `oldest` is how long the message at
# the front has been waiting, in milliseconds, or zero for an empty queue.
fn w_qstat_line(ready, inflight, subs, published, delivered, acked, oldest) =
  "+QSTAT " + int_to_str(ready) + " " + int_to_str(inflight) + " " + int_to_str(subs) + " " + int_to_str(published) + " " + int_to_str(delivered) + " " + int_to_str(acked) + " " + int_to_str(oldest) + crlf()

fn w_xdecl(parts, rest) =
  ex = w_name(parts)
  kind = w_second(parts)
  if str_len(ex) == 0 || str_len(kind) == 0 then Bad("an exchange and a kind are wanted", rest, false) else Got(CXDecl(ex, kind), rest)

fn w_bind(parts, rest) =
  ex = w_name(parts)
  queue = w_second(parts)
  key = unwrap_or(nth(parts, 3), "")
  if str_len(ex) == 0 || str_len(queue) == 0 then Bad("an exchange, a queue and a key are wanted", rest, false) else Got(CBind(ex, queue, key), rest)

fn w_take_xpub(buf, parts, at) =
  ex = w_name(parts)
  key = w_second(parts)
  len = str_to_int(unwrap_or(nth(parts, 3), "-1"))
  if str_len(ex) == 0 then Bad("an exchange is wanted", at, false) else if len < 0 then Bad("a body length is wanted", at, false) else if len > w_most_body() then Bad("body too long", 0, true) else if str_len(buf) - at < len then Need else Got(CXPub(ex, key, buf[at:at + len]), at + len)

# `DRAIN queue` throws away everything waiting in it and answers with how
# much that was. What is in flight is left alone.
fn w_drain(parts, rest) =
  name = w_name(parts)
  if str_len(name) == 0 then Bad("a queue name is wanted", rest, false) else Got(CDrain(name), rest)

fn w_drained(n) = "+DRAIN " + int_to_str(n) + crlf()

# `AUTH name word`. The word is the rest of the line rather than one field, so
# that a word with a space in it is a word with a space in it.
fn w_auth(parts, rest) =
  name = w_name(parts)
  if str_len(name) == 0 then Bad("a name is wanted", rest, false) else Got(CAuth(name, w_second(parts)), rest)

fn w_name(parts) = unwrap_or(nth(parts, 1), "")

fn w_second(parts) = unwrap_or(nth(parts, 2), "")

# `PUB` is the one command with a body after its line, so it is the one that
# can be half here. Saying `Need` and being asked again is the whole of how
# that is handled — the line stays in the buffer and is parsed twice, which
# costs a `split` and saves the state machine that would avoid it.
fn w_take_pub(buf, parts, at) =
  queue = unwrap_or(nth(parts, 1), "")
  len = str_to_int(unwrap_or(nth(parts, 2), "-1"))
  if str_len(queue) == 0 then Bad("a queue name is wanted", at, false) else if len < 0 then Bad("a body length is wanted", at, false) else if len > w_most_body() then Bad("body too long", 0, true) else if str_len(buf) - at < len then Need else Got(CPub(queue, buf[at:at + len]), at + len)

fn upper(s) =
  b = strbuf()
  upper_into(b, s, 0)

fn upper_into(b: StrBuf, s, i) =
  if i >= str_len(s) then strbuf_str(b)
  else
    c = str_get(s, i)
    b += if c >= 97 && c <= 122 then c - 32 else c
    upper_into(b, s, i + 1)

# -- writing ------------------------------------------------------------------

fn w_ok() = "+OK" + crlf()

fn w_ok_id(id) = "+OK " + int_to_str(id) + crlf()

fn w_pong() = "+PONG" + crlf()

fn w_err(why) = "-ERR " + why + crlf()

# One line saying how many rows follow, then that many rows. A count in front
# is what lets a client read the answer without having to guess where it ends.
fn w_queues_head(n) = "+QUEUES " + int_to_str(n) + crlf()

fn w_queue_row(name, ready, inflight, subs, published) =
  "Q " + name + " " + int_to_str(ready) + " " + int_to_str(inflight) + " " + int_to_str(subs) + " " + int_to_str(published) + crlf()

# A queue that did not answer in time. Not an error and not a hang: the queue
# is busy, and saying so is better than making everybody wait for it.
fn w_queue_busy(name) = "Q " + name + " ? ? ? ?" + crlf()

fn w_stats(queues, ready, inflight) =
  "+STATS " + int_to_str(queues) + " " + int_to_str(ready) + " " + int_to_str(inflight) + crlf()

fn w_msg(id, queue, body) =
  b = strbuf()
  b += "MSG "
  b += int_to_str(id)
  b += " "
  b += queue
  b += " "
  b += int_to_str(str_len(body))
  b += crlf()
  b += body
  strbuf_str(b)
