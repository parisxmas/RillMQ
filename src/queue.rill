# A queue is a strand, and the only strand that ever touches its messages.
#
# That is the whole of the concurrency design. There is no lock in RillMQ and
# nothing is shared: a connection that wants to publish sends a request down
# the queue's channel and waits for the answer on a channel it made for that
# purpose. Rill's maps and buffers are storage rather than values and are
# explicitly one strand's at a time on a `--parallel` build, so this is not
# only the tidy way to write it, it is the only way that stays correct when
# the program is given more than one worker.
import "wire"
import "journal"

type Msg
  Msg(id: Int, body: Str)

# A subscriber, named by the connection that made it. `out` is where whole
# frames go; it is buffered, and a subscriber whose buffer is full is a
# subscriber the queue will skip rather than wait for.
type Sub
  Sub(id: Int, out: Chan(Str))

# A message handed out and not yet acknowledged. `due` is when the queue gives
# up waiting and hands it to somebody else; `sub` is who is holding it, which
# is what lets the queue count how much any one consumer has outstanding.
type Flight
  Flight(msg: Msg, due: Int, sub: Int)

# `next_due` is when the loop next has to wake up for a deadline, or 0 when
# nothing is in flight. It is carried rather than worked out, because working
# it out means walking everything in flight and that walk was happening on
# every single request: at a hundred and twenty-eight messages out at once it
# was a hundred and twenty-eight map lookups and a list of that length built
# and thrown away per message, which is most of what the queue was doing.
# Carried, it can be early — an acknowledgement does not correct it — and
# early only costs a timer that fires and finds nothing, which then puts it
# right.
type Q
  Q(name: Str, ready: Map(Int, Msg), head: Int, tail: Int, subs: List(Sub), inflight: Map(Int, Flight), turn: Int, next_id: Int, next_due: Int, held: Map(Int, Int), jr: Jr)

type QCount
  QCount(ready: Int, inflight: Int)

type QReq
  QPub(body: Str, out: Chan(Str))
  QSub(sub: Sub, reply: Chan(Int))
  QUnsub(sub_id: Int, reply: Chan(Int))
  QAck(id: Int, reply: Chan(Int))
  QNack(id: Int, reply: Chan(Int))
  QStat(reply: Chan(QCount))

# How long a message may be out before the queue decides the consumer is not
# coming back with an answer. Five seconds unless the second argument on the
# command line says otherwise, which is there for tests that would rather not
# take five seconds to find out that redelivery works.
fn q_ack_ms() = if arg_count() > 3 then str_to_int(arg(3)) else 5000

# How many messages one consumer may be holding unacknowledged. This is the
# thing a broker cannot be written without, and it is not obvious until it is
# measured: with no limit, a queue with fifty thousand messages in it hands
# every one of them to the first subscriber that appears. The socket fills, so
# the strand writing it parks; the channel behind that strand fills, so the
# strand *reading* the connection parks trying to put a reply in it; and the
# reply it was trying to put there was the answer to an acknowledgement. The
# consumer is then waiting for the broker to read an acknowledgement that the
# broker cannot read until the consumer reads what it has already been sent.
# Neither side is at fault and neither can move. AMQP calls the cure prefetch
# and Kafka calls it max.poll.records; it is the same limit, and it is the
# only thing standing between a broker and that deadlock.
fn q_prefetch() = if arg_count() > 4 then str_to_int(arg(4)) else 64

# What the loop waits when nothing is in flight. Not forever, because a queue
# that is idle should still notice a shutdown promptly; not short, because a
# queue that is idle should cost nothing.
fn q_idle_ms() = 30000

# The broker's own weight, and what it will not go past.
#
# A queue with nobody reading it grows until the machine has no more to give,
# and the process is killed. Nothing is lost when that happens — everything
# answered for is in a journal — but the broker is down and has to read all of
# it back, which is the worst moment for it to be doing that. So a publish is
# refused once the process is holding more than it was told it could.
#
# The measurement is the process's own resident size rather than a count of
# messages, because a count is not what runs out. It is taken every so often
# rather than every time: asking the operating system how big you are costs
# more than accepting a message does.
fn q_max_bytes() = (if arg_count() > 5 then str_to_int(arg(5)) else 1024) * 1048576

fn q_check_every() = 512

# Carried alongside the queue rather than in it: whether the broker is over
# its limit, and how long since that was last true or false for a reason.
type Guard
  Guard(full: Bool, since: Int)

fn q_look(g: Guard) =
  if g.since < q_check_every() then Guard(g.full, g.since + 1) else Guard(rss_bytes() > q_max_bytes(), 0)

fn q_new(name, jr) = Q(name, map_new(), 0, 0, Nil, map_new(), 0, 1, 0, map_new(), jr)

# What a publisher can have waiting on the disk at once. A backlog rather than
# a rendezvous because a sync takes a millisecond and a publisher should be
# able to write the next message before the last one has landed; a queue that
# fills this is publishing faster than the disk will take it, and then waiting
# is the right answer.
fn q_journal_backlog() = 4096

# -- the loop ------------------------------------------------------------------

# Starting a queue is reading whatever it already was. A directory makes it
# durable; without one the journal strand is the same shape with no file
# behind it, and the queue starts empty.
fn q_run(name, dir, inbox, done) =
  jr = Jr(channel(q_journal_backlog()), channel(1))
  if str_len(dir) == 0 then q_run_memory(name, jr, inbox, done) else q_run_durable(name, dir + "/" + j_file(name), jr, inbox, done)

fn q_run_memory(name, jr, inbox, done) =
  spawn j_run_memory(jr, done)
  q_loop(q_new(name, jr), inbox, done)

fn q_run_durable(name, path, jr, inbox, done) =
  r = j_replay(path)
  j_trim(path, r.upto)
  spawn j_run(path, jr, done)
  q_name_it(name, r, jr)
  q_loop(q_from(name, r, jr), inbox, done)

# A journal that did not already say whose it is gets told, once, at the front.
fn q_name_it(name, r: Replay, jr: Jr) =
  if str_len(r.name) > 0 then 0
  else
    send(jr.puts, JNote(j_name_record(name)))
    0

fn q_from(name, r: Replay, jr) =
  known = if str_len(r.name) == 0 then name else r.name
  q_seed(Q(known, map_new(), 0, 0, Nil, map_new(), 0, r.top + 1, 0, map_new(), jr), r.live, r.order)

fn q_seed(q: Q, live: Map(Int, Str), ids) = match ids
  Nil -> q
  Cons(id, rest) -> match live[id]
    None -> q_seed(q, live, rest)
    Some(body) ->
      q.ready[q.tail] = Msg(id, body)
      q_seed(Q(q.name, q.ready, q.head, q.tail + 1, q.subs, q.inflight, q.turn, q.next_id, q.next_due, q.held, q.jr), live, rest)

fn q_loop(q: Q, inbox, done) = q_turn(q, inbox, done, Guard(false, 0))

fn q_turn(q: Q, inbox, done, g: Guard) =
  step = select
    r = recv(inbox) -> Some(q_pump(q_handle(q, r, g.full)))
    recv(q.jr.want) -> Some(q_hand_over(q))
    recv(done) -> None
    timeout(q_wait_ms(q)) -> Some(q_pump(q_sweep(q)))
  match step
    None -> 0
    Some(next) -> q_turn(next, inbox, done, q_look(g))

# The journal has decided that most of what it is holding has been
# acknowledged, and has asked for the queue as it stands. This is the only
# thing that knows what is still live, so this is where the answer comes from:
# everything in flight, and everything ready, written out as records.
#
# It goes down the same channel as the records, behind everything this queue
# has already written and in front of everything it has not. That ordering is
# what makes the snapshot true when it is used rather than when it was taken.
fn q_hand_over(q: Q) =
  send(q.jr.puts, JRewriteReq(q_live_records(q), q.name))
  q

# In flight first, then ready in the order it will go out. A message in flight
# has already been delivered once and will be delivered again after a restart,
# which is what at-least-once has always meant; what is lost is only that it
# keeps its place relative to the ready ones, and redelivery had already given
# that up.
fn q_live_records(q: Q) =
  append(q_flight_recs(q.inflight, map_keys(q.inflight), Nil), q_ready_recs(q, q.tail - 1, Nil))

fn q_flight_recs(fl: Map(Int, Flight), ks, acc) = match ks
  Nil -> acc
  Cons(k, rest) -> match fl[k]
    None -> q_flight_recs(fl, rest, acc)
    Some(f) -> q_flight_recs(fl, rest, Cons(j_pub_record(f.msg.id, f.msg.body), acc))

fn q_ready_recs(q: Q, i, acc) =
  if i < q.head then acc else match q.ready[i]
    None -> q_ready_recs(q, i - 1, acc)
    Some(m) -> q_ready_recs(q, i - 1, Cons(j_pub_record(m.id, m.body), acc))

# The deadline the `select` above is given. With nothing in flight there is
# nothing to wake up for, and with something in flight the wait is exactly as
# long as the soonest of them has left. This is what a `timeout` arm is for:
# the same thing written with a ticker strand would be a strand and a channel
# per queue, ticking whether or not anything was waiting on it.
fn q_wait_ms(q: Q) =
  if q.next_due == 0 then q_idle_ms()
  else
    left = q.next_due - now_millis()
    if left < 1 then 1 else left

# How much this subscriber is holding.
fn q_held(q: Q, sub_id) = map_or(q.held, sub_id, 0)

fn q_hold(q: Q, sub_id, by) =
  q.held[sub_id] = q_held(q, sub_id) + by
  0

# Worked out once, when a timer has just fired and the answer has to be right
# again. Everything else carries it.
fn q_soonest(m: Map(Int, Flight), ks, best) = match ks
  Nil -> best
  Cons(k, rest) -> match m[k]
    None -> q_soonest(m, rest, best)
    Some(f) -> q_soonest(m, rest, if best == 0 || f.due < best then f.due else best)

# -- what a request does --------------------------------------------------------

fn q_handle(q: Q, r, full) = match r
  QPub(body, out) -> if full then q_refuse(q, out) else q_accept(q, body, out)
  QSub(s, reply) -> q_handle_rest(q, r)
  QUnsub(sub_id, reply) -> q_handle_rest(q, r)
  QAck(id, reply) -> q_handle_rest(q, r)
  QNack(id, reply) -> q_handle_rest(q, r)
  QStat(reply) -> q_handle_rest(q, r)

# The refusal goes down the journal's channel with everything else, so that it
# arrives in the place the client asked for it. Nothing is written.
fn q_refuse(q: Q, out) =
  send(q.jr.puts, JSay(out, w_err("broker is holding all it was told it could")))
  q

fn q_accept(q: Q, body, out) = q_handle_rest(q, QPub(body, out))

fn q_handle_rest(q: Q, r) = match r
  QPub(body, out) ->
    id = q.next_id
    # The message is ready at once, and the `+OK` is written by the journal
    # rather than from here — once the record is on the disk.
    #
    # The connection is handed straight to the journal, and that is the whole
    # of what makes a durable broker fast. Waiting here for the answer would
    # mean the strand reading the connection handled one publish per sync, and
    # a sync is a millisecond: four hundred messages a second, with a batch
    # size of one, however many the publisher sent at once. Not waiting, a
    # thousand publishes arrive while the last sync is in flight and go to the
    # disk together.
    #
    # So a consumer may see a message a moment before its publisher is told it
    # is safe. That is the right way round: the publisher has been promised
    # nothing yet, and a message delivered twice is what at-least-once means.
    q.ready[q.tail] = Msg(id, body)
    send(q.jr.puts, JPut(j_pub_record(id, body), out, w_ok_id(id)))
    Q(q.name, q.ready, q.head, q.tail + 1, q.subs, q.inflight, q.turn, id + 1, q.next_due, q.held, q.jr)
  QSub(s, reply) ->
    send(reply, 1)
    Q(q.name, q.ready, q.head, q.tail, append(q.subs, Cons(s, Nil)), q.inflight, q.turn, q.next_id, q.next_due, q.held, q.jr)
  QUnsub(sub_id, reply) ->
    send(reply, 1)
    # Whatever that subscriber was holding goes back to the front of the
    # queue at once rather than waiting out its deadline: the consumer is
    # gone, and there is nothing to wait for.
    q_requeue_all(Q(q.name, q.ready, q.head, q.tail, q_without(q.subs, sub_id), q.inflight, q.turn, q.next_id, q.next_due, q.held, q.jr))
  QAck(id, reply) ->
    had = map_has(q.inflight, id)
    send(reply, if had then 1 else 0)
    q_note_ack(q, id, had)
    q_forget(q, id)
    q_clear_due(q)
  QNack(id, reply) ->
    send(reply, if map_has(q.inflight, id) then 1 else 0)
    q_requeue(q, id)
  QStat(reply) ->
    send(reply, QCount(q.tail - q.head, #q.inflight))
    q

# An acknowledged message is gone, and the credit it was using goes back.
fn q_forget(q: Q, id) = match q.inflight[id]
  None -> 0
  Some(f) ->
    map_del(q.inflight, id)
    q_hold(q, f.sub, -1)

# An acknowledgement is written down but nothing waits for it to land. Losing
# one costs a redelivery, which at-least-once delivery already allows, and it
# can never overtake the message it acknowledges because the file is written
# in order.
fn q_note_ack(q: Q, id, had) =
  if !had then 0
  else
    send(q.jr.puts, JNote(j_ack_record(id)))
    0

fn q_without(subs, sub_id) = match subs
  Nil -> Nil
  Cons(s, rest) -> if q_sub_id(s) == sub_id then q_without(rest, sub_id) else Cons(s, q_without(rest, sub_id))

fn q_sub_id(s: Sub) = s.id

fn q_sub_out(s: Sub) = s.out

# A message coming back goes in front of everything ready, which is what
# "redelivered" has to mean: a consumer that died holding message one should
# not put it behind the thousand that arrived while it was dying.
fn q_requeue(q: Q, id) = match q.inflight[id]
  None -> q
  Some(f) ->
    map_del(q.inflight, id)
    q_hold(q, f.sub, -1)
    q.ready[q.head - 1] = f.msg
    q_clear_due(Q(q.name, q.ready, q.head - 1, q.tail, q.subs, q.inflight, q.turn, q.next_id, q.next_due, q.held, q.jr))

fn q_requeue_all(q: Q) = q_requeue_each(q, map_keys(q.inflight))

fn q_requeue_each(q: Q, ks) = match ks
  Nil -> q
  Cons(k, rest) -> q_requeue_each(q_requeue(q, k), rest)

# Anything whose deadline has passed comes back. The consumer may still be
# alive and simply slow, in which case its later `ACK` finds nothing and says
# so — at-least-once delivery, which is the only kind a broker can promise
# without the consumer telling it more than it knows.
# Only ever reached from the timer, so the walk it does is the one walk the
# design allows itself.
fn q_sweep(q: Q) = q_after_sweep(q_sweep_each(q, map_keys(q.inflight), now_millis()))

fn q_after_sweep(q: Q) =
  Q(q.name, q.ready, q.head, q.tail, q.subs, q.inflight, q.turn, q.next_id, q_soonest(q.inflight, map_keys(q.inflight), 0), q.held, q.jr)

# Nothing in flight means nothing to wake up for.
fn q_clear_due(q: Q) =
  if #q.inflight > 0 then q else Q(q.name, q.ready, q.head, q.tail, q.subs, q.inflight, q.turn, q.next_id, 0, q.held, q.jr)

fn q_sweep_each(q: Q, ks, now) = match ks
  Nil -> q
  Cons(k, rest) -> match q.inflight[k]
    None -> q_sweep_each(q, rest, now)
    Some(f) -> q_sweep_each(if f.due <= now then q_requeue(q, k) else q, rest, now)

# -- handing messages out -------------------------------------------------------

# Round-robin over the subscribers, skipping any whose buffer is full. A full
# buffer is a consumer that is behind, and waiting for it would stop the queue
# for everybody: the message simply stays ready and goes to whoever asks next.
fn q_pump(q: Q) =
  if q.head >= q.tail || len(q.subs) == 0 then q else match q.ready[q.head]
    None -> Q(q.name, q.ready, q.head + 1, q.tail, q.subs, q.inflight, q.turn, q.next_id, q.next_due, q.held, q.jr)
    Some(m) -> q_offer(q, m, 0)

fn q_offer(q: Q, m: Msg, tried) =
  if tried >= len(q.subs) then q
  else
    at = q.turn - q.turn / len(q.subs) * len(q.subs)
    match nth(q.subs, at)
      None -> q
      Some(s) ->
        moved = Q(q.name, q.ready, q.head, q.tail, q.subs, q.inflight, at + 1, q.next_id, q.next_due, q.held, q.jr)
        # Two reasons to pass a subscriber by, and they are different reasons.
        # Its window being full means it has as much as it is allowed; its
        # buffer being full means it is not keeping up with what it already
        # has. Either way the message stays ready and somebody else may take
        # it.
        if q_held(q, q_sub_id(s)) >= q_prefetch() then q_offer(moved, m, tried + 1) else if q_try_send(q_sub_out(s), w_msg(m.id, q.name, m.body)) then q_took(moved, m, q_sub_id(s)) else q_offer(moved, m, tried + 1)

fn q_try_send(out, frame) =
  ok = select
    send(out, frame) -> true
    default -> false
  ok

fn q_took(q: Q, m: Msg, sub_id) =
  due = now_millis() + q_ack_ms()
  map_del(q.ready, q.head)
  q.inflight[m.id] = Flight(m, due, sub_id)
  q_hold(q, sub_id, 1)
  q_pump(Q(q.name, q.ready, q.head + 1, q.tail, q.subs, q.inflight, q.turn, q.next_id, if q.next_due == 0 then due else q.next_due, q.held, q.jr))
