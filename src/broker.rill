# The registry, and what a connection is.
#
# Two more kinds of strand. One registry, which is the only thing that knows
# what queues exist and hands out their channels; and two per connection — a
# reader that takes commands off the socket and a writer that puts frames on
# it. Two rather than one because a subscriber is being pushed messages at the
# same time as it is sending commands, and one strand cannot be parked on a
# socket read and a channel receive at once.
#
# Only the writer writes. That is what makes the socket safe without a lock:
# it is one strand's, exactly as a queue's messages are one strand's.
import "queue"
import "exchange"
import "cluster"
import "routes"
import "auth"
import "tls"

type RReq
  RFind(name: Str, reply: Chan(Chan(QReq)))
  # The same, for a client that said whether it wants the queue to outlive the
  # broker. `RFind` means durable, because everything else that names a queue
  # — this broker's own protocol, a replayed journal, a cluster — means a
  # queue that is meant to last.
  RFindKind(name: Str, durable: Bool, reply: Chan(Chan(QReq)))
  # An exchange, made the first time it is named, like a queue. The kind is
  # settled by whoever names it first; naming it again with another kind is
  # answered with the one it already is rather than refused, which is friendlier
  # than the specification and no less safe.
  RExchange(name: Str, kind: Str, quiet: Bool, durable: Bool, fleeting: Bool, inner: Bool, reply: Chan(Chan(XReq)))
  # An exchange if there is one and nothing if there is not. `RExchange` makes
  # what it cannot find, which is right for a protocol with no declaration step
  # in it and wrong for AMQP, where a client that mistypes an exchange's name
  # should be told so rather than handed a new one.
  RExchangeIf(name: Str, reply: Chan(Option(Chan(XReq))))
  # What kind an exchange is, which only matters to a session deciding whether
  # it has to read a message's headers before handing it over.
  RKindOf(name: Str, reply: Chan(Str))
  # A queue if this node can say there is one, and nothing if it can say there
  # is not. On a broker by itself those are the only two answers. In a cluster
  # a queue somebody else holds is one this node has no way to ask about
  # without a round trip it does not owe, so it answers with the stand-in and
  # lets the owner be the one who knows.
  RFindIf(name: Str, reply: Chan(Option(Chan(QReq))))
  # Deleting one of each. The reply is how much was in it, which is what AMQP
  # answers a `Queue.Delete` with, and -1 for a name that was not there.
  RDropQueue(name: Str, if_unused: Bool, if_empty: Bool, reply: Chan(Int))
  # A connection saying what it means to do with a queue: whether it wants it
  # to itself, and whether it wants it to last no longer than its consumers.
  # The answer is whether it may have it at all, because a queue somebody else
  # has to themselves is one this connection is refused.
  RClaim(name: Str, cid: Int, only: Bool, fleeting: Bool, reply: Chan(Int))
  # A consumer has gone. A queue that was declared to last as long as its
  # consumers and has none left goes with it.
  RIdle(name: Str, reply: Chan(Int))
  # A binding has gone. An exchange declared to last as long as something is
  # bound to it, and with nothing bound to it, goes with it.
  RIdleExchange(name: Str, reply: Chan(Int))
  # A connection has gone, and every queue it had to itself goes with it,
  # whatever is in them — which is what a client asking for one to itself has
  # asked for.
  RTheirs(cid: Int, reply: Chan(Int))
  RDropExchange(name: Str, quiet: Bool, if_unused: Bool, reply: Chan(Int))
  RTotals(reply: Chan(Totals))
  RRows(reply: Chan(List(Str)))
  # The same numbers as `RRows`, as numbers rather than as the lines this
  # protocol writes. The management pages want to put them in a table and the
  # wire wants to put them on a socket, and neither should have to undo what
  # the other did.
  RTable(reply: Chan(List(QRow)))
  # The journal of a queue this node does not hold and is keeping a copy of.
  # It is the same file that queue would have here, so promoting the copy is
  # starting a queue from a journal that is already in place.
  RCopy(name: Str, reply: Chan(Jr))
  # Every queue this node is keeping a copy of. It is the only list of other
  # nodes' queues this node has, and so the only set of things it could take
  # over if one of them stopped answering.
  RCopies(reply: Chan(List(Str)))
  # Serve a queue this node has only been keeping a copy of. What was a stand-in
  # for somebody else's queue becomes the queue.
  RPromote(name: Str, reply: Chan(Int))
  # A vote asked for, and who this node believes leads a queue. Both are the
  # registry's to answer because it is the one thing that knows what this node
  # is holding and what it has already promised.
  RVote(name: Str, term: Int, size: Int, from: Int, reply: Chan(Int))
  RWho(name: Str, reply: Chan(Int))
  # The term a batch arriving from another node claims to be for.
  RTerm(name: Str, reply: Chan(Int))
  # How much of a queue's journal this node has, which is what a candidate for
  # its leadership has to say when it asks for votes.
  RSize(name: Str, reply: Chan(Int))
  # The part of a queue's journal past an offset, for a node that is behind.
  RTail(name: Str, from: Int, reply: Chan(Str))
  # The other side of that: bytes from a node that is ahead, appended to the
  # copy this node keeps. It is what a `REPL` does, asked for rather than
  # pushed.
  RCatchUp(name: Str, bytes: Str, reply: Chan(Int))

type Totals
  Totals(queues: Int, ready: Int, inflight: Int)

type QRow
  QRow(name: Str, ready: Int, inflight: Int, subs: Int, published: Int, delivered: Int, acked: Int, oldest: Int, bytes: Int)

fn qr_name(r: QRow) = r.name

fn qr_ready(r: QRow) = r.ready

fn qr_inflight(r: QRow) = r.inflight

fn qr_subs(r: QRow) = r.subs

fn qr_published(r: QRow) = r.published

fn qr_delivered(r: QRow) = r.delivered

fn qr_acked(r: QRow) = r.acked

fn qr_oldest(r: QRow) = r.oldest

# What this queue is costing on the disk. A queue held in memory only has no
# file and so no size, which is a true zero rather than a missing one.
fn qr_bytes(r: QRow) = r.bytes

fn tot_queues(t: Totals) = t.queues

fn tot_ready(t: Totals) = t.ready

fn tot_inflight(t: Totals) = t.inflight

# What the writer strand is told to do next.
type Frame
  Send(what: Out)
  Shutdown

# Everything about a connection that does not change while it is up, in one
# value. It is one record rather than five parameters because the reader is a
# loop, and a loop in Rill is a tail call: past six arguments they spill to the
# stack and the call stops being a jump, so a connection that handled enough
# commands would run out of stack. The compiler says so, by name, at the call
# it cannot promise.
type Conn
  Conn(fd: Int, reg: Chan(RReq), done: Chan(Int), cid: Int, out: Chan(Out), say: Chan(Out), gone: Chan(Int), ssl: Ptr)

# -- the registry ---------------------------------------------------------------

# A queue is made the first time it is named, by a publisher or a subscriber
# alike. There is no declare step, which is the one thing about AMQP that
# nobody has ever been glad of.
# The routing table's own journal, made once. Exchanges and bindings are few
# and change rarely, so they share one file rather than having one each.
# What the registry is, apart from its tables: where things are kept, the
# journal the routing table goes in, and a way to hand itself to a stand-in —
# which needs it, because a stand-in that finds its node gone has to ask the
# registry for a vote and may end up asking it to make the queue local.
# `auto` and `owner` are the two ways a queue can be temporary: one that goes
# when its last consumer does, and one that belongs to a single connection and
# goes when that connection does. They live here rather than in the queue
# because the queue is what gets stopped, and a thing cannot be the one that
# decides to stop itself and the one that is asked whether it should.
type Reg
  Reg(dir: Str, jr: Jr, self: Chan(RReq), auto: Map(Str, Int), owner: Map(Str, Int), xauto: Map(Str, Int))

fn r_run(dir, inbox, done) =
  jr = Jr(channel(256), channel(1))
  if str_len(dir) == 0 then spawn j_run_memory(jr, done) else spawn j_run(dir + "/" + rt_file(), jr, done)
  r_loop(map_new(), map_new(), map_new(), map_new(), map_new(), map_new(), Reg(dir, jr, inbox, map_new(), map_new(), map_new()), inbox, done)

fn r_loop(qs: Map(Str, Chan(QReq)), xs: Map(Str, Chan(XReq)), cs: Map(Str, Jr), mine: Map(Str, Int), ts: Map(Str, Int), ld: Map(Str, Int), g: Reg, inbox, done) =
  step = select
    r = recv(inbox) -> Some(r_handle(qs, xs, cs, mine, ts, ld, g, r, done))
    recv(g.jr.want) -> Some(r_hand_over(xs, g))
    recv(done) -> None
  match step
    None -> 0
    Some(_) -> r_loop(qs, xs, cs, mine, ts, ld, g, inbox, done)

# The routing journal has decided that most of what it holds has been undone,
# and asks for the table as it stands. A queue answers the same question about
# its messages; this is the same mechanism with the same shape, and until the
# registry listened for it the journal asked and asked and nobody replied — so
# a table that changed often grew a file that nothing ever shortened.
#
# Only the exchanges know their own bindings, so this asks each of them.
fn r_hand_over(xs: Map(Str, Chan(XReq)), g: Reg) =
  send(g.jr.puts, JRewriteReq(r_all_records(xs, map_keys(xs), Nil), rt_file()))
  0

fn r_all_records(xs: Map(Str, Chan(XReq)), ks, acc) = match ks
  Nil -> acc
  Cons(k, rest) -> match xs[k]
    None -> r_all_records(xs, rest, acc)
    Some(ch) -> r_all_records(xs, rest, append(acc, r_records_of(ch)))

fn r_records_of(ch) =
  back = channel(1)
  send(ch, XRecords(back))
  recv(back)

fn r_handle(qs: Map(Str, Chan(QReq)), xs: Map(Str, Chan(XReq)), cs: Map(Str, Jr), mine: Map(Str, Int), ts: Map(Str, Int), ld: Map(Str, Int), g: Reg, r, done) = match r
  RFind(name, reply) ->
    send(reply, r_queue(qs, mine, g.dir, g.self, name, done))
    0
  RFindKind(name, durable, reply) ->
    send(reply, r_queue(qs, mine, if durable then g.dir else "", g.self, name, done))
    0
  RExchange(name, kind, quiet, durable, fleeting, inner, reply) ->
    r_mark_x(g, name, fleeting)
    send(reply, r_exchange(xs, Cons(g.jr, Nil), name, kind, quiet, durable, inner, done))
    0
  RFindIf(name, reply) ->
    send(reply, r_known(qs, mine, g.dir, g.self, name, done))
    0
  RDropQueue(name, if_unused, if_empty, reply) ->
    send(reply, r_drop_queue(qs, mine, g.dir, name, if_unused, if_empty))
    0
  RClaim(name, cid, only, fleeting, reply) ->
    send(reply, r_claim(g, name, cid, only, fleeting))
    0
  RIdle(name, reply) ->
    send(reply, r_idle(qs, mine, g, name))
    0
  RIdleExchange(name, reply) ->
    send(reply, r_idle_x(xs, g, name))
    0
  RTheirs(cid, reply) ->
    r_gone(qs, mine, g, map_keys(g.owner), cid)
    send(reply, 1)
    0
  RDropExchange(name, quiet, if_unused, reply) ->
    send(reply, r_drop_exchange(xs, name, quiet, if_unused))
    0
  RKindOf(name, reply) ->
    send(reply, r_kind_of(xs, name))
    0
  RExchangeIf(name, reply) ->
    send(reply, xs[name])
    0
  RTotals(reply) ->
    send(reply, r_totals(qs, map_keys(qs), 0, 0))
    0
  RRows(reply) ->
    send(reply, r_rows(qs, map_keys(qs), Nil))
    0
  RTable(reply) ->
    send(reply, r_table(qs, map_keys(qs), Nil, g.dir))
    0
  RCopies(reply) ->
    send(reply, map_keys(cs))
    0
  RCopy(name, reply) ->
    send(reply, r_copy(cs, g.dir, name, done))
    0
  RPromote(name, reply) ->
    send(reply, r_promote(qs, cs, mine, ts, g.dir, name, done))
    0
  RVote(name, term, size, from, reply) ->
    send(reply, r_vote(ts, ld, g.dir, name, term, size, from))
    0
  RWho(name, reply) ->
    # Only an elected leader, and -1 for not knowing of one. Answering with the
    # node the hash names would be answering with the node that has just been
    # found not to be answering, and everybody would go on pointing at it
    # instead of one of them standing for it.
    send(reply, if map_has(mine, name) then cl_me() else map_or(ld, name, -1))
    0
  RTerm(name, reply) ->
    send(reply, r_known_term(ts, g.dir, name))
    0
  RTail(name, from, reply) ->
    send(reply, j_tail(g.dir, name, from))
    0
  RCatchUp(name, bytes, reply) ->
    r_catch_up(r_copy(cs, g.dir, name, done), bytes)
    send(reply, str_len(bytes))
    0
  RSize(name, reply) ->
    send(reply, r_journal_size(g.dir, name))
    0

fn r_exchange(xs: Map(Str, Chan(XReq)), jr, name, kind, quiet, durable, inner, done) = match xs[name]
  Some(ch) -> ch
  None -> r_make_exchange(xs, r_only(jr), name, kind, quiet, durable, inner, done)

# `quiet` is what startup uses. Reading the table back in and writing every
# line of it out again would make the file longer every time the broker was
# restarted, for a table that had not changed.
fn r_make_exchange(xs: Map(Str, Chan(XReq)), jr: Jr, name, kind, quiet, durable, inner, done) =
  ch = channel()
  spawn x_run(name, kind, durable, inner, jr, ch, done)
  if quiet || !durable then 0 else r_note_x(jr, name, kind, inner)
  xs[name] = ch
  ch

# The same append a `REPL` makes, waited for rather than answered down a
# connection: this is a node bringing itself up to date before it stands
# again, and standing on records that are not on the disk yet would be
# standing on nothing.
fn r_catch_up(j: Jr, bytes) =
  out = channel(1)
  send(r_puts(j), JPut(bytes, out, OFrame(w_ok())))
  recv(out)
  0

fn r_copy(cs: Map(Str, Jr), dir, name, done) = match cs[name]
  Some(j) -> j
  None ->
    j = Jr(channel(256), channel(1))
    if str_len(dir) == 0 then spawn j_run_memory(j, done) else spawn j_run(dir + "/" + j_file(name), j, done)
    cs[name] = j
    j

# A vote is given when the turn asked for is later than any this node knows of
# and the asker's journal for that queue is at least as long as this node's.
#
# The second half is the one that matters. A majority of the cluster has every
# record anybody was told was safe, so a candidate that a majority will vote
# for has all of them too — and a candidate that has fallen behind is refused
# by everybody who is ahead of it, which is enough of them to matter.
# The turn this node knows of: what it has voted for, or what the queue's own
# journal says, whichever is later. A node restarted after voting has the
# journal to go on, and a node holding the queue has voted for nobody.
fn r_known_term(ts: Map(Str, Int), dir, name) =
  voted = map_or(ts, name, 0)
  written = r_written_term(dir, name)
  if voted > written then voted else written

fn r_written_term(dir, name) =
  if str_len(dir) == 0 then 0 else j_replay(dir + "/" + j_file(name)).term

fn r_vote(ts: Map(Str, Int), ld: Map(Str, Int), dir, name, term, size, from) =
  if term <= r_known_term(ts, dir, name) then 0
  else if size < r_journal_size(dir, name) then 0
  else
    ts[name] = term
    ld[name] = from
    1

fn r_journal_size(dir, name) =
  if str_len(dir) == 0 then 0
  else
    fd = file_open(dir + "/" + j_file(name), "r")
    if fd < 0 then 0 else r_size_of(fd)

fn r_size_of(fd) =
  n = file_size(fd)
  file_close(fd)
  n

fn r_note_x(jr: Jr, name, kind, inner) =
  send(jr.puts, JNote(rt_x_record(name, kind, inner)))
  0

# The one journal the registry carries, in a list because a record cannot hold
# a channel record and be built before it exists.
fn r_only(jr) = match jr
  Nil -> Jr(channel(1), channel(1))
  Cons(j, rest) -> j

# A queue is made here, or stood in for. Which of the two is the name's hash
# over the list of nodes, so this node does not have to ask anybody and cannot
# disagree with anybody: every node runs the same arithmetic on the same list.
# The queue is told to stop and answers with what it was holding; then it is
# out of the table and its journal is off the disk. A name nobody has is -1,
# which is not a count and cannot be mistaken for one.
fn r_kind_of(xs: Map(Str, Chan(XReq)), name) = match xs[name]
  None -> ""
  Some(ch) -> r_ask_kind(ch)

fn r_ask_kind(ch) =
  back = channel(1)
  send(ch, XKind(back))
  recv(back)

# Somebody else's, or nobody's yet. A queue is only ever claimed by the
# connection that declared it exclusive, and the claim is dropped when that
# connection goes or when the queue does.
fn r_claim(g: Reg, name, cid, only, fleeting) =
  if map_has(g.owner, name) && map_or(g.owner, name, 0) != cid then 0
  else
    r_mark(g, name, cid, only, fleeting)
    1

fn r_mark(g: Reg, name, cid, only, fleeting) =
  if only then r_own(g, name, cid) else 0
  if fleeting then r_fleeting(g, name) else 0
  0

fn r_own(g: Reg, name, cid) =
  g.owner[name] = cid
  0

fn r_fleeting(g: Reg, name) =
  g.auto[name] = 1
  0

fn r_mark_x(g: Reg, name, fleeting) =
  if fleeting then r_fleeting_x(g, name) else 0

fn r_fleeting_x(g: Reg, name) =
  g.xauto[name] = 1
  0

fn r_idle_x(xs: Map(Str, Chan(XReq)), g: Reg, name) =
  if !map_has(g.xauto, name) then 0 else r_forgot_x(g, name, r_drop_exchange(xs, name, false, true))

fn r_forgot_x(g: Reg, name, held) =
  if held < 0 then held
  else
    map_del(g.xauto, name)
    held

# Asked after a consumer has gone, and answered by the queue rather than here:
# `if_unused` is the whole of the condition, and a queue with a consumer left
# refuses it.
fn r_idle(qs: Map(Str, Chan(QReq)), mine: Map(Str, Int), g: Reg, name) =
  if !map_has(g.auto, name) then 0 else r_forgot(g, name, r_drop_queue(qs, mine, g.dir, name, true, false))

fn r_forgot(g: Reg, name, held) =
  if held < 0 then held
  else
    map_del(g.auto, name)
    map_del(g.owner, name)
    held

fn r_gone(qs: Map(Str, Chan(QReq)), mine: Map(Str, Int), g: Reg, ks, cid) = match ks
  Nil -> 0
  Cons(k, rest) ->
    r_gone_one(qs, mine, g, k, cid)
    r_gone(qs, mine, g, rest, cid)

fn r_gone_one(qs: Map(Str, Chan(QReq)), mine: Map(Str, Int), g: Reg, name, cid) =
  if map_or(g.owner, name, 0) != cid then 0 else r_forgot(g, name, r_drop_queue(qs, mine, g.dir, name, false, false))

fn r_drop_queue(qs: Map(Str, Chan(QReq)), mine: Map(Str, Int), dir, name, if_unused, if_empty) = match qs[name]
  None -> -1
  Some(ch) ->
    back = channel(1)
    send(ch, QStop(if_unused, if_empty, back))
    r_dropped(qs, mine, dir, name, recv(back))

# A queue that refused the conditions is still there, so nothing is forgotten
# and nothing is unlinked.
fn r_dropped(qs: Map(Str, Chan(QReq)), mine: Map(Str, Int), dir, name, held) =
  if held < 0 then held
  else
    map_del(qs, name)
    map_del(mine, name)
    r_unlink(dir, name)
    held

# The journal goes with the queue. Unlinking a file the journal strand may
# still have open is safe and is the ordinary Unix answer: the name goes now
# and the bytes go when it closes.
fn r_unlink(dir, name) =
  if str_len(dir) == 0 then 0
  else
    file_remove(dir + "/" + j_file(name))
    0

# The same for an exchange, except that what it answers with is how many
# bindings went with it. `quiet` is replay, which must not write the record it
# is reading.
fn r_drop_exchange(xs: Map(Str, Chan(XReq)), name, quiet, if_unused) = match xs[name]
  None -> -1
  Some(ch) ->
    back = channel(1)
    send(ch, XStop(quiet, if_unused, back))
    r_dropped_x(xs, name, recv(back))

# One that refused is still there, so nothing is forgotten.
fn r_dropped_x(xs: Map(Str, Chan(XReq)), name, n) =
  if n < 0 then n
  else
    map_del(xs, name)
    n

# What this node can honestly say about a queue it has not got. It is not the
# same question as `r_queue`, which makes one: a name nobody has ever used is
# a mistake worth telling a client about, and telling it costs nothing here
# where the table already knows.
fn r_known(qs: Map(Str, Chan(QReq)), mine: Map(Str, Int), dir, reg, name, done) = match qs[name]
  Some(ch) -> Some(ch)
  None -> if r_somebody_elses(name) then Some(r_queue(qs, mine, dir, reg, name, done)) else None

fn r_somebody_elses(name) =
  peers = cl_peers()
  len(peers) > 1 && cl_owner(name, len(peers)) != cl_me()

fn r_queue(qs: Map(Str, Chan(QReq)), mine: Map(Str, Int), dir, reg, name, done) = match qs[name]
  Some(ch) -> ch
  None ->
    ch = channel()
    if map_has(mine, name) then spawn q_run(name, dir, ch, done) else r_start(name, dir, reg, ch, done, cl_peers())
    qs[name] = ch
    ch

# Taking a queue over. The copy's journal is already the queue's journal — the
# same file, the same bytes — so starting a queue from it is all there is to
# do. What was a stand-in for somebody else's queue is replaced in the table,
# and every connection picks the new one up on its next command, because a
# connection asks the registry each time rather than remembering.
#
# Nothing here decides that the other node is gone. Something else has to have
# decided that, and it is not a decision this can make on its own.
fn r_promote(qs: Map(Str, Chan(QReq)), cs: Map(Str, Jr), mine: Map(Str, Int), ts: Map(Str, Int), dir, name, done) =
  if map_has(mine, name) then 1
  else
    # The turn this node is taking over for goes into the journal before the
    # queue is started from it, so that everything this leader sends afterwards
    # says which turn it is for — and a node still holding an older one is
    # refused by anybody who has heard of this.
    r_write_term(cs, dir, name, map_or(ts, name, 0), done)
    mine[name] = 1
    map_del(cs, name)
    ch = channel()
    spawn q_run(name, dir, ch, done)
    qs[name] = ch
    1

fn r_write_term(cs: Map(Str, Jr), dir, name, term, done) =
  if term <= 0 then 0
  else
    back = channel(1)
    send(r_puts(r_copy(cs, dir, name, done)), JPut(j_term_record(term), back, OFrame("")))
    recv(back)
    0

fn r_start(name, dir, reg, ch, done, peers) =
  if len(peers) <= 1 then spawn q_run(name, dir, ch, done) else if cl_owner(name, len(peers)) == cl_me() then r_hold(name, dir, ch, done, peers) else r_stand_in(name, reg, ch, done, nth(peers, cl_owner(name, len(peers))))

# Everybody else keeps a copy, and a majority of them has to have a record
# before a publisher is told it is safe. Nobody is singled out as the one
# backup: with three nodes either of the other two will do, so losing one
# takes nothing with it.
fn r_hold(name, dir, ch, done, peers) =
  spawn q_run_copied(name, dir, cl_others(peers, cl_me(), 0, Nil), len(peers) / 2, ch, done)

fn r_stand_in(name, reg, ch, done, where) = match where
  None -> spawn q_run(name, "", ch, done)
  Some(p) -> spawn cl_proxy(name, cl_host(p), cl_port(p), reg, ch, done)

# Asking a queue how it is doing is the one thing the registry does that can
# be slow, and the registry is on the path of every publish: `b_find` goes
# through it. So the ask has a deadline. A queue busy enough not to answer in
# a fifth of a second is reported as busy rather than waited for, and the room
# for one answer means its late reply does not leave it stuck sending.
fn r_ask(ch) =
  back = channel(1)
  send(ch, QStat(back))
  c = select
    v = recv(back) -> Some(v)
    timeout(r_patience()) -> None
  c

fn r_patience() = 200

fn r_totals(qs: Map(Str, Chan(QReq)), ks, ready, inflight) = match ks
  Nil -> Totals(#qs, ready, inflight)
  Cons(k, rest) -> match qs[k]
    None -> r_totals(qs, rest, ready, inflight)
    Some(ch) -> match r_ask(ch)
      None -> r_totals(qs, rest, ready, inflight)
      Some(c) -> r_totals(qs, rest, ready + q_count_ready(c), inflight + q_count_inflight(c))

# One rendered row per queue, in whatever order the table holds them. Rendered
# here because the registry is the only thing that knows both a queue's name
# and its channel.
fn r_rows(qs: Map(Str, Chan(QReq)), ks, acc) = match ks
  Nil -> acc
  Cons(k, rest) -> match qs[k]
    None -> r_rows(qs, rest, acc)
    Some(ch) -> r_rows(qs, rest, Cons(r_row(k, r_ask(ch)), acc))

fn r_table(qs: Map(Str, Chan(QReq)), ks, acc, dir) = match ks
  Nil -> acc
  Cons(k, rest) -> match qs[k]
    None -> r_table(qs, rest, acc, dir)
    Some(ch) -> r_table(qs, rest, Cons(r_one(k, r_ask(ch), r_journal_size(dir, k)), acc), dir)

fn r_one(name, answer, bytes) = match answer
  None -> QRow(name, 0, 0, 0, 0, 0, 0, 0, bytes)
  Some(c) -> QRow(name, q_count_ready(c), q_count_inflight(c), q_count_subs(c), q_count_published(c), q_count_delivered(c), q_count_acked(c), q_count_oldest(c), bytes)

fn r_row(name, answer) = match answer
  None -> w_queue_busy(name)
  Some(c) -> w_queue_row(name, q_count_ready(c), q_count_inflight(c), q_count_subs(c), q_count_published(c))

fn q_count_subs(c: QCount) = c.subs

fn q_count_published(c: QCount) = c.published

fn q_count_delivered(c: QCount) = c.delivered

fn q_count_acked(c: QCount) = c.acked

fn q_count_oldest(c: QCount) = c.oldest

# The queue keeps a moment; what anybody wants is a duration. Zero stays zero,
# because a queue with nothing in it has no oldest message rather than one that
# arrived at the beginning of 1970.
fn b_age(at) = if at <= 0 then 0 else now_millis() - at

fn q_count_ready(c: QCount) = c.ready

fn q_count_inflight(c: QCount) = c.inflight

# -- a connection ---------------------------------------------------------------

# The buffer a subscriber's frames wait in. A consumer that falls this far
# behind is skipped rather than waited for; see `q_pump`.
fn b_backlog() = 128

# How long a connection that has asked for nothing may say nothing.
#
# A client that opens a socket and never speaks holds a strand, a descriptor
# and a buffer for as long as it likes, and opening several thousand of those
# costs the opener nothing. A subscriber is a different matter: saying nothing
# is exactly what it is supposed to do between messages, so the clock only runs
# for a connection with no subscriptions.
fn b_idle_secs() = opt_int("idle", 60)

# How many connections at once. Strands are cheap — this is not about them —
# but descriptors are not, and the number a process may have open is decided
# elsewhere and is lower than people expect. Refusing the thousand-and-first
# with a sentence is better than failing to accept it with none.
fn b_max_conns() = opt_int("conns", 1024)

# The file naming who may connect, or "" for a broker that asks nobody.
fn b_users() = opt("users", "")

# What one node signs in to another as, when there is a file to sign in
# against. A cluster whose brokers ask for a password has to have one to give.
fn b_peer() = opt("peer", "")

# What version this is. It is said in one place on the wire — the server
# properties of an AMQP connection — and read from here rather than written
# there, so that the next version is one line rather than a search.
fn b_version() = "0.2.1"

# What a listener hands to every connection it takes: who may connect, and
# whether the connection is wrapped in TLS. A plain port carries a context
# that is null, and `p_read` and `p_write` then do exactly what they did
# before there was any TLS at all.
type Door
  Door(users: Str, tls: Tls, lines: Chan(Line), bins: Chan(Chan(Out)))

fn b_door() = b_door_with(Tls(null_ptr(), ""))

fn b_door_with(t: Tls) = Door(b_users(), t, p_watcher(), b_binman())

# What the accept loop carries: how many connections are up, what to number
# the next one, and where the ones that end say so.
type Gate
  Gate(live: Int, next: Int, gone: Chan(Int))

# The handshake, if there is one, happens here rather than in the accept loop:
# it is a round trip with a client that may be slow or may never answer, and
# the doorman has other people waiting.
fn b_serve(fd, reg, done, cid, gone, d: Door) =
  sock_nodelay(fd)
  if is_null(d.tls.ctx) then b_serving(fd, reg, done, cid, gone, null_ptr(), d) else b_shaken(fd, reg, done, cid, gone, d, tls_up(d.tls, fd))

fn b_shaken(fd, reg, done, cid, gone, d: Door, ssl) =
  if is_null(ssl) then b_no_handshake(fd, gone) else b_serving(fd, reg, done, cid, gone, ssl, d)

fn b_no_handshake(fd, gone) =
  sock_close(fd)
  send(gone, 1)
  0

fn b_serving(fd, reg, done, cid, gone, ssl, d: Door) =
  # A publisher pipelining a thousand requests is answered a thousand times,
  # and `b_pump` gathers those into one write whenever the writer is busy, so
  # nothing here asks for `sock_buffered`. It used to, and that was a second way
  # to lose a client: flushing a full socket parks whichever strand happened to
  # be parking, and a subscriber on `prefetch=0` stopped hearing anything with
  # thirteen thousand messages out and every buffer empty.
  out = channel(b_backlog())
  say = channel(b_backlog())
  wire = channel(1)
  spawn b_writer(p_line(d.lines, fd, ssl), wire, done, false)
  spawn b_pump(Pump(fd, say, out, wire, strbuf(), map_new(), d.bins), "")
  b_read(Conn(fd, reg, done, cid, out, say, gone, ssl), "", 0, Nil, 0, "")

# Between the connection and its writer, gathering what is owed into one write
# for whenever the writer is free. That is what `sock_buffered` was for, and
# without it or this, delivery runs at two thirds of the rate. Replies arrive on
# `say` and deliveries on `out`, because only one of them may be refused: a
# reply is always taken, so the reader never waits on the client, and deliveries
# stop being taken once the client is behind, for `q_try_send` to leave ready.
# The limits are `am_writer`'s, for the same reasons.
#
# `size` is what is held in slot 0, and in slot 1 how much of that is replies.
# `head` is what has been offered to the writer and not yet taken.
type Pump
  Pump(fd: Int, say: Chan(Out), out: Chan(Out), wire: Chan(Out), owed: StrBuf, size: Map(Int, Int), bins: Chan(Chan(Out)))

type PStep
  PSay(what: Out)
  PDeliver(what: Out)
  PTaken

fn b_behind_at() = 1048576

fn b_lost_at() = 67108864

fn b_owed(p: Pump) = map_or(p.size, 0, 0)

fn b_told(p: Pump) = map_or(p.size, 1, 0)

fn b_pump(p: Pump, head) =
  if b_told(p) >= b_lost_at() then b_pump(b_cut_off(p), "") else if str_len(head) > 0 then b_offer(p, head) else if b_owed(p) > 0 then b_offer(p, b_pump_take(p)) else b_pump_idle(p)

fn b_pump_idle(p: Pump) =
  step = select
    m = recv(p.say) -> PSay(m)
    o = recv(p.out) -> PDeliver(o)
  b_pump_on(p, "", step)

fn b_offer(p: Pump, head) =
  if b_owed(p) >= b_behind_at() then b_offer_behind(p, head) else b_offer_any(p, head)

fn b_offer_any(p: Pump, head) =
  step = select
    send(p.wire, OFrame(head)) -> PTaken
    m = recv(p.say) -> PSay(m)
    o = recv(p.out) -> PDeliver(o)
  b_pump_on(p, head, step)

fn b_offer_behind(p: Pump, head) =
  step = select
    send(p.wire, OFrame(head)) -> PTaken
    m = recv(p.say) -> PSay(m)
  b_pump_on(p, head, step)

fn b_pump_on(p: Pump, head, step) = match step
  PTaken -> b_pump(p, "")
  PSay(m) -> if b_is_end(m) then b_pump_end(p, head) else b_pump(b_told_it(p, m), head)
  PDeliver(m) -> b_pump_out(p, head, m)

# Whatever is waiting on `say` was said before this delivery was made, and a
# `+OK` must not be overtaken by the message it promised.
fn b_pump_out(p: Pump, head, m) =
  first = select
    r = recv(p.say) -> Some(r)
    default -> None
  match first
    None -> b_pump(b_add(p, b_bytes(m)), head)
    Some(r) -> if b_is_end(r) then b_pump_end(p, head) else b_pump_out(b_told_it(p, r), head, m)

fn b_is_end(what) = match what
  OFrame(text) -> str_len(text) == 0
  _ -> false

fn b_add(p: Pump, text) =
  strbuf_add(p.owed, text)
  size = p.size
  size[0] = b_owed(p) + str_len(text)
  p

fn b_told_it(p: Pump, m) =
  text = b_bytes(m)
  size = p.size
  size[1] = b_told(p) + str_len(text)
  b_add(p, text)

fn b_pump_take(p: Pump) =
  text = strbuf_str(p.owed)
  b_cleared(p)
  text

fn b_cleared(p: Pump) =
  strbuf_clear(p.owed)
  size = p.size
  size[0] = 0
  size[1] = 0
  p

# Nothing owed is going to be read. The reader wakes and says it has finished,
# which is what ends this.
fn b_cut_off(p: Pump) =
  sock_shutdown(p.fd)
  b_cleared(p)

# What a connection leaves behind it. The journal answers a publish with a
# `send` that waits, and it may be well behind the connection it is answering:
# once a client has gone and more is owed to it than the channel holds, that
# send never ends, and the journal stops for everyone. The queues stop behind
# it at their next acknowledgement, and the broker goes quiet with nothing
# wrong anywhere. So a channel someone may still answer on is emptied until it
# has been quiet for long enough that nobody is going to. One strand does this
# for every connection, for the reason `p_watch` is one strand.
type Bin
  Bin(ch: Chan(Out), quiet: Int)

fn b_bin_ms() = 50

fn b_bin_rounds() = 1200

fn b_binman() =
  bins = channel()
  spawn b_bins(bins, Nil, 0)
  bins

fn b_bins(bins, held, due) = match held
  Nil -> b_bins(bins, Cons(Bin(recv(bins), 0), Nil), now_millis() + b_bin_ms())
  Cons(first, rest) -> b_bins_wait(bins, held, due)

fn b_bins_wait(bins, held, due) =
  left = due - now_millis()
  if left <= 0 then b_bins(bins, b_empty_all(held, Nil), now_millis() + b_bin_ms())
  else
    fresh = select
      c = recv(bins) -> Some(c)
      timeout(left) -> None
    b_bins(bins, b_with_bin(fresh, held), due)

fn b_with_bin(fresh, held) = match fresh
  Some(c) -> Cons(Bin(c, 0), held)
  None -> held

fn b_empty_all(held, kept) = match held
  Nil -> kept
  Cons(b, rest) -> b_empty_all(rest, b_keep(b_emptied(b.ch, 0), b, kept))

fn b_keep(took, b: Bin, kept) =
  if took > 0 then Cons(Bin(b.ch, 0), kept) else if b.quiet + 1 >= b_bin_rounds() then kept else Cons(Bin(b.ch, b.quiet + 1), kept)

fn b_emptied(ch, took) =
  more = select
    m = recv(ch) -> true
    default -> false
  if more then b_emptied(ch, took + 1) else took

fn b_pump_end(p: Pump, head) =
  b_last_of(p, head)
  b_last_of(p, b_pump_take(p))
  send(p.bins, p.say)
  send(p.bins, p.out)
  send(p.wire, OFrame(""))
  0

# Empty is how the writer is told to finish, so it is not sent by accident.
fn b_last_of(p: Pump, text) =
  if str_len(text) == 0 then 0
  else
    send(p.wire, OFrame(text))
    0

# The writer owns the socket. It watches `done` as well as its own channel, so
# that a broker being shut down can reach a connection that is saying nothing:
# `sock_shutdown` ends the connection without closing the descriptor, which is
# the only thing that wakes the reader parked on it.
fn b_writer(l: Line, out, done, stopping) =
  f = if stopping then Send(recv(out)) else b_next(out, done)
  match f
    Shutdown ->
      sock_shutdown(l.fd)
      b_writer(l, out, done, true)
    Send(what) -> b_put(l, out, done, stopping, b_bytes(what))

fn b_put(l: Line, out, done, stopping, text) =
  if str_len(text) == 0 then p_line_close(l)
  else
    p_line_write(l, text)
    b_writer(l, out, done, stopping)

# This protocol's way of saying a message. The empty string is how the reader
# says it has finished and the socket may go.
fn b_bytes(what) = match what
  OFrame(text) -> text
  ODeliver(queue, id, body, props, sub) -> w_msg(id, queue, body)
  # This protocol has no `mandatory` and so never asks for one of these.
  ONoRoute(exchange, key, body, props, chan) -> ""
  # This protocol has no way of saying it, and a subscriber on it finds out
  # the next time it asks.
  OCancelled(queue, sub) -> ""
  OPublished(queue, id) -> w_ok_id(id)

fn b_next(out, done) =
  f = select
    t = recv(out) -> Send(t)
    recv(done) -> Shutdown
  f

fn b_read(c: Conn, buf, from, subs, idle, who) = match w_take(buf, from)
  Got(cmd, next) -> b_gate(c, buf, next, subs, cmd, who)
  Bad(why, next, fatal) ->
    send(c.say, OFrame(w_err(why)))
    if fatal then b_bye(c, subs) else b_read(c, buf, next, subs, 0, who)
  Need -> b_fill(c, buf, from, subs, idle, who)

# The one door. A broker with a password file answers everything but `AUTH`,
# `PING` and `QUIT` with a refusal until somebody has signed in, and a broker
# without one has already said yes before this is reached.
fn b_gate(c: Conn, buf, next, subs, cmd, who) =
  if !au_wanted(b_users()) || str_len(who) > 0 || b_always(cmd) then b_do(c, buf, next, subs, cmd, who)
  else
    send(c.say, OFrame(w_err("say AUTH first")))
    b_read(c, buf, next, subs, 0, who)

fn b_always(cmd) = match cmd
  CAuth(name, word) -> true
  CPing -> true
  CQuit -> true
  CPub(q, b) -> false
  CSub(q) -> false
  CUnsub(q) -> false
  CAck(q, i) -> false
  CNack(q, i) -> false
  CStats -> false
  CQueues -> false
  CQStat(q) -> false
  CDrain(q) -> false
  CXDecl(x, k, i) -> false
  CBind(x, q, k) -> false
  CXPub(x, k, b) -> false
  CRepl(q, t, n) -> false
  CVote(q, t, n, f) -> false
  CWho(q) -> false
  CTail(q, f) -> false
  CSize(q) -> false
  CPromote(q) -> false

# A second at a time, rather than until something arrives. The wait costs one
# cheap look at the socket when there is something there, and it is what gives
# a connection that has gone quiet somewhere to be counted.
fn b_fill(c: Conn, buf, from, subs, idle, who) =
  # A subscriber has no deadline to keep, so it does not pay for one. This is
  # not only tidiness: a consumer acknowledging one message at a time makes
  # many small reads, and a look at the socket before each of them costs about
  # a tenth of the delivery rate.
  if len(subs) > 0 then b_take(c, buf, from, subs, who) else if !sock_wait(c.fd, 1000) then b_quiet(c, buf, from, subs, idle + 1, who) else b_take(c, buf, from, subs, who)

fn b_take(c: Conn, buf, from, subs, who) =
  # The one place the front is thrown away: once per read from the socket
  # rather than once per command in it.
  kept = if from == 0 then buf else buf[from:]
  more = p_read(c.ssl, c.fd)
  if str_len(more) == 0 then b_bye(c, subs) else b_read(c, kept + more, 0, subs, 0, who)

fn b_quiet(c: Conn, buf, from, subs, idle, who) =
  if len(subs) > 0 || idle < b_idle_secs() then b_read(c, buf, from, subs, idle, who)
  else
    send(c.say, OFrame(w_err("said nothing for " + int_to_str(b_idle_secs()) + " seconds")))
    b_bye(c, subs)

fn b_do(c: Conn, buf, next, subs, cmd, who) = match cmd
  CAuth(name, word) -> b_signed_in(c, buf, next, subs, name, au_ok(b_users(), name, word))
  CQuit ->
    send(c.say, OFrame(w_ok()))
    b_bye(c, subs)
  CPing ->
    send(c.say, OFrame(w_pong()))
    b_read(c, buf, next, subs, 0, who)
  CStats ->
    back = channel()
    send(c.reg, RTotals(back))
    t = recv(back)
    send(c.say, OFrame(w_stats(b_queues(t), b_ready(t), b_inflight(t))))
    b_read(c, buf, next, subs, 0, who)
  CXDecl(ex, kind, inner) ->
    b_exchange_as(c, ex, kind, inner)
    send(c.say, OFrame(w_ok()))
    b_read(c, buf, next, subs, 0, who)
  CBind(ex, qname, key) ->
    back = channel(1)
    send(b_exchange(c, ex, x_direct()), XBind(qname, key, ToQueue(b_find(c.reg, qname)), false, back))
    recv(back)
    send(c.say, OFrame(w_ok()))
    b_read(c, buf, next, subs, 0, who)
  CXPub(ex, key, body) ->
    send(b_exchange(c, ex, x_direct()), XPub(key, body, "", c.say, 0, x_hops()))
    b_read(c, buf, next, subs, 0, who)
  CRepl(qname, term, bytes) -> b_take_copy(c, Where(buf, next, subs, who), qname, term, bytes)
  CPromote(qname) ->
    back = channel(1)
    send(c.reg, RPromote(qname, back))
    recv(back)
    send(c.say, OFrame(w_ok()))
    b_read(c, buf, next, subs, 0, who)
  CVote(qname, term, size, node) ->
    back = channel(1)
    send(c.reg, RVote(qname, term, size, node, back))
    send(c.say, OFrame(if recv(back) == 1 then w_vote_yes() else w_vote_no(b_term(c, qname))))
    b_read(c, buf, next, subs, 0, who)
  CTail(qname, from) ->
    b_say_tail(c, qname, b_tail(c, qname, from))
    b_read(c, buf, next, subs, 0, who)
  CSize(qname) ->
    send(c.say, OFrame(w_size_line(b_size(c, qname))))
    b_read(c, buf, next, subs, 0, who)
  CWho(qname) ->
    back = channel(1)
    send(c.reg, RWho(qname, back))
    send(c.say, OFrame(w_who_line(recv(back))))
    b_read(c, buf, next, subs, 0, who)
  CDrain(qname) ->
    back = channel(1)
    send(b_find(c.reg, qname), QDrain(back))
    send(c.say, OFrame(w_drained(recv(back))))
    b_read(c, buf, next, subs, 0, who)
  CQStat(qname) ->
    st = q_count_of(b_find(c.reg, qname))
    send(c.say, OFrame(w_qstat_line(q_count_ready(st), q_count_inflight(st), q_count_subs(st), q_count_published(st), q_count_delivered(st), q_count_acked(st), b_age(q_count_oldest(st)))))
    b_read(c, buf, next, subs, 0, who)
  CQueues ->
    rows = channel()
    send(c.reg, RRows(rows))
    b_say_rows(c, recv(rows))
    b_read(c, buf, next, subs, 0, who)
  CPub(qname, body) ->
    # Nothing is waited for. The queue is given this connection's writer, and
    # the `+OK` is put there by whoever makes the message durable; this strand
    # goes straight back to reading, which is what lets a pipelining publisher
    # fill a batch.
    send(b_find(c.reg, qname), QPub(body, "", c.say))
    b_read(c, buf, next, subs, 0, who)
  CSub(qname) ->
    # The answer is sent before the subscription is made, so that it is written
    # before any message the subscription brings. They travel down different
    # channels, and `b_pump_out` empties this one before it takes a delivery
    # from the other, which is what makes this enough; asking first and
    # answering after would let a message overtake the `+OK` that promised it.
    send(c.say, OFrame(w_ok()))
    back = channel()
    send(b_find(c.reg, qname), QSub(Sub(c.cid, c.out, false, q_prefetch(), c.cid), back))
    recv(back)
    b_read(c, buf, next, if contains_name(subs, qname) then subs else Cons(qname, subs), 0, who)
  CUnsub(qname) ->
    b_drop(c.reg, c.cid, qname)
    send(c.say, OFrame(w_ok()))
    b_read(c, buf, next, without_name(subs, qname), 0, who)
  CAck(qname, id) ->
    back = channel()
    send(b_find(c.reg, qname), QAck(id, back))
    send(c.say, OFrame(if recv(back) == 1 then w_ok() else w_err("no such message in flight")))
    b_read(c, buf, next, subs, 0, who)
  CNack(qname, id) ->
    back = channel()
    send(b_find(c.reg, qname), QNack(id, back))
    send(c.say, OFrame(if recv(back) == 1 then w_ok() else w_err("no such message in flight")))
    b_read(c, buf, next, subs, 0, who)

fn b_signed_in(c: Conn, buf, next, subs, name, yes) =
  send(c.say, OFrame(if yes then w_ok() else w_err("no")))
  b_read(c, buf, next, subs, 0, if yes then name else "")

# The count first, then the rows, so a client knows how many to read.
fn b_say_rows(c: Conn, rows) =
  send(c.say, OFrame(w_queues_head(len(rows))))
  b_say_each(c, rows)

fn b_say_each(c: Conn, rows) = match rows
  Nil -> 0
  Cons(r, rest) ->
    send(c.say, OFrame(r))
    b_say_each(c, rest)

fn b_queues(t: Totals) = t.queues

fn b_ready(t: Totals) = t.ready

fn b_inflight(t: Totals) = t.inflight

# A batch from a node leading an earlier turn than this one knows of is
# refused. That is how a leader that was replaced while it was away finds out:
# it can no longer reach a majority, so it can no longer confirm anything, so
# nothing it takes can be lost by somebody else carrying on without it.
# Where the reader had got to, in one value, so that this can be a jump: past
# six arguments a tail call spills to the stack and stops being one, and a
# connection taking copies is a loop that runs as long as the node does.
type Where
  Where(buf: Str, next: Int, subs: List(Str), who: Str)

fn b_take_copy(c: Conn, w: Where, qname, term, bytes) =
  if term < b_term(c, qname) then b_refuse_copy(c, w) else b_keep_copy(c, w, qname, bytes)

fn b_keep_copy(c: Conn, w: Where, qname, bytes) =
  back = channel(1)
  send(c.reg, RCopy(qname, back))
  send(r_puts(recv(back)), JPut(bytes, c.say, OFrame(w_ok())))
  b_read(c, w.buf, w.next, w.subs, 0, w.who)

fn b_refuse_copy(c: Conn, w: Where) =
  send(c.say, OFrame(w_stale()))
  b_read(c, w.buf, w.next, w.subs, 0, w.who)

fn b_size(c: Conn, name) =
  back = channel(1)
  send(c.reg, RSize(name, back))
  recv(back)

fn b_tail(c: Conn, name, from) =
  back = channel(1)
  send(c.reg, RTail(name, from, back))
  recv(back)

fn b_say_tail(c: Conn, name, t) =
  send(c.say, OFrame(w_tail_line(str_len(t)) + t))
  0

fn b_term(c: Conn, name) =
  back = channel(1)
  send(c.reg, RTerm(name, back))
  recv(back)

fn r_puts(j: Jr) = j.puts

fn q_count_of(ch) =
  back = channel(1)
  send(ch, QStat(back))
  recv(back)

fn b_exchange(c: Conn, name, kind) = b_exchange_as(c, name, kind, false)

fn b_exchange_as(c: Conn, name, kind, inner) =
  back = channel(1)
  send(c.reg, RExchange(name, kind, false, true, false, inner, back))
  recv(back)

fn b_find(reg, name) =
  back = channel()
  send(reg, RFind(name, back))
  recv(back)

# Leaving is not just closing the socket. Every queue this connection was
# subscribed to has to be told first, so that whatever it was holding goes
# back to somebody who can still take it — and so that no queue is left
# offering messages to a channel nobody is reading.
fn b_bye(c: Conn, subs) =
  # Not while the broker is stopping. The queues and the registry are parked
  # on the same `done` and have already gone, so asking them to forget this
  # subscriber would be asking nobody, and the ask would never come back.
  if closed(c.done) then 0 else b_drop_all(c.reg, c.cid, subs)
  send(c.say, OFrame(""))
  # And the doorman is told, so that the next one may come in. The channel is
  # as large as the limit, so this never waits.
  send(c.gone, 1)
  0

fn b_drop_all(reg, cid, subs) = match subs
  Nil -> 0
  Cons(name, rest) ->
    b_drop(reg, cid, name)
    b_drop_all(reg, cid, rest)

fn b_drop(reg, cid, name) =
  back = channel()
  send(b_find(reg, name), QUnsub(cid, back))
  recv(back)

fn contains_name(names, name) = match names
  Nil -> false
  Cons(n, rest) -> str_cmp(n, name) == 0 || contains_name(rest, name)

fn without_name(names, name) = match names
  Nil -> Nil
  Cons(n, rest) -> if str_cmp(n, name) == 0 then without_name(rest, name) else Cons(n, without_name(rest, name))
