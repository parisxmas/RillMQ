# The registry, and what a connection is.
#
# Two more kinds of strand. One registry, which is the only thing that knows
# what queues exist and hands out their channels; and two per connection — a
# reader that takes commands off the socket and a writer that puts frames on
# it. Two rather than one because a subscriber is being pushed messages at the
# same time as it is sending commands, and one strand cannot be parked on a
# socket read and a channel receive at once.
#
# Only the writer writes. That is what makes the socket safe without a lock:
# it is one strand's, exactly as a queue's messages are one strand's.
import "queue"
import "exchange"
import "cluster"
import "routes"

type RReq
  RFind(name: Str, reply: Chan(Chan(QReq)))
  # An exchange, made the first time it is named, like a queue. The kind is
  # settled by whoever names it first; naming it again with another kind is
  # answered with the one it already is rather than refused, which is friendlier
  # than the specification and no less safe.
  RExchange(name: Str, kind: Str, quiet: Bool, reply: Chan(Chan(XReq)))
  RTotals(reply: Chan(Totals))
  RRows(reply: Chan(List(Str)))
  # The journal of a queue this node does not hold and is keeping a copy of.
  # It is the same file that queue would have here, so promoting the copy is
  # starting a queue from a journal that is already in place.
  RCopy(name: Str, reply: Chan(Jr))

type Totals
  Totals(queues: Int, ready: Int, inflight: Int)

# What the writer strand is told to do next.
type Frame
  Send(what: Out)
  Shutdown

# Everything about a connection that does not change while it is up, in one
# value. It is one record rather than five parameters because the reader is a
# loop, and a loop in Rill is a tail call: past six arguments they spill to the
# stack and the call stops being a jump, so a connection that handled enough
# commands would run out of stack. The compiler says so, by name, at the call
# it cannot promise.
type Conn
  Conn(fd: Int, reg: Chan(RReq), done: Chan(Int), cid: Int, out: Chan(Out), gone: Chan(Int))

# -- the registry ---------------------------------------------------------------

# A queue is made the first time it is named, by a publisher or a subscriber
# alike. There is no declare step, which is the one thing about AMQP that
# nobody has ever been glad of.
# The routing table's own journal, made once. Exchanges and bindings are few
# and change rarely, so they share one file rather than having one each.
fn r_run(dir, inbox, done) =
  jr = Jr(channel(256), channel(1))
  if str_len(dir) == 0 then spawn j_run_memory(jr, done) else spawn j_run(dir + "/" + rt_file(), jr, done)
  r_loop(map_new(), map_new(), map_new(), dir, Cons(jr, Nil), inbox, done)

fn r_loop(qs: Map(Str, Chan(QReq)), xs: Map(Str, Chan(XReq)), cs: Map(Str, Jr), dir, jr, inbox, done) =
  step = select
    r = recv(inbox) -> Some(r_handle(qs, xs, cs, dir, jr, r, done))
    recv(done) -> None
  match step
    None -> 0
    Some(_) -> r_loop(qs, xs, cs, dir, jr, inbox, done)

fn r_handle(qs: Map(Str, Chan(QReq)), xs: Map(Str, Chan(XReq)), cs: Map(Str, Jr), dir, jr, r, done) = match r
  RFind(name, reply) ->
    send(reply, r_queue(qs, dir, name, done))
    0
  RExchange(name, kind, quiet, reply) ->
    send(reply, r_exchange(xs, jr, name, kind, quiet, done))
    0
  RTotals(reply) ->
    send(reply, r_totals(qs, map_keys(qs), 0, 0))
    0
  RRows(reply) ->
    send(reply, r_rows(qs, map_keys(qs), Nil))
    0
  RCopy(name, reply) ->
    send(reply, r_copy(cs, dir, name, done))
    0

fn r_exchange(xs: Map(Str, Chan(XReq)), jr, name, kind, quiet, done) = match xs[name]
  Some(ch) -> ch
  None -> r_make_exchange(xs, r_only(jr), name, kind, quiet, done)

# `quiet` is what startup uses. Reading the table back in and writing every
# line of it out again would make the file longer every time the broker was
# restarted, for a table that had not changed.
fn r_make_exchange(xs: Map(Str, Chan(XReq)), jr: Jr, name, kind, quiet, done) =
  ch = channel()
  spawn x_run(name, kind, jr, ch, done)
  if quiet then 0 else r_note_x(jr, name, kind)
  xs[name] = ch
  ch

fn r_copy(cs: Map(Str, Jr), dir, name, done) = match cs[name]
  Some(j) -> j
  None ->
    j = Jr(channel(256), channel(1))
    if str_len(dir) == 0 then spawn j_run_memory(j, done) else spawn j_run(dir + "/" + j_file(name), j, done)
    cs[name] = j
    j

fn r_note_x(jr: Jr, name, kind) =
  send(jr.puts, JNote(rt_x_record(name, kind)))
  0

# The one journal the registry carries, in a list because a record cannot hold
# a channel record and be built before it exists.
fn r_only(jr) = match jr
  Nil -> Jr(channel(1), channel(1))
  Cons(j, rest) -> j

# A queue is made here, or stood in for. Which of the two is the name's hash
# over the list of nodes, so this node does not have to ask anybody and cannot
# disagree with anybody: every node runs the same arithmetic on the same list.
fn r_queue(qs: Map(Str, Chan(QReq)), dir, name, done) = match qs[name]
  Some(ch) -> ch
  None ->
    ch = channel()
    r_start(name, dir, ch, done, cl_peers())
    qs[name] = ch
    ch

fn r_start(name, dir, ch, done, peers) =
  if len(peers) <= 1 then spawn q_run(name, dir, ch, done) else if cl_owner(name, len(peers)) == cl_me() then r_hold(name, dir, ch, done, peers) else r_stand_in(name, ch, done, nth(peers, cl_owner(name, len(peers))))

# The node after this one keeps the copy. Which one that is has to be worked
# out the same way by everybody and never asked about, exactly as ownership is,
# so it is the next place in the list and wraps round at the end.
fn r_hold(name, dir, ch, done, peers) = match nth(peers, cl_backup(name, len(peers)))
  None -> spawn q_run(name, dir, ch, done)
  Some(p) -> spawn q_run_copied(name, dir, cl_host(p), cl_port(p), ch, done)

fn r_stand_in(name, ch, done, where) = match where
  None -> spawn q_run(name, "", ch, done)
  Some(p) -> spawn cl_proxy(name, cl_host(p), cl_port(p), ch, done)

# Asking a queue how it is doing is the one thing the registry does that can
# be slow, and the registry is on the path of every publish: `b_find` goes
# through it. So the ask has a deadline. A queue busy enough not to answer in
# a fifth of a second is reported as busy rather than waited for, and the room
# for one answer means its late reply does not leave it stuck sending.
fn r_ask(ch) =
  back = channel(1)
  send(ch, QStat(back))
  c = select
    v = recv(back) -> Some(v)
    timeout(r_patience()) -> None
  c

fn r_patience() = 200

fn r_totals(qs: Map(Str, Chan(QReq)), ks, ready, inflight) = match ks
  Nil -> Totals(#qs, ready, inflight)
  Cons(k, rest) -> match qs[k]
    None -> r_totals(qs, rest, ready, inflight)
    Some(ch) -> match r_ask(ch)
      None -> r_totals(qs, rest, ready, inflight)
      Some(c) -> r_totals(qs, rest, ready + q_count_ready(c), inflight + q_count_inflight(c))

# One rendered row per queue, in whatever order the table holds them. Rendered
# here because the registry is the only thing that knows both a queue's name
# and its channel.
fn r_rows(qs: Map(Str, Chan(QReq)), ks, acc) = match ks
  Nil -> acc
  Cons(k, rest) -> match qs[k]
    None -> r_rows(qs, rest, acc)
    Some(ch) -> r_rows(qs, rest, Cons(r_row(k, r_ask(ch)), acc))

fn r_row(name, answer) = match answer
  None -> w_queue_busy(name)
  Some(c) -> w_queue_row(name, q_count_ready(c), q_count_inflight(c), q_count_subs(c), q_count_published(c))

fn q_count_subs(c: QCount) = c.subs

fn q_count_published(c: QCount) = c.published

fn q_count_ready(c: QCount) = c.ready

fn q_count_inflight(c: QCount) = c.inflight

# -- a connection ---------------------------------------------------------------

# The buffer a subscriber's frames wait in. A consumer that falls this far
# behind is skipped rather than waited for; see `q_pump`.
fn b_backlog() = 128

# How long a connection that has asked for nothing may say nothing.
#
# A client that opens a socket and never speaks holds a strand, a descriptor
# and a buffer for as long as it likes, and opening several thousand of those
# costs the opener nothing. A subscriber is a different matter: saying nothing
# is exactly what it is supposed to do between messages, so the clock only runs
# for a connection with no subscriptions.
fn b_idle_secs() = opt_int("idle", 60)

# How many connections at once. Strands are cheap — this is not about them —
# but descriptors are not, and the number a process may have open is decided
# elsewhere and is lower than people expect. Refusing the thousand-and-first
# with a sentence is better than failing to accept it with none.
fn b_max_conns() = opt_int("conns", 1024)

# What the accept loop carries: how many connections are up, what to number
# the next one, and where the ones that end say so.
type Gate
  Gate(live: Int, next: Int, gone: Chan(Int))

fn b_serve(fd, reg, done, cid, gone) =
  sock_nodelay(fd)
  out = channel(b_backlog())
  spawn b_writer(fd, out, done, false)
  b_read(Conn(fd, reg, done, cid, out, gone), "", 0, Nil, 0)

# The writer owns the socket. It watches `done` as well as its own channel, so
# that a broker being shut down can reach a connection that is saying nothing:
# `sock_shutdown` ends the connection without closing the descriptor, which is
# the only thing that wakes the reader parked on it.
fn b_writer(fd, out, done, stopping) =
  f = if stopping then Send(recv(out)) else b_next(out, done)
  match f
    Shutdown ->
      sock_shutdown(fd)
      b_writer(fd, out, done, true)
    Send(what) -> b_put(fd, out, done, stopping, b_bytes(what))

fn b_put(fd, out, done, stopping, text) =
  if str_len(text) == 0 then sock_close(fd)
  else
    sock_write(fd, text)
    b_writer(fd, out, done, stopping)

# This protocol's way of saying a message. The empty string is how the reader
# says it has finished and the socket may go.
fn b_bytes(what) = match what
  OFrame(text) -> text
  ODeliver(queue, id, body) -> w_msg(id, queue, body)
  OPublished(queue, id) -> w_ok_id(id)

fn b_next(out, done) =
  f = select
    t = recv(out) -> Send(t)
    recv(done) -> Shutdown
  f

fn b_read(c: Conn, buf, from, subs, idle) = match w_take(buf, from)
  Got(cmd, next) -> b_do(c, buf, next, subs, cmd)
  Bad(why, next, fatal) ->
    send(c.out, OFrame(w_err(why)))
    if fatal then b_bye(c, subs) else b_read(c, buf, next, subs, 0)
  Need -> b_fill(c, buf, from, subs, idle)

# A second at a time, rather than until something arrives. The wait costs one
# cheap look at the socket when there is something there, and it is what gives
# a connection that has gone quiet somewhere to be counted.
fn b_fill(c: Conn, buf, from, subs, idle) =
  # A subscriber has no deadline to keep, so it does not pay for one. This is
  # not only tidiness: a consumer acknowledging one message at a time makes
  # many small reads, and a look at the socket before each of them costs about
  # a tenth of the delivery rate.
  if len(subs) > 0 then b_take(c, buf, from, subs) else if !sock_wait(c.fd, 1000) then b_quiet(c, buf, from, subs, idle + 1) else b_take(c, buf, from, subs)

fn b_take(c: Conn, buf, from, subs) =
  # The one place the front is thrown away: once per read from the socket
  # rather than once per command in it.
  kept = if from == 0 then buf else buf[from:]
  more = sock_read(c.fd)
  if str_len(more) == 0 then b_bye(c, subs) else b_read(c, kept + more, 0, subs, 0)

fn b_quiet(c: Conn, buf, from, subs, idle) =
  if len(subs) > 0 || idle < b_idle_secs() then b_read(c, buf, from, subs, idle)
  else
    send(c.out, OFrame(w_err("said nothing for " + int_to_str(b_idle_secs()) + " seconds")))
    b_bye(c, subs)

fn b_do(c: Conn, buf, next, subs, cmd) = match cmd
  CQuit ->
    send(c.out, OFrame(w_ok()))
    b_bye(c, subs)
  CPing ->
    send(c.out, OFrame(w_pong()))
    b_read(c, buf, next, subs, 0)
  CStats ->
    back = channel()
    send(c.reg, RTotals(back))
    t = recv(back)
    send(c.out, OFrame(w_stats(b_queues(t), b_ready(t), b_inflight(t))))
    b_read(c, buf, next, subs, 0)
  CXDecl(ex, kind) ->
    b_exchange(c, ex, kind)
    send(c.out, OFrame(w_ok()))
    b_read(c, buf, next, subs, 0)
  CBind(ex, qname, key) ->
    back = channel(1)
    send(b_exchange(c, ex, x_direct()), XBind(qname, key, b_find(c.reg, qname), false, back))
    recv(back)
    send(c.out, OFrame(w_ok()))
    b_read(c, buf, next, subs, 0)
  CXPub(ex, key, body) ->
    send(b_exchange(c, ex, x_direct()), XPub(key, body, c.out))
    b_read(c, buf, next, subs, 0)
  CRepl(qname, bytes) ->
    back = channel(1)
    send(c.reg, RCopy(qname, back))
    send(r_puts(recv(back)), JPut(bytes, c.out, OFrame(w_ok())))
    b_read(c, buf, next, subs, 0)
  CQStat(qname) ->
    st = q_count_of(b_find(c.reg, qname))
    send(c.out, OFrame(w_qstat_line(q_count_ready(st), q_count_inflight(st), q_count_subs(st), q_count_published(st))))
    b_read(c, buf, next, subs, 0)
  CQueues ->
    rows = channel()
    send(c.reg, RRows(rows))
    b_say_rows(c, recv(rows))
    b_read(c, buf, next, subs, 0)
  CPub(qname, body) ->
    # Nothing is waited for. The queue is given this connection's writer, and
    # the `+OK` is put there by whoever makes the message durable; this strand
    # goes straight back to reading, which is what lets a pipelining publisher
    # fill a batch.
    send(b_find(c.reg, qname), QPub(body, c.out))
    b_read(c, buf, next, subs, 0)
  CSub(qname) ->
    # The answer goes into the writer's queue before the subscription is made,
    # so that it is written before any message the subscription brings. Both
    # travel down the one channel and the writer takes them in order, which is
    # what makes this enough; asking first and answering after would let a
    # message overtake the `+OK` that promised it.
    send(c.out, OFrame(w_ok()))
    back = channel()
    send(b_find(c.reg, qname), QSub(Sub(c.cid, c.out), back))
    recv(back)
    b_read(c, buf, next, if contains_name(subs, qname) then subs else Cons(qname, subs), 0)
  CUnsub(qname) ->
    b_drop(c.reg, c.cid, qname)
    send(c.out, OFrame(w_ok()))
    b_read(c, buf, next, without_name(subs, qname), 0)
  CAck(qname, id) ->
    back = channel()
    send(b_find(c.reg, qname), QAck(id, back))
    send(c.out, OFrame(if recv(back) == 1 then w_ok() else w_err("no such message in flight")))
    b_read(c, buf, next, subs, 0)
  CNack(qname, id) ->
    back = channel()
    send(b_find(c.reg, qname), QNack(id, back))
    send(c.out, OFrame(if recv(back) == 1 then w_ok() else w_err("no such message in flight")))
    b_read(c, buf, next, subs, 0)

# The count first, then the rows, so a client knows how many to read.
fn b_say_rows(c: Conn, rows) =
  send(c.out, OFrame(w_queues_head(len(rows))))
  b_say_each(c, rows)

fn b_say_each(c: Conn, rows) = match rows
  Nil -> 0
  Cons(r, rest) ->
    send(c.out, OFrame(r))
    b_say_each(c, rest)

fn b_queues(t: Totals) = t.queues

fn b_ready(t: Totals) = t.ready

fn b_inflight(t: Totals) = t.inflight

fn r_puts(j: Jr) = j.puts

fn q_count_of(ch) =
  back = channel(1)
  send(ch, QStat(back))
  recv(back)

fn b_exchange(c: Conn, name, kind) =
  back = channel(1)
  send(c.reg, RExchange(name, kind, false, back))
  recv(back)

fn b_find(reg, name) =
  back = channel()
  send(reg, RFind(name, back))
  recv(back)

# Leaving is not just closing the socket. Every queue this connection was
# subscribed to has to be told first, so that whatever it was holding goes
# back to somebody who can still take it — and so that no queue is left
# offering messages to a channel nobody is reading.
fn b_bye(c: Conn, subs) =
  # Not while the broker is stopping. The queues and the registry are parked
  # on the same `done` and have already gone, so asking them to forget this
  # subscriber would be asking nobody, and the ask would never come back.
  if closed(c.done) then 0 else b_drop_all(c.reg, c.cid, subs)
  send(c.out, OFrame(""))
  # And the doorman is told, so that the next one may come in. The channel is
  # as large as the limit, so this never waits.
  send(c.gone, 1)
  0

fn b_drop_all(reg, cid, subs) = match subs
  Nil -> 0
  Cons(name, rest) ->
    b_drop(reg, cid, name)
    b_drop_all(reg, cid, rest)

fn b_drop(reg, cid, name) =
  back = channel()
  send(b_find(reg, name), QUnsub(cid, back))
  recv(back)

fn contains_name(names, name) = match names
  Nil -> false
  Cons(n, rest) -> str_cmp(n, name) == 0 || contains_name(rest, name)

fn without_name(names, name) = match names
  Nil -> Nil
  Cons(n, rest) -> if str_cmp(n, name) == 0 then without_name(rest, name) else Cons(n, without_name(rest, name))
