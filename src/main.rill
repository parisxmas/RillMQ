# RillMQ: a message broker that keeps everything in memory.
#
#     rill build src/main.rill -o rillmq
#     ./rillmq 6789                 # keeps nothing
#     ./rillmq 6789 dir=data        # keeps messages in ./data
#
# and, all optional: ack=<ms> prefetch=<n> mem=<MB> idle=<s> conns=<n>
#
# One strand per queue, two per connection, and one registry. Nothing is
# shared and nothing is locked. It stops on SIGINT or SIGTERM by closing one
# channel, which every strand in the program is watching.
import "broker"
import "amqp_serve"
import "auth"
import "manage"

fn default_port() = 6789

fn main() =
  if arg_count() > 1 && str_cmp(arg(1), "passwd") == 0 then set_password() else start()

# `rillmq passwd <file> <name> <word> [tag]` writes somebody into a password
# file, making the file if it is not there. It is the one thing this program
# does that is not a broker, and it is here rather than in a second program
# because the hashing has to be the hashing the broker checks against.
fn set_password() =
  if arg_count() < 5 then said_wrong() else match au_set(arg(2), arg(3), arg(4), if arg_count() > 5 then arg(5) else "")
    Err(e) ->
      println(e)
      1
    Ok(n) ->
      println(arg(3) + " may now connect to a broker started with users=" + arg(2))
      0

fn said_wrong() =
  println("usage: rillmq passwd <file> <name> <word> [tag]")
  1

# A port that cannot be had stops the broker, and says so with a status as
# well as a line. It used to print and exit zero, which is the worst of both:
# a script that starts a broker in the background and looks away has no way to
# know, and the client that connects a moment later is answered by whatever
# was already on that port. That cost an afternoon — the answers came from a
# stale broker with another `dir` and another `peers`, and looked like a
# message queue losing messages.
fn start() =
  port = if arg_count() > 1 then str_to_int(arg(1)) else default_port()
  dir = where_to_keep_it()
  match listen_on(port)
    Err(e) -> stop_with(e)
    Ok(server) -> run_broker(server, dir)

# `dir=` names somewhere to keep messages. Without one the broker keeps
# nothing, which is a thing to want rather than a thing to be warned about.
fn where_to_keep_it() = opt("dir", "")

fn say_who_may(users) =
  if !au_wanted(users) then 0
  else
    println("rillmq asks for a name and a word, from " + users)
    0

fn run_broker(server, dir) =
  done = channel()
  reg = channel()
  spawn r_run(dir, reg, done)
  restored = bring_back(reg, dir)
  routed = bring_back_routes(reg, dir)
  spawn accept_loop(server, reg, done, Gate(0, 1, channel(b_max_conns())), b_door())
  amqp_on(reg, done, opt_int("amqp", 0), b_door())
  wrapped(reg, done, tls_ready(opt("cert", ""), opt("key", "")))
  mg_on(reg, done, mg_port(), b_users())
  say_who_may(b_users())
  println("rillmq on port " + int_to_str(sock_port(server)) + (if str_len(dir) == 0 then ", keeping nothing" else ", keeping messages in " + dir + " (" + int_to_str(restored) + " queue(s) and " + int_to_str(routed) + " binding(s) restored)"))

  # `main` is the strand that waits for the signal, and closing `done` is how
  # it tells every other strand in the program at once. Nothing has to be
  # counted or joined: a queue, a registry and a connection's writer are all
  # parked on a `select` that watches this channel.
  sig = wait_signal()
  println("")
  println("caught " + name_of(sig) + ", stopping")
  close(done)

  # The accept loop is parked inside `tcp_accept` and is not waiting on
  # anything this can reach. Shutting down a *listening* socket wakes the
  # parked accept on Linux and does not on a Mac, so this does not pretend to:
  # the strand is abandoned when `main` returns, which is what Rill does with
  # every strand still running, and the socket goes with the process.
  #
  # The pause is for the connections, which do have somewhere to be: their
  # writers have just been told to shut their sockets down, and this is long
  # enough for that to reach the far end.
  sleep_ms(150)
  println("stopped")
  0

# Every journal in the directory is a queue that existed, so naming each one
# to the registry is the whole of starting up again: the registry makes the
# queue, the queue reads its own journal, and whatever was published and never
# acknowledged is ready again.
fn bring_back(reg, dir) =
  if str_len(dir) == 0 then 0
  else
    dir_make(dir)
    open_each(reg, dir, dir_names(dir), 0)

fn open_each(reg, dir, files, n) = match files
  Nil -> n
  Cons(f, rest) ->
    name = if ends_with_log(f) then j_name_of(dir + "/" + f) else ""
    if str_len(name) == 0 then open_each(reg, dir, rest, n)
    else
      b_find(reg, name)
      open_each(reg, dir, rest, n + 1)

# The routing table, read in the order it was written: an exchange declared, a
# binding made, a binding taken away. Applying them in that order gives the
# table as it stood, and applying them through the registry is the same path a
# client would have taken, so nothing needs a second way in.
fn bring_back_routes(reg, dir) =
  if str_len(dir) == 0 then 0 else apply_routes(reg, rt_replay(dir + "/" + rt_file()).all, 0)

fn apply_routes(reg, rs, n) = match rs
  Nil -> n
  Cons(r, rest) -> apply_routes(reg, rest, n + apply_route(reg, r))

fn apply_route(reg, r) = match r
  RNone -> 0
  # An exchange somebody deleted. Its declaration and its bindings are earlier
  # in this file and have already been applied, so this undoes them — which is
  # what reading a journal in order means.
  RGone(name) ->
    b_drop_exchange(reg, name)
    0
  RX(name, kind) ->
    b_exchange_of(reg, name, kind)
    0
  RB(ex, queue, key) ->
    back = channel(1)
    send(b_exchange_of(reg, ex, x_direct()), XBind(queue, key, b_find(reg, queue), true, back))
    recv(back)
    1
  RU(ex, queue, key) ->
    back = channel(1)
    send(b_exchange_of(reg, ex, x_direct()), XUnbind(queue, key, back))
    recv(back)
    0

fn b_drop_exchange(reg, name) =
  back = channel(1)
  send(reg, RDropExchange(name, true, back))
  recv(back)

fn b_exchange_of(reg, name, kind) =
  back = channel(1)
  send(reg, RExchange(name, kind, true, back))
  recv(back)

fn ends_with_log(f) = str_len(f) > 4 && str_cmp(f[str_len(f) - 4:], ".log") == 0

# The doorman. It counts what is up, hears from each connection as it ends,
# and turns people away rather than opening a descriptor it may not be able to
# open. Counting here rather than in a strand of its own is what keeps it off
# the path a message takes: nothing asks it anything.
fn accept_loop(server, reg, done, g: Gate, d: Door) =
  conn = tcp_accept(server)
  if conn < 0 then 0 else b_admit(server, reg, done, settle(g), conn, d)

fn b_admit(server, reg, done, g: Gate, conn, d: Door) =
  if g.live >= b_max_conns() then
    turn_away(conn)
    accept_loop(server, reg, done, g, d)
  else
    spawn b_serve(conn, reg, done, g.next, g.gone, d)
    accept_loop(server, reg, done, Gate(g.live + 1, g.next + 1, g.gone), d)

# Everyone who has left since the last time anyone looked, without waiting for
# anyone who has not.
fn settle(g: Gate) =
  got = select
    recv(g.gone) -> true
    default -> false
  if !got then g else settle(Gate(g.live - 1, g.next, g.gone))

fn turn_away(conn) =
  sock_write(conn, "-ERR too many connections" + "\r\n")
  sock_close(conn)
  0

# The same queues, reached by the protocol RabbitMQ speaks, on a port of its
# own. `amqp=5672` is the port everything that speaks it expects.
fn amqp_on(reg, done, port, d: Door) =
  if port <= 0 then 0 else match listen_on(port)
    Err(e) -> stop_with("rillmq: " + e)
    Ok(server) ->
      println("rillmq speaking amqp 0-9-1 on port " + int_to_str(sock_port(server)) + (if is_null(d.tls.ctx) then "" else ", wrapped in tls"))
      spawn amqp_accept(server, reg, done, Gate(0, 1, channel(b_max_conns())), d)
      0

fn amqp_accept(server, reg, done, g: Gate, d: Door) =
  conn = tcp_accept(server)
  if conn < 0 then 0 else amqp_admit(server, reg, done, settle(g), conn, d)

fn amqp_admit(server, reg, done, g: Gate, conn, d: Door) =
  if g.live >= b_max_conns() then
    sock_close(conn)
    amqp_accept(server, reg, done, g, d)
  else
    spawn am_serve(conn, reg, done, g.next, g.gone, d)
    amqp_accept(server, reg, done, Gate(g.live + 1, g.next + 1, g.gone), d)

# The same two protocols again, wrapped. `tls=` and `amqps=` are ports; the
# certificate and the key are read once, here, and shared by every connection
# either port takes. A broker asked for neither port reads neither file and
# never calls OpenSSL at all.
#
# A certificate that will not load stops the broker rather than quietly
# leaving the plain ports up: somebody who asked for TLS and got a broker
# without it has been told the opposite of the truth.
fn wrapped(reg, done, t: Tls) =
  tls_port = opt_int("tls", 0)
  amqps = opt_int("amqps", 0)
  if tls_port <= 0 && amqps <= 0 then 0 else tls_listeners(reg, done, t, tls_port, amqps)

fn tls_listeners(reg, done, t: Tls, tls_port, amqps) =
  if !tls_working(t) then stop_with("rillmq: " + t.why) else tls_both(reg, done, Door(b_users(), t), tls_port, amqps)

fn tls_both(reg, done, d: Door, tls_port, amqps) =
  native_tls_on(reg, done, tls_port, d)
  amqp_on(reg, done, amqps, d)

fn stop_with(why) =
  println(why)
  exit(1)
  0

fn native_tls_on(reg, done, port, d: Door) =
  if port <= 0 then 0 else match listen_on(port)
    Err(e) -> stop_with("rillmq: " + e)
    Ok(server) ->
      println("rillmq on port " + int_to_str(sock_port(server)) + ", wrapped in tls (openssl " + tls_version() + ")")
      spawn accept_loop(server, reg, done, Gate(0, 1, channel(b_max_conns())), d)
      0

fn name_of(sig) =
  if sig == sig_hup() then "SIGHUP" else if sig == sig_int() then "SIGINT" else if sig == sig_term() then "SIGTERM" else "signal " + int_to_str(sig)
