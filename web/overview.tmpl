%% import "broker"
%% import "head"
%% import "foot"
%= mg_overview(t: Totals, rows: List(QRow), past: List(Seen), who, note, said)
<% include mg_head("Overview", who) %>
<section class="cards">
<div class="card"><span class="n"><%= tot_queues(t) %></span><span class="l">queues</span></div>
<div class="card"><span class="n"><%= tot_ready(t) %></span><span class="l">ready</span></div>
<div class="card"><span class="n"><%= tot_inflight(t) %></span><span class="l">in flight</span></div>
</section>
<% if str_len(said) > 0 %><p class="empty"><%= said %></p><% end %>
<h2>Queues</h2>
<% if len(rows) == 0 %>
<p class="empty">Nothing yet. A queue appears the first time somebody publishes to it or subscribes to it.</p>
<% else %>
<table>
<tr><th>Name</th><th>Last minute</th><th class="n">In /s</th><th class="n">Out /s</th><th class="n">Ready</th><th class="n">In flight</th><th class="n">Consumers</th><th class="n">Oldest</th><th></th></tr>
<% each r in rows %>
<tr>
<td><code><%= qr_name(r) %></code></td>
<td class="spark"><svg viewBox="0 0 100 20" preserveAspectRatio="none"><path d="<%= mg_spark(past, qr_name(r)) %>"/></svg></td>
<td class="n"><%= mg_rate_in(past, qr_name(r)) %></td>
<td class="n"><%= mg_rate_out(past, qr_name(r)) %></td>
<td class="n"><%= qr_ready(r) %></td>
<td class="n"><%= qr_inflight(r) %></td>
<td class="n"><%= qr_subs(r) %></td>
<td class="n age"><%= mg_ago(qr_oldest(r)) %></td>
<td class="n"><form method="post" action="/drain" style="border:none;padding:0;background:none">
<input type="hidden" name="queue" value="<%= qr_name(r) %>">
<button class="plain" type="submit">Empty it</button></form></td>
</tr>
<% end %>
</table>
<% end %>
<h2>Publish one</h2>
<form method="post" action="/publish">
<label>Queue<input name="queue" placeholder="orders" required></label>
<label>Body<input name="body" placeholder="hello" size="34" required></label>
<button type="submit">Send</button>
</form>
<% include mg_foot(note) %>
