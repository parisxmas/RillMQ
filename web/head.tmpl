%= mg_head(title, who)
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · RillMQ</title>
<style>
:root { --ink:#16181d; --dim:#6b7280; --line:#e5e7eb; --bg:#fbfbfc; --card:#fff; --accent:#1f6feb; --warn:#b45309; }
* { box-sizing: border-box; }
body { margin:0; font:15px/1.55 ui-sans-serif,-apple-system,"Segoe UI",Roboto,sans-serif; color:var(--ink); background:var(--bg); }
header { display:flex; align-items:baseline; gap:1.5rem; padding:.9rem 1.5rem; background:var(--card); border-bottom:1px solid var(--line); }
.brand { font-weight:650; letter-spacing:-.01em; color:var(--ink); text-decoration:none; }
nav a { margin-right:1rem; color:var(--dim); text-decoration:none; }
nav a:hover { color:var(--accent); }
.who { margin-left:auto; color:var(--dim); font-size:.86rem; }
main { max-width:60rem; margin:0 auto; padding:1.5rem; }
h2 { font-size:1rem; font-weight:600; margin:2rem 0 .6rem; }
h2:first-child { margin-top:0; }
.cards { display:flex; gap:.75rem; flex-wrap:wrap; }
.card { flex:1 1 8rem; background:var(--card); border:1px solid var(--line); border-radius:.5rem; padding:.85rem 1rem; }
.card .n { display:block; font-size:1.6rem; font-weight:600; letter-spacing:-.02em; }
.card .l { display:block; color:var(--dim); font-size:.82rem; }
table { width:100%; border-collapse:collapse; background:var(--card); border:1px solid var(--line); border-radius:.5rem; overflow:hidden; }
th, td { padding:.55rem .8rem; text-align:left; border-bottom:1px solid var(--line); }
th { font-size:.78rem; text-transform:uppercase; letter-spacing:.04em; color:var(--dim); font-weight:600; }
tr:last-child td { border-bottom:none; }
td.n, th.n { text-align:right; font-variant-numeric:tabular-nums; }
.empty { color:var(--dim); padding:1rem .8rem; background:var(--card); border:1px solid var(--line); border-radius:.5rem; }
form { background:var(--card); border:1px solid var(--line); border-radius:.5rem; padding:.9rem 1rem; display:flex; gap:.5rem; flex-wrap:wrap; align-items:end; }
label { display:flex; flex-direction:column; gap:.25rem; font-size:.8rem; color:var(--dim); }
input, select { font:inherit; padding:.4rem .55rem; border:1px solid var(--line); border-radius:.35rem; background:#fff; color:var(--ink); }
button { font:inherit; padding:.45rem .9rem; border:1px solid var(--accent); background:var(--accent); color:#fff; border-radius:.35rem; cursor:pointer; }
button.plain { background:#fff; color:var(--warn); border-color:var(--line); }
footer { max-width:60rem; margin:0 auto; padding:0 1.5rem 2rem; color:var(--dim); font-size:.84rem; }
code { font:13px ui-monospace,SFMono-Regular,Menlo,monospace; background:#f2f3f5; padding:.1rem .3rem; border-radius:.25rem; }
td.spark { width:7rem; padding:.3rem .8rem; }
td.spark svg { display:block; width:6.5rem; height:1.5rem; }
td.spark path { fill:none; stroke:var(--accent); stroke-width:1.5; vector-effect:non-scaling-stroke; }
td.age { color:var(--dim); font-variant-numeric:tabular-nums; }
.hint { color:var(--dim); font-size:.82rem; margin:.4rem 0 0; }
</style>
</head>
<body>
<header>
<a class="brand" href="/">RillMQ</a>
<nav><a href="/">Overview</a><a href="/people">People</a><a href="/api/queues">JSON</a></nav>
<span class="who"><%= who %></span>
</header>
<main>
